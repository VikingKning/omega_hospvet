{
  "name": "omega-vet-adminsite",
  "version": "0.1.0",
  "private": true,
  "description": "Panel administrativo de Omega Veterinaria & Estética — servidor web y base de datos",
  "main": "src/server.js",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "seed": "knex seed:run",
    "dev:localhost": "dotenv -e .env.localhost -o --no-expand -- node --watch src/server.js",
    "migrate:localhost": "dotenv -e .env.localhost -o --no-expand -- knex migrate:latest",
    "seed:localhost": "dotenv -e .env.localhost -o --no-expand -- knex seed:run",
    "migrate:test": "dotenv -e .env.test -o --no-expand -- knex migrate:latest",
    "seed:test": "dotenv -e .env.test -o --no-expand -- knex seed:run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.10.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
