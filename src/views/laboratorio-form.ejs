<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%# La ruta anidada requiere una base explícita para los assets y enlaces relativos. %>
<base href="/">
<title><%= registro ? (soloLectura ? 'Consultar registro' : 'Editar registro') : 'Nuevo registro' %> de laboratorio | Omega Hospital Veterinario</title>
<link rel="icon" type="image/png" href="assets/imgs/icon.png">
<link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="css/main.css">
</head>
<body>

  <%
  const ESTADO_LABEL = { pendiente: 'Pendiente', cargado: 'Cargado', enviado: 'Enviado' };
  const esEdicion = Boolean(registro);
  const titulo = esEdicion
    ? (modoCargarArchivos ? 'Cargar resultados' : (soloLectura ? 'Consultar registro' : 'Editar registro'))
    : 'Nuevo registro';
  const disabledAttr = soloLectura ? 'disabled' : '';
  const tutorPacienteDisabledAttr = (soloLectura || esEdicion) ? 'disabled' : '';
  const puedeCargarArchivos = Boolean(modoCargarArchivos);
  %>

  <div class="app" id="app">
    <div class="top-row">
      <div class="sidebar-header">
        <img src="assets/imgs/icon.png" alt="Omega Hospital Veterinario">
        <span class="sidebar-title">Omega Vet</span>
        <button id="sidebarToggle" class="sidebar-toggle-btn" type="button" aria-label="Mostrar u ocultar menú">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>

      <header class="topbar">
        <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v5.5L4.5 17a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L15 8.5V3"/><path d="M9 3h6M8 14h8"/></svg>
        <h1 class="topbar-title"><span class="topbar-breadcrumb-prefix">Laboratorio &rsaquo; Catálogo &rsaquo; </span><%= titulo %></h1>
        <a class="topbar-user" href="mi-perfil.html">
          <span class="topbar-user-avatar avatar-color-<%= user.avatar %>">
            <img src="assets/imgs/<%= user.avatar %>.png" alt="">
          </span>
          <span class="topbar-user-name"><%= user.nombre %> <%= user.apellidos %></span>
        </a>
      </header>
    </div>

    <div class="body-row">
    <div class="nav-backdrop" id="navBackdrop"></div>
    <%- include('partials/sidebar', { user, currentPage: 'laboratorio' }) %>

    <main class="main-content">
      <div class="lab-form-page">
        <div class="lab-form-heading">
          <span class="lab-form-heading-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v5.5L4.5 17a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L15 8.5V3"/><path d="M9 3h6M8 14h8"/></svg>
          </span>
          <div class="lab-form-heading-text">
            <div class="lab-form-heading-title-row">
              <h2><%= titulo %> de laboratorio</h2>
              <% if (esEdicion) { %>
                <span class="badge badge-<%= registro.estado %>" id="labEstadoBadge"><%= ESTADO_LABEL[registro.estado] %></span>
              <% } %>
            </div>
            <p>Captura la solicitud y agrega uno o varios estudios para el paciente.</p>
          </div>
          <a class="btn-secondary" href="laboratorio.html">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Volver
          </a>
        </div>


        <div class="lab-form-scroll">
        <span class="form-error-banner" id="labFormError" style="display:none">
          <span id="labFormErrorText"></span>
          <button type="button" class="modal-close-btn" id="labFormErrorDismiss" aria-label="Cerrar mensaje">&times;</button>
        </span>
        <span class="form-success-banner" id="labFormSuccess" style="display:none"></span>

        <section class="profile-card">
          <div class="lab-tutor-card-header">
            <h3 class="tutor-form-card-title">Datos del tutor y paciente</h3>
            <% if (!soloLectura && !esEdicion) { %>
              <button type="button" class="btn-secondary" id="labLimpiarTutorBtn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
                Borrar tutor y paciente
              </button>
            <% } %>
          </div>

          <h4 class="lab-form-subtitle">Tutor</h4>
          <div class="modal-form lab-form-grid lab-form-grid-3">
            <label>
              Teléfono *
              <input type="text" id="labTelefono" placeholder="Ej. 5512345678" inputmode="numeric" autocomplete="off" pattern="(\d{2}-\d{4}-\d{4}|\d{3}-\d{3}-\d{4})" maxlength="12" title="Formato de teléfono en México: 10 dígitos (NN-NNNN-NNNN si inicia con 55/56, NNN-NNN-NNNN en otro caso)" <%= tutorPacienteDisabledAttr %>>
              <span class="error-msg" id="labTelefonoError">Escribe un teléfono para buscar al tutor.</span>
            </label>
            <label>
              Tutor
              <div class="combobox" id="labTutorNombreCombobox">
                <input type="text" id="labTutorNombre" autocomplete="off" placeholder="Busqueda por nombre o por telefono" <%= tutorPacienteDisabledAttr %>>
                <ul class="combobox-list" id="labTutorNombreList" hidden></ul>
              </div>
            </label>
            <label>
              Correo electrónico
              <input type="text" id="labTutorCorreo" readonly disabled placeholder="—">
            </label>
          </div>

          <h4 class="lab-form-subtitle">Paciente</h4>
          <div class="modal-form lab-form-grid lab-form-grid-paciente">
            <label>
              Paciente *
              <div class="combobox" id="labPacienteCombobox">
                <input type="text" id="labPacienteTrigger" class="select-trigger-input" readonly autocomplete="off" placeholder="Primero busca al tutor por teléfono" disabled>
                <ul class="combobox-list" id="labPacienteList" hidden></ul>
              </div>
              <input type="hidden" id="labPacienteId">
            </label>
            <div class="lab-paciente-ficha" id="labPacienteFicha" hidden>
              <span class="lab-paciente-ficha-item">
                <span class="lab-paciente-ficha-icon" id="labPacienteEspecieIcon"></span>
                <span id="labPacienteEspecieLabel">—</span>
              </span>
              <span class="lab-paciente-ficha-item">
                <span class="lab-paciente-ficha-icon" id="labPacienteSexoIcon"></span>
                <span id="labPacienteSexoLabel">—</span>
              </span>
              <span class="lab-paciente-ficha-item">
                <span class="tutor-resumen-label">Edad</span>
                <span id="labPacienteEdad">—</span>
              </span>
              <span class="lab-paciente-ficha-item">
                <span class="tutor-resumen-label">Raza</span>
                <span id="labPacienteRaza">—</span>
              </span>
            </div>
          </div>

          <h4 class="lab-form-subtitle">Doctor y fecha</h4>
          <div class="modal-form lab-form-grid lab-form-grid-3">
            <label>
              Dr. solicitante *
              <div class="combobox" id="labDoctorCombobox">
                <input type="text" id="labDoctorInput" autocomplete="off" required placeholder="Buscar doctor..." <%= disabledAttr %>>
                <ul class="combobox-list" id="labDoctorList" hidden></ul>
              </div>
              <input type="hidden" id="labDoctorId">
            </label>
            <label>
              Cédula profesional
              <input type="text" id="labDoctorCedula" readonly disabled placeholder="—">
            </label>
            <label>
              Fecha de solicitud *
              <input type="date" id="labFecha" required <%= tutorPacienteDisabledAttr %>>
            </label>
          </div>
        </section>

        <section class="profile-card">

          <div class="lab-estudios-layout">
            <% if (!soloLectura) { %>
              <div class="lab-estudios-picker-zone">
                <h3 class="tutor-form-card-title">Agregar estudios</h3>
                <div class="lab-estudios-picker modal-form">
                <h4 class="lab-form-subtitle">Seleccionar estudio</h4>
                <label>
                  Categoría
                  <div class="combobox" id="labCategoriaCombobox">

                    <input type="text" id="labCategoriaTrigger" autocomplete="off" placeholder="Todas las categorías">
                    <ul class="combobox-list" id="labCategoriaList" hidden></ul>
                  </div>
                  <input type="hidden" id="labCategoriaId">
                </label>
                <label>Buscar estudio
                  <div class="combobox" id="labEstudioCombobox">
                    <input type="text" id="labEstudioSearch" placeholder="Ej. biometría, FeLV, radiografía, cortisol..." autocomplete="off">
                    <input type="hidden" id="labEstudioId">
                    <ul class="combobox-list" id="labEstudioList" hidden></ul>
                  </div>
                </label>

                <div id="labCamposAdicionales">
                  <label id="labZonaWrap" hidden>Zona anatómica
                    <div class="combobox" id="labZonaCombobox">
                      <input type="text" id="labZonaTrigger" autocomplete="off" placeholder="Buscar zona anatómica...">
                      <ul class="combobox-list" id="labZonaList" hidden></ul>
                    </div>
                    <input type="hidden" id="labZonaId">
                  </label>

                  <div id="labTipoMuestraWrap" hidden>
                    <label>Tipo de muestra
                      <input type="text" id="labTipoMuestra" placeholder="Ej. Orina, sangre, tejido hepático, hisopo de piel...">
                    </label>
                  </div>

                  <label class="switch-field" id="labAntibiogramaWrap" hidden>
                    <span class="switch">
                      <input type="checkbox" id="labAntibiograma">
                      <span class="switch-track"></span>
                    </span>
                    <span class="switch-state-on">Con antibiograma</span>
                    <span class="switch-state-off">Sin antibiograma</span>
                  </label>

                  <div id="labTejidoWrap" hidden>
                    <label>Tejido de origen
                      <input type="text" id="labTejidoOrigen" placeholder="Ej. Nódulo cutáneo, ganglio poplíteo...">
                    </label>
                    <label>Lateralidad
                      <div class="combobox" id="labLateralidadCombobox">
                        <input type="text" id="labLateralidadTrigger" class="select-trigger-input" readonly autocomplete="off" value="No aplica">
                        <ul class="combobox-list" id="labLateralidadList" hidden>
                          <li class="combobox-item" data-id="">No aplica</li>
                          <li class="combobox-item" data-id="izquierdo">Izquierdo</li>
                          <li class="combobox-item" data-id="derecho">Derecho</li>
                          <li class="combobox-item" data-id="bilateral">Bilateral</li>
                        </ul>
                      </div>
                      <input type="hidden" id="labLateralidadId">
                    </label>
                  </div>

                  <div id="labComponentesWrap" hidden>
                    <span class="modal-col-title" style="font-size: 13px;">Componentes a analizar</span>
                    <div class="checkbox-grid" id="labComponentesGrid">
                      <% catalogo.componentesLiquido.forEach((componente) => { %>
                        <label class="checkbox-field">
                          <input type="checkbox" name="componentesLiquido" value="<%= componente.valor %>">
                          <%= componente.etiqueta %>
                        </label>
                      <% }) %>
                    </div>
                  </div>
                </div>

                <label>Observaciones del estudio <span class="lab-opcional">(opcional)</span>
                  <textarea id="labEstudioObservaciones" rows="2" placeholder="Ej. Proyección lateral derecha, ayuno de 8 horas, lesión en miembro posterior..."></textarea>
                </label>

                <div class="lab-picker-actions">
                  <button type="button" class="btn-primary" id="btnAddStudy">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    <span id="btnAddStudyLabel">Agregar estudio</span>
                  </button>
                </div>
                </div>
              </div>
            <% } %>

            <div class="lab-estudios-solicitados">
              <div class="lab-tutor-card-header">
                <h3 class="tutor-form-card-title">Estudios solicitados</h3>
                <% if (puedeCargarArchivos) { %>

                  <button type="button" class="btn-secondary" id="labQuitarTodosIndividualesBtn" disabled>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
                    Quitar todos los archivos
                  </button>
                <% } %>
              </div>


              <% if (puedeCargarArchivos) { %>
                <div class="lab-archivo-todos-card">
                  <h4 class="lab-form-subtitle">Archivo para todos los estudios</h4>
                  <p class="lab-archivo-todos-hint">Si el laboratorio mandó un solo archivo con los resultados de todos los estudios de esta orden, súbelo aquí. Si prefieres subir un archivo distinto por cada estudio, hazlo desde su propia tarjeta más abajo.</p>
                  <div id="labArchivoTodosWrap"></div>
                </div>
              <% } %>

              <div class="lab-cart-wrap" id="labCartWrap">
                <p class="lab-cart-empty" id="labCartEmpty">Aún no has agregado ningún estudio.</p>
                <div class="lab-study-list" id="labCartBody" hidden></div>
              </div>
            </div>
          </div>
        </section>

        <section class="profile-card">
          <h3 class="tutor-form-card-title">Observaciones generales</h3>
          <div class="modal-form">
            <label>
              <textarea id="labObservacionesGenerales" rows="3" placeholder="Indicaciones adicionales para el laboratorio, antecedentes relevantes, notas clínicas, etc." <%= disabledAttr %>></textarea>
            </label>
          </div>
        </section>
        </div>

        <div class="tutor-form-actions">
          <a class="btn-secondary" href="laboratorio.html">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            Cancelar
          </a>
          <% if (!soloLectura) { %>
            <button type="button" class="btn-primary" id="labGuardarBtn">Guardar registro</button>
          <% } %>
          <% if (puedeCargarArchivos) { %>

            <button type="button" class="btn-primary" id="labEnviarResultadosBtn" disabled>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
              Enviar resultados
            </button>
          <% } %>
          <button type="button" class="btn-secondary" id="labImprimirBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Imprimir
          </button>
        </div>

        <div class="lab-print-only" id="labPrintDocument">
          <header class="lab-print-header">
            <div class="lab-print-brand">
              <img src="assets/imgs/icon.png" alt="">
              <div>
                <strong>Omega Hospital Veterinario</strong>
                <span>Orden de laboratorio</span>
              </div>
            </div>
            <div class="lab-print-meta">
              <span>Folio: <strong id="labPrintFolio">—</strong></span>
              <span>Fecha de impresión: <strong id="labPrintFechaImpresion">—</strong></span>
            </div>
          </header>

          <section class="lab-print-section">
            <h3>Datos del tutor y paciente</h3>
            <div class="lab-print-grid">
              <div><span>Tutor</span><strong id="labPrintTutor">—</strong></div>
              <div><span>Teléfono</span><strong id="labPrintTelefono">—</strong></div>
              <div><span>Correo electrónico</span><strong id="labPrintCorreo">—</strong></div>
              <div><span>Paciente</span><strong id="labPrintPaciente">—</strong></div>
              <div><span>Especie</span><strong id="labPrintEspecie">—</strong></div>
              <div><span>Sexo</span><strong id="labPrintSexo">—</strong></div>
              <div><span>Edad</span><strong id="labPrintEdad">—</strong></div>
              <div><span>Raza</span><strong id="labPrintRaza">—</strong></div>
            </div>
          </section>

          <section class="lab-print-section">
            <h3>Doctor y fecha</h3>
            <div class="lab-print-grid lab-print-grid-3">
              <div><span>Dr. solicitante</span><strong id="labPrintDoctor">—</strong></div>
              <div><span>Cédula profesional</span><strong id="labPrintDoctorCedula">—</strong></div>
              <div><span>Fecha de solicitud</span><strong id="labPrintFecha">—</strong></div>
            </div>
          </section>

          <section class="lab-print-section">
            <h3>Estudios solicitados</h3>
            <div class="lab-print-estudios" id="labPrintEstudios"></div>
          </section>

          <section class="lab-print-section" id="labPrintObservacionesSection">
            <h3>Observaciones generales</h3>
            <p id="labPrintObservaciones"></p>
          </section>

          <footer class="lab-print-firma">
            <div class="lab-print-firma-line">Firma del médico solicitante</div>
          </footer>
        </div>
      </div>
    </main>
    </div>
  </div>

  <% if (puedeCargarArchivos) { %>

    <div class="modal-backdrop" id="labEnviarModalBackdrop">
      <div class="modal-card">
        <div class="modal-header">
          <h2 id="labEnviarModalTitulo">Resultados enviados</h2>
          <button class="modal-close-btn" type="button" id="labEnviarModalClose" aria-label="Cerrar">&times;</button>
        </div>

        <p id="labEnviarModalMensaje"></p>
        <div class="lab-envio-resultado-lista" id="labEnviarModalCanales"></div>
        <div class="modal-actions">
          <button type="button" class="btn-secondary" id="labEnviarModalCancelar" hidden>Cancelar</button>
          <button type="button" class="btn-primary" id="labEnviarModalConfirmar" hidden>Confirmar envío</button>
          <button type="button" class="btn-primary" id="labEnviarModalCerrar">Cerrar</button>
        </div>
      </div>
    </div>


    <div class="toast" id="labArchivoToast" role="status" aria-live="polite"></div>


    <%- include('partials/global-loader') %>
  <% } %>


  <div id="labFormData" hidden><%- JSON.stringify({
    catalogo,
    doctores,
    doctorIdPreseleccionado,
    soloLectura,
    puedeCargarArchivos,
    csrfToken,
    registro: registro ? {
      id: registro.id,
      mascotaId: registro.mascota_id,
      doctorId: registro.doctor_id,
      fechaSolicitud: registro.fecha_solicitud,
      observaciones: registro.observaciones,
      propietarioId: registro.propietario_id,
      propietarioNombre: registro.propietario_nombre,
      propietarioApellidos: registro.propietario_apellidos,
      propietarioTelefono: registro.propietario_telefono,
      propietarioCorreo: registro.propietario_correo,
      pacientesDelTutor: registro.pacientesDelTutor,
      estudios: registro.estudios,
    } : null,
  }).replace(/</g, String.fromCharCode(92, 117, 48, 48, 51, 99)) %></div>

  <script src="js/sidebar.js" nonce="<%= cspNonce %>"></script>
  <script src="js/telefono.js" nonce="<%= cspNonce %>"></script>
  <script src="js/combobox.js" nonce="<%= cspNonce %>"></script>
  <% if (puedeCargarArchivos) { %>
    <script src="js/globalLoader.js" nonce="<%= cspNonce %>"></script>
  <% } %>
  <script nonce="<%= cspNonce %>">
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text ?? '';
      return div.innerHTML;
    }

    const datosEl = document.getElementById('labFormData');
    const DATOS = JSON.parse(datosEl.textContent);
    const csrfToken = DATOS.csrfToken;
    const CATALOGO = DATOS.catalogo;
    const DOCTORES = DATOS.doctores;
    const SOLO_LECTURA = DATOS.soloLectura;
    const PUEDE_CARGAR_ARCHIVOS = DATOS.puedeCargarArchivos;
    const ACCEPT_ARCHIVOS =
      'image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,video/mp4,video/quicktime,video/webm';
    const ES_EDICION = Boolean(DATOS.registro);

    const DOG_SVG =
      '<svg width="32" height="32" fill="currentColor" viewBox="0 0 640 640"><path d="M64 176C80.6 176 94.2 188.6 95.8 204.7L96.1 211.3C97.8 227.4 111.4 240 128 240L307.1 240L448 300.4L448 544C448 561.7 433.7 576 416 576L384 576C366.3 576 352 561.7 352 544L352 412.7C328 425 300.8 432 272 432C243.2 432 216 425 192 412.7L192 544C192 561.7 177.7 576 160 576L128 576C110.3 576 96 561.7 96 544L96 298.4C58.7 285.2 32 249.8 32 208C32 190.3 46.3 176 64 176zM387.8 32C395.5 32 402.7 35.6 407.4 41.8L424 64L476.1 64C488.8 64 501 69.1 510 78.1L528 96L584 96C597.3 96 608 106.7 608 120L608 144C608 188.2 572.2 224 528 224L464 224L457 252L332.3 198.6L363.9 51.4C366.3 40.1 376.2 32 387.8 32zM480 108C469 108 460 117 460 128C460 139 469 148 480 148C491 148 500 139 500 128C500 117 491 108 480 108z"/></svg>';
    const CAT_SVG =
      '<svg width="32" height="32" fill="currentColor" viewBox="0 0 640 640"><path d="M96 160C149 160 192 203 192 256L192 341.8C221.7 297.1 269.8 265.6 325.4 257.8C351 317.8 410.6 359.9 480 359.9C490.9 359.9 501.6 358.8 512 356.8L512 544C512 561.7 497.7 576 480 576C462.3 576 448 561.7 448 544L448 403.2L312 512L368 512C385.7 512 400 526.3 400 544C400 561.7 385.7 576 368 576L224 576C171 576 128 533 128 480L128 256C128 239.4 115.4 225.8 99.3 224.2L92.7 223.9C76.6 222.2 64 208.6 64 192C64 174.3 78.3 160 96 160zM565.8 67.2C576.2 58.5 592 65.9 592 79.5L592 192C592 253.9 541.9 304 480 304C418.1 304 368 253.9 368 192L368 79.5C368 65.9 383.8 58.5 394.2 67.2L448 112L512 112L565.8 67.2zM432 172C421 172 412 181 412 192C412 203 421 212 432 212C443 212 452 203 452 192C452 181 443 172 432 172zM528 172C517 172 508 181 508 192C508 203 517 212 528 212C539 212 548 203 548 192C548 181 539 172 528 172z"/></svg>';
    const MALE_SVG =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="14" r="6"/><path d="M14.5 9.5 20 4"/><path d="M15 4h5v5"/></svg>';
    const FEMALE_SVG =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M12 15v7"/><path d="M9 19h6"/></svg>';

    function normalizeText(str) {
      return str.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    }

    function positionComboboxList(trigger, list) {
      const rect = trigger.getBoundingClientRect();
      list.style.position = 'fixed';
      list.style.top = `${rect.bottom + 4}px`;
      list.style.left = `${rect.left}px`;
      list.style.width = `${rect.width}px`;
      list.style.right = 'auto';
      list.style.zIndex = '1000';
    }

    document.addEventListener('click', (event) => {
      document.querySelectorAll('.combobox-list').forEach((list) => {
        if (list.hidden) return;
        const combobox = list.closest('.combobox');
        if (combobox && combobox.contains(event.target)) return;
        list.hidden = true;
      });
    });

    function showError(message) {
      const banner = document.getElementById('labFormError');
      document.getElementById('labFormSuccess').style.display = 'none';
      document.getElementById('labFormErrorText').textContent = message;
      banner.style.display = 'flex';
      banner.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    function hideBanners() {
      document.getElementById('labFormError').style.display = 'none';
      document.getElementById('labFormSuccess').style.display = 'none';
    }

    document.getElementById('labFormErrorDismiss').addEventListener('click', () => {
      document.getElementById('labFormError').style.display = 'none';
    });

    let refrescarTutorNombreClear = () => {};
    let refrescarPacienteClear = () => {};
    let refrescarDoctorClear = () => {};
    let refrescarCategoriaClear = () => {};
    let refrescarEstudioClear = () => {};
    let refrescarZonaClear = () => {};

    let tutorActual = null; // { id, nombre, apellidos, telefono, correo, pacientes }

    function renderTutor() {
      document.getElementById('labTutorNombre').value = tutorActual ? `${tutorActual.nombre} ${tutorActual.apellidos}` : '';
      document.getElementById('labTutorCorreo').value = tutorActual ? (tutorActual.correo || '—') : '';
      refrescarTutorNombreClear();
    }

    function renderPacienteOptions() {
      const trigger = document.getElementById('labPacienteTrigger');
      const list = document.getElementById('labPacienteList');
      const pacientes = tutorActual ? tutorActual.pacientes : [];
      trigger.disabled = SOLO_LECTURA || ES_EDICION || pacientes.length === 0;
      trigger.placeholder = pacientes.length ? 'Selecciona un paciente...' : 'Este tutor no tiene pacientes activos';
      list.innerHTML = pacientes
        .map((p) => `<li class="combobox-item" data-id="${p.id}">${escapeHtml(p.nombre)}</li>`)
        .join('');
      refrescarPacienteClear();
    }

    function limpiarPaciente() {
      const teniaPaciente = Boolean(document.getElementById('labPacienteId').value);
      document.getElementById('labPacienteId').value = '';
      document.getElementById('labPacienteTrigger').value = '';
      document.getElementById('labPacienteFicha').hidden = true;
      pacienteEspecieActual = null;
      if (teniaPaciente) limpiarEstudiosPorCambioPaciente();
      refrescarPacienteClear();
    }

    function seleccionarPaciente(id) {
      const paciente = (tutorActual?.pacientes ?? []).find((p) => String(p.id) === String(id));
      if (!paciente) return;
      const pacienteAnteriorId = document.getElementById('labPacienteId').value;
      if (pacienteAnteriorId && String(pacienteAnteriorId) !== String(paciente.id)) {
        limpiarEstudiosPorCambioPaciente();
      }
      document.getElementById('labPacienteId').value = paciente.id;
      document.getElementById('labPacienteTrigger').value = paciente.nombre;
      if (paciente.tipo !== pacienteEspecieActual) {
        pacienteEspecieActual = paciente.tipo || null;
        if (!SOLO_LECTURA) {
          categoriaFiltro = '';
          document.getElementById('labCategoriaTrigger').value = '';
          document.getElementById('labCategoriaId').value = '';
          refrescarCategoriaClear();
          clearEstudioSelection();
        }
      }

      const especieIcon = document.getElementById('labPacienteEspecieIcon');
      especieIcon.innerHTML = paciente.tipo === 'Gato' ? CAT_SVG : DOG_SVG;
      document.getElementById('labPacienteEspecieLabel').textContent = paciente.tipo || '—';

      const sexoIcon = document.getElementById('labPacienteSexoIcon');
      sexoIcon.innerHTML = paciente.sexo === 'Hembra' ? FEMALE_SVG : MALE_SVG;
      sexoIcon.style.visibility = paciente.sexo ? 'visible' : 'hidden';
      document.getElementById('labPacienteSexoLabel').textContent = paciente.sexo || '—';

      document.getElementById('labPacienteEdad').textContent = paciente.edad != null ? `${paciente.edad} años` : '—';
      document.getElementById('labPacienteRaza').textContent = paciente.raza || '—';
      document.getElementById('labPacienteFicha').hidden = false;
      refrescarPacienteClear();
    }

    async function buscarTutorPorTelefono(telefono) {
      const res = await fetch('laboratorio/buscar-tutor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ telefono }),
      });
      if (res.redirected) {
        window.location.href = res.url;
        return;
      }
      if (!res.ok) return;
      const data = await res.json();
      const errorMsg = document.getElementById('labTelefonoError');
      if (data.existe) {
        tutorActual = data.tutor;
        errorMsg.classList.remove('show');
      } else {
        tutorActual = null;
        errorMsg.textContent = 'No se encontró ningún tutor activo con ese teléfono.';
        errorMsg.classList.add('show');
      }
      renderTutor();
      renderPacienteOptions();
      limpiarPaciente();
      document.getElementById('labTutorNombreList').hidden = true;
    }

    function limpiarTutorYPaciente() {
      tutorActual = null;
      document.getElementById('labTelefono').value = '';
      document.getElementById('labTelefonoError').classList.remove('show');
      document.getElementById('labTutorNombreList').hidden = true;
      renderTutor();
      renderPacienteOptions();
      limpiarPaciente();
    }

    const labLimpiarTutorBtn = document.getElementById('labLimpiarTutorBtn');
    if (labLimpiarTutorBtn) {
      labLimpiarTutorBtn.addEventListener('click', limpiarTutorYPaciente);
    }

    const labTelefonoInput = document.getElementById('labTelefono');
    if (labTelefonoInput && !SOLO_LECTURA && !ES_EDICION) {
      let telefonoTimer = null;
      labTelefonoInput.addEventListener('input', () => {
        const digitos = labTelefonoInput.value.replace(/\D/g, '').slice(0, 10);
        labTelefonoInput.value = formatearTelefono(digitos);
        document.getElementById('labTelefonoError').classList.remove('show');

        clearTimeout(telefonoTimer);
        if (digitos.length === 10) {
          telefonoTimer = setTimeout(() => buscarTutorPorTelefono(digitos), 300);
        } else {
          tutorActual = null;
          renderTutor();
          renderPacienteOptions();
          limpiarPaciente();
        }
      });
    }

    const labTutorNombreInput = document.getElementById('labTutorNombre');
    const labTutorNombreList = document.getElementById('labTutorNombreList');

    if (labTutorNombreInput && !SOLO_LECTURA && !ES_EDICION) {
      async function buscarTutoresPorNombre(q) {
        const res = await fetch('laboratorio/buscar-tutor-nombre', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ q }),
        });
        if (res.redirected) {
          window.location.href = res.url;
          return;
        }
        if (!res.ok) return;
        const data = await res.json();
        const list = document.getElementById('labTutorNombreList');
        positionComboboxList(labTutorNombreInput, list);
        list.innerHTML = data.tutores?.length
          ? data.tutores
              .map(
                (t) =>
                  `<li class="combobox-item" data-telefono="${escapeHtml(t.telefono)}">${escapeHtml(t.nombre)} ${escapeHtml(t.apellidos)}<br><span class="lab-cart-observaciones">${escapeHtml(t.telefono)}</span></li>`,
              )
              .join('')
          : '<li class="combobox-empty">Sin resultados</li>';
        list.hidden = false;
      }

      let tutorNombreTimer = null;
      labTutorNombreInput.addEventListener('input', () => {
        const q = labTutorNombreInput.value.trim();
        clearTimeout(tutorNombreTimer);
        if (q.length < 2) {
          labTutorNombreList.hidden = true;
          return;
        }
        tutorNombreTimer = setTimeout(() => buscarTutoresPorNombre(q), 300);
      });

      labTutorNombreList.addEventListener('click', (event) => {
        const item = event.target.closest('.combobox-item[data-telefono]');
        if (!item) return;
        event.preventDefault(); // Evita que el label reenvíe el clic al input.
        labTutorNombreList.hidden = true;
        document.getElementById('labTelefono').value = item.dataset.telefono;
        document.getElementById('labTelefonoError').classList.remove('show');
        buscarTutorPorTelefono(item.dataset.telefono.replace(/\D/g, ''));
      });

      attachComboboxKeyboardNav(labTutorNombreInput, labTutorNombreList);
      refrescarTutorNombreClear = attachComboboxClearButton(
        document.getElementById('labTutorNombreCombobox'),
        labTutorNombreInput,
        () => {
          labTutorNombreInput.value = '';
          labTutorNombreList.hidden = true;
        },
      );
    }

    document.getElementById('labPacienteList').addEventListener('click', (event) => {
      const item = event.target.closest('.combobox-item');
      if (!item) return;
      event.preventDefault();
      seleccionarPaciente(item.dataset.id);
      document.getElementById('labPacienteList').hidden = true;
    });

    document.getElementById('labPacienteTrigger').addEventListener('focus', (event) => {
      if (event.target.disabled) return;
      const list = document.getElementById('labPacienteList');
      positionComboboxList(event.target, list);
      list.hidden = false;
    });

    attachComboboxKeyboardNav(document.getElementById('labPacienteTrigger'), document.getElementById('labPacienteList'));
    refrescarPacienteClear = attachComboboxClearButton(
      document.getElementById('labPacienteCombobox'),
      document.getElementById('labPacienteTrigger'),
      limpiarPaciente,
    );

    function renderDoctorList(term) {
      const list = document.getElementById('labDoctorList');
      const t = term.trim().toLowerCase();
      const filtrados = DOCTORES.filter(
        (d) => d.activo !== false && `${d.nombre} ${d.apellidos}`.toLowerCase().includes(t),
      );
      list.innerHTML = filtrados.length
        ? filtrados
            .map((d) => `<li class="combobox-item" data-id="${d.id}" data-label="${escapeHtml(`${d.nombre} ${d.apellidos}`)}">${escapeHtml(`${d.nombre} ${d.apellidos}`)}</li>`)
            .join('')
        : '<li class="combobox-empty">Sin resultados</li>';
      list.hidden = false;
    }

    const labDoctorInput = document.getElementById('labDoctorInput');
    function actualizarCedulaDoctor(doctor) {
      document.getElementById('labDoctorCedula').value = doctor?.cedula_profesional ?? '';
    }

    if (!SOLO_LECTURA) {
      labDoctorInput.addEventListener('input', () => {
        document.getElementById('labDoctorId').value = '';
        actualizarCedulaDoctor(null);
        renderDoctorList(labDoctorInput.value);
      });
      labDoctorInput.addEventListener('focus', () => renderDoctorList(labDoctorInput.value));
      document.getElementById('labDoctorList').addEventListener('click', (event) => {
        const item = event.target.closest('.combobox-item[data-id]');
        if (!item) return;
        event.preventDefault(); // Evita que el label reenvíe el clic al input.
        document.getElementById('labDoctorId').value = item.dataset.id;
        labDoctorInput.value = item.dataset.label;
        actualizarCedulaDoctor(
          DOCTORES.find((doctor) => String(doctor.id) === String(item.dataset.id)),
        );
        document.getElementById('labDoctorList').hidden = true;
        refrescarDoctorClear();
      });

      attachComboboxKeyboardNav(labDoctorInput, document.getElementById('labDoctorList'));
      refrescarDoctorClear = attachComboboxClearButton(
        document.getElementById('labDoctorCombobox'),
        labDoctorInput,
        () => {
          document.getElementById('labDoctorId').value = '';
          labDoctorInput.value = '';
          actualizarCedulaDoctor(null);
          document.getElementById('labDoctorList').hidden = true;
        },
      );
    }

    function preseleccionarDoctor(doctorId) {
      const doctor = DOCTORES.find((d) => String(d.id) === String(doctorId));
      if (!doctor) return;
      document.getElementById('labDoctorId').value = doctor.id;
      labDoctorInput.value = `${doctor.nombre} ${doctor.apellidos}`;
      actualizarCedulaDoctor(doctor);
      refrescarDoctorClear();
    }

    let categoriaFiltro = '';

    function categoriasDisponibles() {
      if (!pacienteEspecieActual) return [];
      return CATALOGO.categorias.filter((c) =>
        c.estudios.some((e) => !e.especie || e.especie === pacienteEspecieActual),
      );
    }

    function renderCategoriaList(filterText) {
      const trigger = document.getElementById('labCategoriaTrigger');
      const list = document.getElementById('labCategoriaList');
      const entries = [{ id: '', nombre: 'Todas las categorías' }, ...categoriasDisponibles()];
      const filtered = filterText
        ? entries.filter((c) => normalizeText(c.nombre).includes(normalizeText(filterText)))
        : entries;

      positionComboboxList(trigger, list);
      list.innerHTML = filtered.length
        ? filtered.map((c) => `<li class="combobox-item" data-id="${c.id}">${escapeHtml(c.nombre)}</li>`).join('')
        : '<li class="combobox-empty">Sin resultados</li>';
      list.hidden = false;
    }

    if (!SOLO_LECTURA) {
      const labCategoriaTrigger = document.getElementById('labCategoriaTrigger');
      labCategoriaTrigger.addEventListener('focus', () => renderCategoriaList(''));
      labCategoriaTrigger.addEventListener('input', () => {
        categoriaFiltro = '';
        document.getElementById('labCategoriaId').value = '';
        clearEstudioSelection();
        renderCategoriaList(labCategoriaTrigger.value);
      });
      document.getElementById('labCategoriaList').addEventListener('click', (event) => {
        const item = event.target.closest('.combobox-item');
        if (!item) return;
        event.preventDefault(); // Evita que el label reenvíe el clic al input.
        categoriaFiltro = item.dataset.id;
        labCategoriaTrigger.value = categoriaFiltro ? item.textContent : '';
        document.getElementById('labCategoriaId').value = categoriaFiltro;
        document.getElementById('labCategoriaList').hidden = true;
        refrescarCategoriaClear();
        clearEstudioSelection();
      });

      attachComboboxKeyboardNav(labCategoriaTrigger, document.getElementById('labCategoriaList'));
      refrescarCategoriaClear = attachComboboxClearButton(
        document.getElementById('labCategoriaCombobox'),
        labCategoriaTrigger,
        () => {
          categoriaFiltro = '';
          labCategoriaTrigger.value = '';
          document.getElementById('labCategoriaId').value = '';
          document.getElementById('labCategoriaList').hidden = true;
          clearEstudioSelection();
        },
      );
    }

    let pacienteEspecieActual = null;

    function findEstudiosFiltrados() {
      if (!pacienteEspecieActual) return [];
      return CATALOGO.categorias
        .filter((c) => !categoriaFiltro || String(c.id) === String(categoriaFiltro))
        .flatMap((c) => c.estudios.map((e) => ({ ...e, categoriaId: c.id, categoriaNombre: c.nombre })))
        .filter((e) => e.activo !== false)
        .filter((e) => !pacienteEspecieActual || !e.especie || e.especie === pacienteEspecieActual);
    }

    function findEstudioPorId(id) {
      for (const categoria of CATALOGO.categorias) {
        const estudio = categoria.estudios.find((e) => String(e.id) === String(id));
        if (estudio) return { ...estudio, categoriaId: categoria.id, categoriaNombre: categoria.nombre };
      }
      return null;
    }

    function renderEstudioList(filterText) {
      const search = document.getElementById('labEstudioSearch');
      const list = document.getElementById('labEstudioList');
      const entries = findEstudiosFiltrados();
      const filtered = filterText
        ? entries.filter((e) => normalizeText(e.nombre).includes(normalizeText(filterText)))
        : entries;

      positionComboboxList(search, list);

      if (filtered.length === 0) {
        list.innerHTML = pacienteEspecieActual
          ? '<li class="combobox-empty">Sin resultados</li>'
          : '<li class="combobox-empty">Selecciona primero un paciente</li>';
        list.hidden = false;
        return;
      }

      const showGroups = !categoriaFiltro;
      let html = '';
      let lastGroup = null;
      filtered.forEach((entry) => {
        if (showGroups && entry.categoriaNombre !== lastGroup) {
          html += `<li class="combobox-group">${escapeHtml(entry.categoriaNombre)}</li>`;
          lastGroup = entry.categoriaNombre;
        }
        html += `<li class="combobox-item" data-id="${entry.id}" role="option">${escapeHtml(entry.nombre)}</li>`;
      });
      list.innerHTML = html;
      list.hidden = false;
    }

    function hideEstudioList() {
      const list = document.getElementById('labEstudioList');
      if (list) list.hidden = true;
    }

    function updateCamposAdicionales() {
      const estudioId = document.getElementById('labEstudioId').value;
      const estudio = findEstudioPorId(estudioId);
      const campo = estudio ? estudio.campoAdicional : null;

      document.getElementById('labZonaWrap').hidden = campo !== 'zona';
      document.getElementById('labTipoMuestraWrap').hidden = campo !== 'tipo_muestra';
      document.getElementById('labAntibiogramaWrap').hidden = !estudio?.permiteAntibiograma;
      document.getElementById('labTejidoWrap').hidden = campo !== 'tejido_lateralidad';
      document.getElementById('labComponentesWrap').hidden = campo !== 'componentes_liquido';

      if (campo !== 'zona') {
        document.getElementById('labZonaId').value = '';
        document.getElementById('labZonaTrigger').value = '';
        refrescarZonaClear();
      }
      if (campo !== 'tipo_muestra') document.getElementById('labTipoMuestra').value = '';
      if (!estudio?.permiteAntibiograma) {
        document.getElementById('labAntibiograma').checked = false;
      }
      if (campo !== 'tejido_lateralidad') {
        document.getElementById('labTejidoOrigen').value = '';
        document.getElementById('labLateralidadId').value = '';
        document.getElementById('labLateralidadTrigger').value = 'No aplica';
      }
      if (campo !== 'componentes_liquido') {
        document.querySelectorAll('#labComponentesGrid input[type=checkbox]').forEach((cb) => { cb.checked = false; });
      }
    }

    function selectEstudio(id) {
      const estudio = findEstudioPorId(id);
      if (!estudio) return;
      document.getElementById('labEstudioId').value = estudio.id;
      document.getElementById('labEstudioSearch').value = estudio.nombre;
      updateCamposAdicionales();
      refrescarEstudioClear();
    }

    function clearEstudioSelection() {
      document.getElementById('labEstudioId').value = '';
      document.getElementById('labEstudioSearch').value = '';
      document.getElementById('labEstudioObservaciones').value = '';
      updateCamposAdicionales();
      hideEstudioList();
      refrescarEstudioClear();
    }

    if (!SOLO_LECTURA) {
      const labEstudioSearch = document.getElementById('labEstudioSearch');
      labEstudioSearch.addEventListener('input', () => {
        document.getElementById('labEstudioId').value = '';
        updateCamposAdicionales();
        renderEstudioList(labEstudioSearch.value);
      });
      labEstudioSearch.addEventListener('focus', () => renderEstudioList(labEstudioSearch.value));

      attachComboboxKeyboardNav(labEstudioSearch, document.getElementById('labEstudioList'));

      document.getElementById('labEstudioList').addEventListener('click', (event) => {
        const item = event.target.closest('.combobox-item');
        if (!item || !item.dataset.id) return;
        event.preventDefault();
        selectEstudio(item.dataset.id);
        hideEstudioList();
      });

      refrescarEstudioClear = attachComboboxClearButton(
        document.getElementById('labEstudioCombobox'),
        labEstudioSearch,
        clearEstudioSelection,
      );

      const labZonaTrigger = document.getElementById('labZonaTrigger');
      function renderZonaList(filterText) {
        const list = document.getElementById('labZonaList');
        const estudio = findEstudioPorId(document.getElementById('labEstudioId').value);
        const zonasPermitidas = new Set((estudio?.zonasPermitidasIds ?? []).map(String));
        const entries = CATALOGO.zonasAnatomicas.filter((zona) => zonasPermitidas.has(String(zona.id)));
        const filtered = filterText
          ? entries.filter((z) => normalizeText(z.nombre).includes(normalizeText(filterText)))
          : entries;

        positionComboboxList(labZonaTrigger, list);
        list.innerHTML = filtered.length
          ? filtered.map((z) => `<li class="combobox-item" data-id="${z.id}">${escapeHtml(z.nombre)}</li>`).join('')
          : '<li class="combobox-empty">Sin resultados</li>';
        list.hidden = false;
      }
      labZonaTrigger.addEventListener('focus', () => renderZonaList(''));
      labZonaTrigger.addEventListener('input', () => {
        document.getElementById('labZonaId').value = '';
        refrescarZonaClear();
        renderZonaList(labZonaTrigger.value);
      });
      document.getElementById('labZonaList').addEventListener('click', (event) => {
        const item = event.target.closest('.combobox-item');
        if (!item) return;
        event.preventDefault(); // Evita que el label reenvíe el clic al input.
        document.getElementById('labZonaId').value = item.dataset.id;
        document.getElementById('labZonaTrigger').value = item.textContent;
        document.getElementById('labZonaList').hidden = true;
        refrescarZonaClear();
      });

      attachComboboxKeyboardNav(labZonaTrigger, document.getElementById('labZonaList'));
      refrescarZonaClear = attachComboboxClearButton(
        document.getElementById('labZonaCombobox'),
        labZonaTrigger,
        () => {
          document.getElementById('labZonaId').value = '';
          labZonaTrigger.value = '';
          document.getElementById('labZonaList').hidden = true;
        },
      );

      document.getElementById('labLateralidadTrigger').addEventListener('focus', (event) => {
        const list = document.getElementById('labLateralidadList');
        positionComboboxList(event.target, list);
        list.hidden = false;
      });
      document.getElementById('labLateralidadList').addEventListener('click', (event) => {
        const item = event.target.closest('.combobox-item');
        if (!item) return;
        event.preventDefault(); // Evita que el label reenvíe el clic al input.
        document.getElementById('labLateralidadId').value = item.dataset.id;
        document.getElementById('labLateralidadTrigger').value = item.textContent;
        document.getElementById('labLateralidadList').hidden = true;
      });

      attachComboboxKeyboardNav(
        document.getElementById('labLateralidadTrigger'),
        document.getElementById('labLateralidadList'),
      );
    }

    let selectedStudies = [];
    let editIndex = null;

    function limpiarEstudiosPorCambioPaciente() {
      if (SOLO_LECTURA || selectedStudies.length === 0) return;
      selectedStudies = [];
      editIndex = null;
      renderCart();
      clearEstudioSelection();
      actualizarModoBotonAgregar();
    }

    function etiquetaLateralidad(valor) {
      return { izquierdo: 'Izquierdo', derecho: 'Derecho', bilateral: 'Bilateral' }[valor] || '';
    }

    function detalleDeFila(fila) {
      if (fila.zonaAnatomicaId) {
        const zona = CATALOGO.zonasAnatomicas.find((z) => z.id === fila.zonaAnatomicaId);
        return `Zona anatómica: ${zona ? zona.nombre : ''}`;
      }
      if (fila.tipoMuestra) {
        return `Muestra: ${fila.tipoMuestra}${fila.antibiograma ? ' · Con antibiograma' : ''}`;
      }
      if (fila.antibiograma) return 'Con antibiograma';
      if (fila.tejidoOrigen) {
        const lateralidad = etiquetaLateralidad(fila.lateralidad);
        return `Origen: ${fila.tejidoOrigen}${lateralidad ? ` · ${lateralidad}` : ''}`;
      }
      if (fila.componentesLiquido && fila.componentesLiquido.length) {
        return `Componentes: ${fila.componentesLiquido.join(', ')}`;
      }
      return '';
    }

    function renderCart() {
      const empty = document.getElementById('labCartEmpty');
      const list = document.getElementById('labCartBody');
      empty.hidden = selectedStudies.length !== 0;
      list.hidden = selectedStudies.length === 0;
      list.innerHTML = selectedStudies
        .map((s, i) => {
          const estudio = findEstudioPorId(s.estudioId);
          const nombre = estudio ? estudio.nombre : 'Estudio';
          const meta = [estudio ? estudio.categoriaNombre : '', detalleDeFila(s)].filter(Boolean).join(' · ');
          return `
            <div class="lab-study-card${PUEDE_CARGAR_ARCHIVOS ? ' lab-study-card--archivos' : ''}">
              <div class="lab-study-card-info">
                <div class="lab-study-title">${escapeHtml(nombre)}</div>
                ${meta ? `<div class="lab-study-meta">${escapeHtml(meta)}</div>` : ''}
                ${s.observaciones ? `<div class="lab-study-meta"><strong>Nota:</strong> ${escapeHtml(s.observaciones)}</div>` : ''}
              </div>
              ${SOLO_LECTURA ? renderArchivoEstudioSlot(s) : `
                <div class="row-actions lab-study-actions">
                  <button type="button" class="row-action-btn row-action-edit" data-action="editar" data-idx="${i}" data-tooltip="Editar" aria-label="Editar estudio">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                  </button>
                  <button type="button" class="row-action-btn row-action-delete" data-action="eliminar" data-idx="${i}" data-tooltip="Eliminar" aria-label="Eliminar estudio">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
                  </button>
                </div>`}
            </div>
          `;
        })
        .join('');
    }

    function renderArchivoUploader({ inputId, estudioId } = {}) {
      const estudioAttr = estudioId != null ? ` data-estudio-id="${estudioId}"` : '';
      const inputIdAttr = inputId ? ` id="${inputId}"` : '';
      return `
        <div class="lab-archivo-uploader"${estudioAttr}>
          <label class="row-action-btn lab-archivo-picker-btn" data-tooltip="Elegir archivo(s)">
            <input type="file"${inputIdAttr} multiple accept="${ACCEPT_ARCHIVOS}" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05 12.25 20.24a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
          </label>
          <span class="lab-archivo-picker-estado">Sin archivos seleccionados</span>
        </div>
      `;
    }

    function renderBotonQuitarArchivo(atributos) {
      return `
        <button type="button" class="lab-archivo-quitar"${atributos} data-tooltip="Quitar archivo" aria-label="Quitar archivo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      `;
    }

    function actualizarEstadoSeleccionArchivo(input) {
      const span = input.closest('.lab-archivo-uploader')?.querySelector('.lab-archivo-picker-estado');
      if (!span) return;
      const n = input.files.length;
      span.textContent =
        n === 0 ? 'Sin archivos seleccionados' : n === 1 ? '1 archivo seleccionado' : `${n} archivos seleccionados`;
    }

    const labArchivoToast = document.getElementById('labArchivoToast');
    const TOAST_VARIANTES = ['toast--warning', 'toast--success', 'toast--danger'];

    function aplicarVarianteToast(variante) {
      if (!labArchivoToast) return;
      labArchivoToast.classList.remove(...TOAST_VARIANTES);
      labArchivoToast.classList.add(`toast--${variante}`);
    }

    function mostrarToast(texto, variante) {
      if (!labArchivoToast) return;
      labArchivoToast.textContent = texto;
      aplicarVarianteToast(variante);
      labArchivoToast.classList.remove('show');
      void labArchivoToast.offsetWidth;
      labArchivoToast.classList.add('show');
    }

    function actualizarToast(texto, variante) {
      if (!labArchivoToast) return;
      labArchivoToast.textContent = texto;
      aplicarVarianteToast(variante);
    }

    function ocultarToast() {
      labArchivoToast?.classList.remove('show');
    }

    function marcarSubiendoArchivo(input) {
      input.disabled = true;
      mostrarToast('Guardando Archivo', 'warning');
      mostrarLoaderGlobal('Guardando archivos');
      const span = input.closest('.lab-archivo-uploader')?.querySelector('.lab-archivo-picker-estado');
      if (span) span.textContent = 'Subiendo…';
    }

    function bloquearCaminoOpuesto(esTodos) {
      const selector = esTodos
        ? '#labCartBody .lab-archivo-uploader input, #labCartBody .lab-archivo-chip button'
        : '#labArchivoTodosWrap input, #labArchivoTodosWrap button';
      document.querySelectorAll(selector).forEach((el) => {
        el.disabled = true;
      });
    }

    function archivoCompartidoActual() {
      if (!selectedStudies.length) return null;
      const [primero] = selectedStudies;
      if (!primero.archivoId) return null;
      const todosIguales = selectedStudies.every((s) => s.archivoId === primero.archivoId);
      return todosIguales ? primero : null;
    }

    function renderArchivoEstudioSlot(fila) {
      if (!PUEDE_CARGAR_ARCHIVOS) return '';
      if (archivoCompartidoActual()) return '';
      if (fila.archivoNombre) {
        return `
          <div class="lab-archivo-chip">
            <button type="button" class="btn-secondary lab-archivo-reemplazar" data-estudio-id="${fila.id}">Reemplazar</button>
            <div class="lab-archivo-chip-nombre">
              <a href="laboratorio/archivos/${fila.archivoId}" target="_blank" rel="noopener">${escapeHtml(fila.archivoNombre)}</a>
              ${renderBotonQuitarArchivo(` data-estudio-id="${fila.id}"`)}
            </div>
          </div>
        `;
      }
      return renderArchivoUploader({ estudioId: fila.id });
    }

    function renderArchivoTodos() {
      const wrap = document.getElementById('labArchivoTodosWrap');
      if (!wrap) return;
      const compartido = archivoCompartidoActual();
      wrap.innerHTML = compartido
        ? `
          <div class="lab-archivo-chip">
            <a href="laboratorio/archivos/${compartido.archivoId}" target="_blank" rel="noopener">${escapeHtml(compartido.archivoNombre)}</a>
            ${renderBotonQuitarArchivo(' id="labArchivoTodosQuitar"')}
            <button type="button" class="btn-secondary" id="labArchivoTodosReemplazar">Reemplazar</button>
          </div>
        `
        : renderArchivoUploader({ inputId: 'labArchivoTodosInput' });
    }

    function actualizarEstadosBotonesArchivo() {
      const compartido = archivoCompartidoActual();
      const modoIndividual = selectedStudies.some((s) => s.archivoId) && !compartido;
      const todosConArchivo = selectedStudies.length > 0 && selectedStudies.every((s) => s.archivoId);

      const enviarBtn = document.getElementById('labEnviarResultadosBtn');
      if (enviarBtn) enviarBtn.disabled = !todosConArchivo;

      const quitarTodosIndividualesBtn = document.getElementById('labQuitarTodosIndividualesBtn');
      if (quitarTodosIndividualesBtn) quitarTodosIndividualesBtn.disabled = !modoIndividual;

      const todosWrap = document.getElementById('labArchivoTodosWrap');
      if (todosWrap) {
        todosWrap.querySelectorAll('input, button').forEach((el) => {
          el.disabled = modoIndividual;
        });
      }

      document
        .querySelectorAll('#labCartBody .lab-archivo-uploader, #labCartBody .lab-archivo-chip')
        .forEach((slot) => {
          slot.querySelectorAll('input, button').forEach((el) => {
            el.disabled = Boolean(compartido);
          });
        });
    }

    async function subirArchivosDeLaboratorio(url, fileList) {
      hideBanners();
      const formData = new FormData();
      Array.from(fileList).forEach((file) => formData.append('archivos', file));
      let res;
      try {
        res = await fetch(url, {
          method: 'POST',
          headers: { 'x-csrf-token': csrfToken },
          body: formData,
        });
      } catch (err) {
        ocultarLoaderGlobal();
        actualizarToast('Error al subir archivo', 'danger');
        setTimeout(ocultarToast, 2000);
        showError('No se pudo conectar con el servidor.');
        return false;
      }
      ocultarLoaderGlobal();
      if (res.redirected) {
        ocultarToast();
        window.location.href = res.url;
        return true;
      }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        actualizarToast('Error al subir archivo', 'danger');
        setTimeout(ocultarToast, 2000);
        showError(data.error || 'No se pudo subir el archivo.');
        return false;
      }
      actualizarToast(
        data.reutilizado ? 'Este archivo ya estaba cargado en este registro' : 'Archivo guardado',
        'success',
      );
      setTimeout(ocultarToast, 1200);
      setTimeout(() => window.location.reload(), 1500);
      return true;
    }

    async function quitarArchivo(url) {
      hideBanners();
      const res = await fetch(url, {
        method: 'DELETE',
        headers: { 'x-csrf-token': csrfToken },
      });
      if (res.redirected) {
        window.location.href = res.url;
        return;
      }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(data.error || 'No se pudo quitar el archivo.');
        return;
      }
      window.location.reload();
    }

    async function manejarSeleccionArchivoParaSubir(input) {
      if (!input.files.length) return;
      const wrapper = input.closest('.lab-archivo-uploader');
      const estudioId = wrapper.dataset.estudioId;
      const esTodos = !estudioId;

      bloquearCaminoOpuesto(esTodos);
      marcarSubiendoArchivo(input);

      const url = esTodos
        ? `laboratorio/${DATOS.registro.id}/archivos`
        : `laboratorio/${DATOS.registro.id}/estudios/${estudioId}/archivo`;
      const exito = await subirArchivosDeLaboratorio(url, input.files);
      if (!exito) {
        input.value = '';
        actualizarEstadoSeleccionArchivo(input);
        actualizarEstadosBotonesArchivo();
      }
    }

    if (PUEDE_CARGAR_ARCHIVOS) {
      const labArchivoTodosWrap = document.getElementById('labArchivoTodosWrap');
      labArchivoTodosWrap.addEventListener('change', (event) => {
        const input = event.target.closest('input[type=file]');
        if (input) manejarSeleccionArchivoParaSubir(input);
      });
      labArchivoTodosWrap.addEventListener('click', (event) => {
        if (event.target.closest('#labArchivoTodosReemplazar')) {
          labArchivoTodosWrap.innerHTML = renderArchivoUploader({ inputId: 'labArchivoTodosInput' });
          return;
        }
        if (event.target.closest('#labArchivoTodosQuitar')) {
          quitarArchivo(`laboratorio/${DATOS.registro.id}/archivos`);
        }
      });

      const labCartBody = document.getElementById('labCartBody');
      labCartBody.addEventListener('change', (event) => {
        const input = event.target.closest('input[type=file]');
        if (input) manejarSeleccionArchivoParaSubir(input);
      });
      labCartBody.addEventListener('click', (event) => {
        const reemplazarBtn = event.target.closest('.lab-archivo-reemplazar');
        if (reemplazarBtn) {
          reemplazarBtn.closest('.lab-archivo-chip').outerHTML = renderArchivoUploader({
            estudioId: reemplazarBtn.dataset.estudioId,
          });
          return;
        }
        const quitarBtn = event.target.closest('.lab-archivo-quitar');
        if (quitarBtn) {
          quitarArchivo(`laboratorio/${DATOS.registro.id}/estudios/${quitarBtn.dataset.estudioId}/archivo`);
        }
      });

      const quitarTodosIndividualesBtn = document.getElementById('labQuitarTodosIndividualesBtn');
      quitarTodosIndividualesBtn.addEventListener('click', () => {
        if (quitarTodosIndividualesBtn.disabled) return;
        quitarArchivo(`laboratorio/${DATOS.registro.id}/archivos`);
      });

      const enviarBtn = document.getElementById('labEnviarResultadosBtn');
      const enviarModal = document.getElementById('labEnviarModalBackdrop');
      const enviarModalTitulo = document.getElementById('labEnviarModalTitulo');
      const enviarModalMensaje = document.getElementById('labEnviarModalMensaje');
      const enviarModalCanales = document.getElementById('labEnviarModalCanales');
      const enviarModalCancelar = document.getElementById('labEnviarModalCancelar');
      const enviarModalConfirmar = document.getElementById('labEnviarModalConfirmar');
      const enviarModalCerrar = document.getElementById('labEnviarModalCerrar');
      let confirmacionTokenActual = null;

      const ICONO_EXITO =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12l3 3 5-6"/></svg>';
      const ICONO_ERROR =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M14.5 9.5l-5 5M9.5 9.5l5 5"/></svg>';

      function resumenEnvio(resultado) {
        const filas = [];
        if (resultado.correo?.intentado) {
          filas.push({
            canal: 'Correo',
            exito: Boolean(resultado.correo.enviado),
            detalle: resultado.correo.enviado
              ? 'Enviado correctamente.'
              : resultado.correo.error || 'No se pudo enviar.',
          });
        }
        if (resultado.whatsapp?.intentado) {
          filas.push({
            canal: 'WhatsApp',
            exito: Boolean(resultado.whatsapp.enviado),
            detalle: resultado.whatsapp.enviado
              ? 'Enviado correctamente.'
              : resultado.whatsapp.error || 'No se pudo enviar.',
          });
        }
        const huboExito = filas.some((fila) => fila.exito);
        return {
          titulo: huboExito ? 'Resultados enviados' : 'No se pudo enviar',
          filas,
        };
      }

      function renderCanalesEnvio(filas) {
        enviarModalCanales.innerHTML = filas
          .map(
            (fila) => `
              <div class="lab-envio-resultado-fila lab-envio-resultado-${fila.exito ? 'exito' : 'error'}">
                <span class="lab-envio-resultado-icono">${fila.exito ? ICONO_EXITO : ICONO_ERROR}</span>
                <span class="lab-envio-resultado-texto">
                  <strong>${escapeHtml(fila.canal)}</strong>
                  <span>${escapeHtml(fila.detalle)}</span>
                </span>
              </div>`,
          )
          .join('');
      }

      function mostrarResultadoGenerico(titulo, mensaje) {
        confirmacionTokenActual = null;
        enviarModalCancelar.hidden = true;
        enviarModalConfirmar.hidden = true;
        enviarModalCerrar.hidden = false;
        enviarModalTitulo.textContent = titulo;
        enviarModalMensaje.textContent = mensaje;
        enviarModalCanales.innerHTML = '';
        enviarModal.classList.add('open');
      }

      function mostrarResultadoPorCanal(titulo, filas) {
        confirmacionTokenActual = null;
        enviarModalCancelar.hidden = true;
        enviarModalConfirmar.hidden = true;
        enviarModalCerrar.hidden = false;
        enviarModalTitulo.textContent = titulo;
        enviarModalMensaje.textContent = '';
        renderCanalesEnvio(filas);
        enviarModal.classList.add('open');
      }

      function mostrarConfirmacionEnvio(data) {
        confirmacionTokenActual = data.confirmacionToken;
        enviarModalTitulo.textContent = data.esReenvio
          ? 'Confirmar reenvío de resultados'
          : 'Confirmar envío de resultados';
        enviarModalMensaje.textContent = data.esReenvio
          ? 'Estos resultados ya fueron enviados anteriormente. Confirma los destinatarios antes de reenviarlos.'
          : 'Verifica que los siguientes datos correspondan al tutor antes de continuar.';
        const canales = [];
        if (data.destinatarios?.correo) canales.push(['Correo', data.destinatarios.correo]);
        if (data.destinatarios?.whatsapp) canales.push(['WhatsApp', data.destinatarios.whatsapp]);
        enviarModalCanales.innerHTML = canales
          .map(
            ([canal, destino]) => `
              <div class="lab-envio-resultado-fila">
                <span class="lab-envio-resultado-texto">
                  <strong>${escapeHtml(canal)}</strong>
                  <span>${escapeHtml(destino)}</span>
                </span>
              </div>`,
          )
          .join('');
        enviarModalCancelar.hidden = false;
        enviarModalConfirmar.hidden = false;
        enviarModalConfirmar.textContent = data.esReenvio ? 'Confirmar reenvío' : 'Confirmar envío';
        enviarModalCerrar.hidden = true;
        enviarModal.classList.add('open');
      }

      async function prepararEnvioResultados() {
        mostrarLoaderGlobal('Validando destinatarios');
        try {
          const res = await fetch(`laboratorio/${DATOS.registro.id}/preparar-envio`, {
            method: 'POST',
            headers: { 'x-csrf-token': csrfToken },
          });
          ocultarLoaderGlobal();
          if (res.redirected) {
            window.location.href = res.url;
            return;
          }
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            mostrarResultadoGenerico(
              'No se puede preparar el envío',
              data.error || 'Ocurrió un error inesperado.',
            );
            return;
          }
          mostrarConfirmacionEnvio(data);
        } catch {
          ocultarLoaderGlobal();
          mostrarResultadoGenerico('No se pudo validar', 'No se pudo conectar con el servidor.');
        }
      }

      async function enviarResultados(confirmacionToken) {
        mostrarLoaderGlobal('Enviando archivos por WhatsApp y/o email');

        try {
          const res = await fetch(`laboratorio/${DATOS.registro.id}/enviar`, {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              'x-csrf-token': csrfToken,
            },
            body: JSON.stringify({ confirmacionToken }),
          });
          ocultarLoaderGlobal();
          if (res.redirected) {
            window.location.href = res.url;
            return;
          }
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            mostrarResultadoGenerico('No se pudo enviar', data.error || 'Ocurrió un error inesperado.');
            return;
          }

          const { titulo, filas } = resumenEnvio(data);
          mostrarResultadoPorCanal(titulo, filas);

          if (data.correo?.enviado || data.whatsapp?.enviado) {
            const badge = document.getElementById('labEstadoBadge');
            if (badge) {
              badge.className = 'badge badge-enviado';
              badge.textContent = 'Enviado';
            }
          }
        } catch {
          ocultarLoaderGlobal();
          mostrarResultadoGenerico('No se pudo enviar', 'No se pudo conectar con el servidor.');
        }
      }

      enviarBtn.addEventListener('click', () => {
        if (enviarBtn.disabled) return;
        prepararEnvioResultados();
      });
      enviarModalCancelar.addEventListener('click', () => {
        confirmacionTokenActual = null;
        enviarModal.classList.remove('open');
      });
      enviarModalConfirmar.addEventListener('click', () => {
        if (!confirmacionTokenActual) return;
        const token = confirmacionTokenActual;
        confirmacionTokenActual = null;
        enviarModal.classList.remove('open');
        enviarResultados(token);
      });
      document.getElementById('labEnviarModalClose').addEventListener('click', () => {
        confirmacionTokenActual = null;
        enviarModal.classList.remove('open');
      });
      enviarModalCerrar.addEventListener('click', () => {
        confirmacionTokenActual = null;
        enviarModal.classList.remove('open');
      });
      enviarModal.addEventListener('click', (event) => {
        if (event.target === enviarModal) {
          confirmacionTokenActual = null;
          enviarModal.classList.remove('open');
        }
      });
    }

    function actualizarModoBotonAgregar() {
      const editando = editIndex !== null;
      document.getElementById('btnAddStudyLabel').textContent = editando ? 'Guardar cambios' : 'Agregar estudio';
      document.getElementById('labCategoriaTrigger').disabled = editando;
      document.getElementById('labEstudioSearch').disabled = editando;
      refrescarCategoriaClear();
      refrescarEstudioClear();
    }

    function editarEstudioEnCarrito(idx) {
      const fila = selectedStudies[idx];
      const estudio = findEstudioPorId(fila.estudioId);
      if (!estudio) return;

      clearEstudioSelection();
      editIndex = idx;

      categoriaFiltro = String(estudio.categoriaId);
      document.getElementById('labCategoriaId').value = categoriaFiltro;
      document.getElementById('labCategoriaTrigger').value = estudio.categoriaNombre;
      refrescarCategoriaClear();

      selectEstudio(estudio.id);

      if (fila.zonaAnatomicaId) {
        const zona = CATALOGO.zonasAnatomicas.find((z) => z.id === fila.zonaAnatomicaId);
        document.getElementById('labZonaId').value = fila.zonaAnatomicaId;
        document.getElementById('labZonaTrigger').value = zona ? zona.nombre : '';
        refrescarZonaClear();
      }
      if (fila.tipoMuestra) document.getElementById('labTipoMuestra').value = fila.tipoMuestra;
      document.getElementById('labAntibiograma').checked = Boolean(fila.antibiograma);
      if (fila.tejidoOrigen) {
        document.getElementById('labTejidoOrigen').value = fila.tejidoOrigen;
        if (fila.lateralidad) {
          document.getElementById('labLateralidadId').value = fila.lateralidad;
          document.getElementById('labLateralidadTrigger').value = etiquetaLateralidad(fila.lateralidad) || 'No aplica';
        }
      }
      if (fila.componentesLiquido) {
        document.querySelectorAll('#labComponentesGrid input[type=checkbox]').forEach((cb) => {
          cb.checked = fila.componentesLiquido.includes(cb.value);
        });
      }
      document.getElementById('labEstudioObservaciones').value = fila.observaciones || '';

      actualizarModoBotonAgregar();
      document.querySelector('.lab-estudios-picker')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }

    if (!SOLO_LECTURA) {
      document.getElementById('btnAddStudy').addEventListener('click', () => {
        hideBanners();
        const estudioId = document.getElementById('labEstudioId').value;
        const estudio = findEstudioPorId(estudioId);
        if (!estudio) {
          document.getElementById('labEstudioSearch').focus();
          return;
        }

        const fila = { estudioId: estudio.id };

        if (estudio.campoAdicional === 'zona') {
          const zonaId = document.getElementById('labZonaId').value;
          if (!zonaId) {
            showError(`"${estudio.nombre}" requiere seleccionar una zona anatómica.`);
            return;
          }
          fila.zonaAnatomicaId = Number(zonaId);
        } else if (estudio.campoAdicional === 'tipo_muestra') {
          const tipoMuestra = document.getElementById('labTipoMuestra').value.trim();
          if (!tipoMuestra) {
            showError(`"${estudio.nombre}" requiere indicar el tipo de muestra.`);
            return;
          }
          fila.tipoMuestra = tipoMuestra;
        } else if (estudio.campoAdicional === 'tejido_lateralidad') {
          const tejidoOrigen = document.getElementById('labTejidoOrigen').value.trim();
          if (!tejidoOrigen) {
            showError(`"${estudio.nombre}" requiere indicar el tejido de origen.`);
            return;
          }
          fila.tejidoOrigen = tejidoOrigen;
          const lateralidad = document.getElementById('labLateralidadId').value;
          if (lateralidad) fila.lateralidad = lateralidad;
        } else if (estudio.campoAdicional === 'componentes_liquido') {
          const componentesLiquido = Array.from(document.querySelectorAll('#labComponentesGrid input[type=checkbox]:checked')).map((cb) => cb.value);
          if (componentesLiquido.length === 0) {
            showError(`"${estudio.nombre}" requiere seleccionar al menos un componente.`);
            return;
          }
          fila.componentesLiquido = componentesLiquido;
        }

        if (estudio.permiteAntibiograma) {
          fila.antibiograma = document.getElementById('labAntibiograma').checked;
        }

        const observaciones = document.getElementById('labEstudioObservaciones').value.trim();
        if (observaciones) fila.observaciones = observaciones;

        if (editIndex !== null) {
          selectedStudies[editIndex] = fila;
          editIndex = null;
        } else {
          selectedStudies.push(fila);
        }
        renderCart();
        clearEstudioSelection();
        actualizarModoBotonAgregar();
      });

      document.getElementById('labCartBody').addEventListener('click', (event) => {
        const btn = event.target.closest('[data-action]');
        if (!btn) return;
        const idx = Number(btn.dataset.idx);
        if (btn.dataset.action === 'eliminar') {
          selectedStudies.splice(idx, 1);
          if (editIndex !== null) {
            if (editIndex === idx) {
              editIndex = null;
              clearEstudioSelection();
              actualizarModoBotonAgregar();
            } else if (editIndex > idx) {
              editIndex -= 1;
            }
          }
          renderCart();
        } else if (btn.dataset.action === 'editar') {
          editarEstudioEnCarrito(idx);
        }
      });
    }

    function precargar() {
      if (!SOLO_LECTURA) clearEstudioSelection();

      const registro = DATOS.registro;
      if (!registro) {
        document.getElementById('labFecha').value = new Date().toISOString().slice(0, 10);
        if (DATOS.doctorIdPreseleccionado) preseleccionarDoctor(DATOS.doctorIdPreseleccionado);
        return;
      }

      const digitosTelefono = (registro.propietarioTelefono ?? '').replace(/\D/g, '');
      document.getElementById('labTelefono').value = formatearTelefono(digitosTelefono);
      tutorActual = {
        id: registro.propietarioId,
        nombre: registro.propietarioNombre,
        apellidos: registro.propietarioApellidos,
        correo: registro.propietarioCorreo,
        pacientes: registro.pacientesDelTutor,
      };
      renderTutor();
      renderPacienteOptions();
      seleccionarPaciente(registro.mascotaId);

      preseleccionarDoctor(registro.doctorId);
      document.getElementById('labFecha').value = registro.fechaSolicitud
        ? new Date(registro.fechaSolicitud).toISOString().slice(0, 10)
        : '';
      document.getElementById('labObservacionesGenerales').value = registro.observaciones ?? '';

      selectedStudies = registro.estudios.map((e) => {
        const fila = {
          id: e.id,
          estudioId: e.estudio_id,
          archivoId: e.archivo_id,
          archivoNombre: e.archivo_nombre,
          archivoCargadoEn: e.archivo_cargado_en,
        };

        if (e.zona_anatomica_id) {
          fila.zonaAnatomicaId = e.zona_anatomica_id;
        } else if (e.tipo_muestra) {
          fila.tipoMuestra = e.tipo_muestra;
        } else if (e.tejido_origen) {
          fila.tejidoOrigen = e.tejido_origen;
          if (e.lateralidad) fila.lateralidad = e.lateralidad;
        } else if (e.componentes_liquido) {
          fila.componentesLiquido = e.componentes_liquido;
        }
        if (e.antibiograma != null) fila.antibiograma = Boolean(e.antibiograma);
        if (e.observaciones) fila.observaciones = e.observaciones;

        return fila;
      });
      renderCart();
    }

    async function guardar() {
      hideBanners();

      const payload = {
        mascotaId: document.getElementById('labPacienteId').value,
        doctorId: document.getElementById('labDoctorId').value,
        fechaSolicitud: document.getElementById('labFecha').value,
        observaciones: document.getElementById('labObservacionesGenerales').value,
        estudios: selectedStudies,
      };

      if (!payload.mascotaId) return showError('Selecciona un paciente.');
      if (!payload.doctorId) return showError('Selecciona el doctor solicitante.');
      if (!payload.fechaSolicitud) return showError('Selecciona la fecha de solicitud.');
      if (selectedStudies.length === 0) return showError('Agrega al menos un estudio antes de guardar.');

      const btn = document.getElementById('labGuardarBtn');
      btn.disabled = true;

      const esEdicion = Boolean(DATOS.registro);
      const res = await fetch(esEdicion ? `laboratorio/${DATOS.registro.id}` : 'laboratorio', {
        method: esEdicion ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify(payload),
      });

      if (res.redirected) {
        window.location.href = res.url;
        return;
      }

      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(data.error || 'No se pudo guardar el registro.');
        btn.disabled = false;
        return;
      }
      window.location.href = data.redirectTo;
    }

    if (!SOLO_LECTURA) {
      document.getElementById('labGuardarBtn').addEventListener('click', guardar);
    }

    function prepararDocumentoImpresion() {
      document.getElementById('labPrintFolio').textContent = DATOS.registro
        ? `LAB-${String(DATOS.registro.id).padStart(3, '0')}`
        : 'Sin guardar';
      document.getElementById('labPrintFechaImpresion').textContent = new Date().toLocaleDateString('es-MX', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
      });

      document.getElementById('labPrintTutor').textContent = document.getElementById('labTutorNombre').value || '—';
      document.getElementById('labPrintTelefono').textContent = document.getElementById('labTelefono').value || '—';
      document.getElementById('labPrintCorreo').textContent = document.getElementById('labTutorCorreo').value || '—';
      document.getElementById('labPrintPaciente').textContent =
        document.getElementById('labPacienteTrigger').value || '—';
      document.getElementById('labPrintEspecie').textContent =
        document.getElementById('labPacienteEspecieLabel').textContent || '—';
      document.getElementById('labPrintSexo').textContent =
        document.getElementById('labPacienteSexoLabel').textContent || '—';
      document.getElementById('labPrintEdad').textContent = document.getElementById('labPacienteEdad').textContent || '—';
      document.getElementById('labPrintRaza').textContent = document.getElementById('labPacienteRaza').textContent || '—';

      document.getElementById('labPrintDoctor').textContent = document.getElementById('labDoctorInput').value || '—';
      document.getElementById('labPrintDoctorCedula').textContent =
        document.getElementById('labDoctorCedula').value || '—';
      const fechaRaw = document.getElementById('labFecha').value;
      document.getElementById('labPrintFecha').textContent = fechaRaw
        ? new Date(`${fechaRaw}T00:00:00`).toLocaleDateString('es-MX', { day: '2-digit', month: '2-digit', year: 'numeric' })
        : '—';

      const estudiosWrap = document.getElementById('labPrintEstudios');
      estudiosWrap.innerHTML = selectedStudies.length
        ? selectedStudies
            .map((s) => {
              const estudio = findEstudioPorId(s.estudioId);
              const nombre = estudio ? estudio.nombre : 'Estudio';
              const meta = [estudio ? estudio.categoriaNombre : '', detalleDeFila(s)].filter(Boolean).join(' · ');
              return `
                <div class="lab-print-estudio">
                  <strong>${escapeHtml(nombre)}</strong>
                  ${meta ? `<div>${escapeHtml(meta)}</div>` : ''}
                  ${s.observaciones ? `<div><em>Nota:</em> ${escapeHtml(s.observaciones)}</div>` : ''}
                </div>
              `;
            })
            .join('')
        : '<p>Sin estudios agregados.</p>';

      const observaciones = document.getElementById('labObservacionesGenerales').value.trim();
      document.getElementById('labPrintObservacionesSection').hidden = !observaciones;
      document.getElementById('labPrintObservaciones').textContent = observaciones;
    }

    document.getElementById('labImprimirBtn').addEventListener('click', () => {
      prepararDocumentoImpresion();
      window.print();
    });

    precargar();
    renderCart();
    if (PUEDE_CARGAR_ARCHIVOS) {
      renderArchivoTodos();
      actualizarEstadosBotonesArchivo();
    }
  </script>

</body>
</html>
