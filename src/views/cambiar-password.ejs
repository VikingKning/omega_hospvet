<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cambiar contraseña | Omega Veterinaria & Estética</title>
<link rel="icon" type="image/png" href="assets/imgs/icon.png">
<link rel="stylesheet" href="css/styles.css">
</head>
<body>

  <%
  // US-605: página independiente, fuera del layout con sidebar (mismo
  // criterio que index.ejs/login) — una sesión restringida
  // (mustChangePassword=true) no debe ni ver el menú principal mientras no
  // complete este paso, así que no tiene sentido embeberla ahí. Reusa
  // .login-card/.field/.input-wrap/.toggle-pass de styles.css tal cual,
  // sin CSS nuevo.
  %>
  <form class="login-card" novalidate>
    <input type="hidden" id="csrfToken" value="<%= csrfToken %>">

    <div class="login-brand">
      <img src="assets/imgs/icon.png" alt="Omega Veterinaria & Estética">
      <h1>Omega Veterinaria & Estética</h1>
      <p>Debes cambiar tu contraseña para continuar</p>
    </div>

    <span class="error-msg" id="form-error"></span>

    <div class="field">
      <label for="password">Nueva contraseña</label>
      <div class="input-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <input type="password" id="password" name="password" placeholder="Mínimo 15 caracteres" autocomplete="new-password">
        <button type="button" class="toggle-pass" id="togglePassword" aria-label="Mostrar contraseña">
          <svg id="passwordEyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
      <span class="error-msg" id="password-error">La contraseña debe tener al menos 15 caracteres. Puedes utilizar letras, números, símbolos y espacios.</span>
    </div>

    <div class="field">
      <label for="confirmacion">Confirmar contraseña</label>
      <div class="input-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <input type="password" id="confirmacion" name="confirmacion" placeholder="Repite la contraseña" autocomplete="new-password">
        <button type="button" class="toggle-pass" id="toggleConfirmacion" aria-label="Mostrar contraseña">
          <svg id="confirmacionEyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
      <span class="error-msg" id="confirmacion-error">Las contraseñas no coinciden.</span>
    </div>

    <button type="submit" class="btn-submit">Cambiar contraseña</button>

    <p class="login-footer">&copy; 2026 Omega Veterinaria & Estética</p>
  </form>

<script nonce="<%= cspNonce %>">
  const form = document.querySelector('.login-card');
  const password = document.getElementById('password');
  const confirmacion = document.getElementById('confirmacion');
  const formError = document.getElementById('form-error');
  const submitBtn = form.querySelector('.btn-submit');
  const csrfToken = document.getElementById('csrfToken').value;
  const PASSWORD_MIN_LENGTH = 15;

  function showFormError(message) {
    formError.textContent = message;
    formError.classList.add('show');
  }

  function validatePassword() {
    const error = document.getElementById('password-error');
    if (password.value.length < PASSWORD_MIN_LENGTH) {
      password.classList.add('invalid');
      error.classList.add('show');
      return false;
    }
    password.classList.remove('invalid');
    error.classList.remove('show');
    return true;
  }

  function validateConfirmacion() {
    const error = document.getElementById('confirmacion-error');
    if (confirmacion.value !== password.value) {
      confirmacion.classList.add('invalid');
      error.classList.add('show');
      return false;
    }
    confirmacion.classList.remove('invalid');
    error.classList.remove('show');
    return true;
  }

  password.addEventListener('input', () => {
    validatePassword();
    if (confirmacion.value) validateConfirmacion();
  });
  confirmacion.addEventListener('input', validateConfirmacion);

  // Mismo mecanismo del ojo de mostrar/ocultar que index.ejs (login),
  // reutilizado para los dos campos de esta pantalla — un solo helper en
  // vez de duplicar el listener dos veces con nombres de variable
  // distintos.
  function wireTogglePass(toggleId, inputId, eyeIconId) {
    const toggle = document.getElementById(toggleId);
    const input = document.getElementById(inputId);
    const eyeIcon = document.getElementById(eyeIconId);
    toggle.addEventListener('click', () => {
      const isPassword = input.getAttribute('type') === 'password';
      input.setAttribute('type', isPassword ? 'text' : 'password');
      toggle.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
      eyeIcon.innerHTML = isPassword
        ? '<path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.8 21.8 0 0 1 5.06-6.06M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.8 21.8 0 0 1-3.22 4.36M1 1l22 22"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>'
        : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
    });
  }
  wireTogglePass('togglePassword', 'password', 'passwordEyeIcon');
  wireTogglePass('toggleConfirmacion', 'confirmacion', 'confirmacionEyeIcon');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.classList.remove('show');

    const validPassword = validatePassword();
    const validConfirmacion = validateConfirmacion();
    if (!validPassword || !validConfirmacion) return;

    submitBtn.disabled = true;
    try {
      const res = await fetch('/cambiar-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ password: password.value, confirmacion: confirmacion.value }),
      });
      const data = await res.json();

      if (!res.ok) {
        showFormError(data.error || 'No se pudo cambiar la contraseña.');
        return;
      }

      window.location.href = data.redirectTo;
    } catch (err) {
      showFormError('No se pudo conectar con el servidor. Intenta de nuevo.');
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

</body>
</html>
