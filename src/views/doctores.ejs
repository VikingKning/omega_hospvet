<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Doctores | Omega Veterinaria & Estética</title>
<link rel="icon" type="image/png" href="assets/imgs/icon.png">
<link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="css/main.css">
<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true}'>
<script src="js/htmx.min.js" nonce="<%= cspNonce %>"></script>
</head>
<body>

  <div class="app" id="app">
    <div class="top-row">
      <div class="sidebar-header">
        <img src="assets/imgs/icon.png" alt="Omega Veterinaria & Estética">
        <span class="sidebar-title">Omega Vet</span>
        <button id="sidebarToggle" class="sidebar-toggle-btn" type="button" aria-label="Mostrar u ocultar menú">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>

      <header class="topbar">
        <span class="topbar-icon-badge">
          <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </span>
        <h1 class="topbar-title">Catalogo de Doctores</h1>
        <a class="topbar-user" href="mi-perfil.html">
          <span class="topbar-user-avatar avatar-color-<%= user.avatar %>">
            <img src="assets/imgs/<%= user.avatar %>.png" alt="">
          </span>
          <span class="topbar-user-name"><%= user.nombre %> <%= user.apellidos %></span>
        </a>
      </header>
    </div>

    <div class="body-row">
    <div class="nav-backdrop" id="navBackdrop"></div>
    <%- include('partials/sidebar', { user, currentPage: 'doctores' }) %>

    <main class="main-content" id="doctores-panel">
      <%- include('partials/doctores-panel', { doctores, total, catalogoVacio, page, totalPages, pageSize, q, estado, sort, dir, user, csrfToken }) %>
    </main>
    </div>
  </div>

  <%#
    Modal de confirmación reutilizable para acciones destructivas de esta
    vista (por ahora solo "dar de baja"). Vive fuera de #doctores-panel a
    propósito: HTMX reemplaza ese contenedor en cada filtro/orden/página, y
    si el modal viviera adentro se destruiría a medio uso en cuanto la
    petición terminara.
  %>
  <div class="modal-backdrop" id="confirmModalBackdrop">
    <div class="modal-card">
      <div class="modal-header">
        <h2>Confirmar acción</h2>
        <button class="modal-close-btn" type="button" id="confirmModalClose" aria-label="Cerrar">&times;</button>
      </div>
      <p id="confirmModalMessage"></p>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="confirmModalCancel">Cancelar</button>
        <button type="button" class="btn-danger" id="confirmModalConfirm">Dar de baja</button>
      </div>
    </div>
  </div>

  <%#
    Modal de alta/edición (US-607): mismo formulario para las dos acciones,
    el contenido real lo llena HTMX (partials/doctor-form.ejs) al hacer
    clic en el botón de alta del toolbar o en el ícono de editar de una
    fila — ver doctores-panel.ejs. Vive fuera de #doctores-panel por la
    misma razón que el modal de confirmación (mismo patrón que
    areaFormModalBackdrop en areas.ejs).
  %>
  <div class="modal-backdrop" id="doctorFormModalBackdrop">
    <div class="modal-card" id="doctorFormModalBody"></div>
  </div>

<script nonce="<%= cspNonce %>">
  const sidebar = document.getElementById('sidebar');
  const app = document.querySelector('.app');
  const sidebarToggle = document.getElementById('sidebarToggle');
  const navBackdrop = document.getElementById('navBackdrop');

  sidebarToggle.addEventListener('click', () => {
    app.classList.toggle('sidebar-hidden');
    app.classList.toggle('mobile-menu-open');
  });

  navBackdrop.addEventListener('click', () => {
    app.classList.remove('sidebar-hidden');
    app.classList.remove('mobile-menu-open');
  });

  document.querySelectorAll('.nav-toggle').forEach((toggle) => {
    const submenu = document.getElementById(toggle.dataset.target);
    if (submenu.classList.contains('open')) {
      submenu.style.maxHeight = `${submenu.scrollHeight}px`;
    }

    toggle.addEventListener('click', () => {
      const isOpen = submenu.classList.contains('open');

      document.querySelectorAll('.submenu.open').forEach((open) => {
        if (open !== submenu) {
          open.classList.remove('open');
          open.style.maxHeight = null;
          open.previousElementSibling?.classList.remove('active');
        }
      });

      submenu.classList.toggle('open', !isOpen);
      toggle.classList.toggle('active', !isOpen);
      submenu.style.maxHeight = !isOpen ? `${submenu.scrollHeight}px` : null;
    });
  });

  // Modal de confirmación en vez del confirm() nativo del navegador: patrón
  // documentado por HTMX (evento htmx:confirm + evt.detail.issueRequest).
  // Solo se intercepta cuando el elemento que disparó la petición trae
  // hx-confirm — así los demás triggers de esta vista (buscar, ordenar,
  // paginar) siguen sin pedir confirmación, como hasta ahora.
  const confirmModalBackdrop = document.getElementById('confirmModalBackdrop');
  const confirmModalMessage = document.getElementById('confirmModalMessage');
  let resolveConfirm = null;

  function openConfirmModal(message) {
    confirmModalMessage.textContent = message;
    confirmModalBackdrop.classList.add('open');
    return new Promise((resolve) => {
      resolveConfirm = resolve;
    });
  }

  function closeConfirmModal(result) {
    confirmModalBackdrop.classList.remove('open');
    resolveConfirm?.(result);
    resolveConfirm = null;
  }

  document.getElementById('confirmModalCancel').addEventListener('click', () => closeConfirmModal(false));
  document.getElementById('confirmModalClose').addEventListener('click', () => closeConfirmModal(false));
  document.getElementById('confirmModalConfirm').addEventListener('click', () => closeConfirmModal(true));
  confirmModalBackdrop.addEventListener('click', (event) => {
    if (event.target === confirmModalBackdrop) closeConfirmModal(false);
  });

  document.body.addEventListener('htmx:confirm', (event) => {
    if (!event.target.hasAttribute('hx-confirm')) return;
    event.preventDefault();
    openConfirmModal(event.detail.question).then((confirmed) => {
      if (confirmed) event.detail.issueRequest(true);
    });
  });

  // Modal de alta/edición (US-607). El contenido de #doctorFormModalBody lo
  // reemplaza HTMX en cada apertura/reintento, así que los botones de
  // adentro (cerrar, cancelar, cerrar el mensaje de error) y el picker de
  // especialidades se manejan por delegación en el contenedor — un
  // addEventListener directo sobre esos elementos se perdería en cuanto
  // HTMX los vuelva a crear. Mismo patrón que areaFormModalBody en
  // areas.ejs.
  const doctorFormModalBackdrop = document.getElementById('doctorFormModalBackdrop');
  const doctorFormModalBody = document.getElementById('doctorFormModalBody');

  function openDoctorFormModal() {
    doctorFormModalBackdrop.classList.add('open');
  }

  function closeDoctorFormModal() {
    doctorFormModalBackdrop.classList.remove('open');
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // El picker de especialidades vive dentro de .modal-card, que tiene
  // `overflow-y:auto` — un `.combobox-list` con `position:absolute` (el
  // default de main.css) sigue contando para el área scrolleable de ese
  // ancestro aunque se vea como un overlay, así que el modal completo
  // ganaba un scrollbar innecesario solo para "alcanzar" la lista. Se
  // resuelve pasándola a `position:fixed` (relativa al viewport, escapa
  // cualquier overflow de sus ancestros) con coordenadas calculadas a
  // partir de dónde quedó el trigger en pantalla.
  function positionComboboxList(trigger, list) {
    const rect = trigger.getBoundingClientRect();
    list.style.position = 'fixed';
    list.style.top = `${rect.bottom + 4}px`;
    list.style.left = `${rect.left}px`;
    list.style.width = `${rect.width}px`;
    list.style.right = 'auto';
  }

  // Estado del picker de especialidades: vive en JS, no en el DOM, para no
  // depender de que HTMX re-ejecute scripts al hacer swap (ver el
  // <script type="application/json"> inerte en doctor-form.ejs). Se
  // reinicia en cada apertura/reintento del formulario, leyendo esa isla
  // de datos.
  let doctorFormAreas = { disponibles: [], seleccionadas: [] };

  function renderAreaPicker() {
    const trigger = document.getElementById('areaPickerTrigger');
    const valueInput = document.getElementById('areaPickerValue');
    const list = document.getElementById('areaPickerList');
    if (!trigger || !valueInput || !list) return;
    const yaAsignadas = new Set(doctorFormAreas.seleccionadas.map((area) => area.id));
    const opciones = doctorFormAreas.disponibles.filter((area) => !yaAsignadas.has(area.id));
    // Mismo criterio que fEstudioList (laboratorio.ejs) y doctorList
    // (usuarios.ejs) para "sin resultados": .combobox-empty, no un <li>
    // seleccionable — evita que la lista se vea vacía/rota cuando un
    // doctor ya tiene todas las áreas del catálogo asignadas.
    list.innerHTML = opciones.length
      ? opciones
          .map(
            (area) =>
              `<li class="combobox-item" data-id="${area.id}" data-label="${escapeHtml(area.nombre)}">${escapeHtml(area.nombre)}</li>`,
          )
          .join('')
      : '<li class="combobox-empty">No hay más especialidades disponibles.</li>';
    // Repoblar la lista siempre resetea la selección — mismo comportamiento
    // que el <select> anterior, que también perdía su .value al
    // reconstruir sus <option> desde cero en cada agregar/quitar.
    trigger.value = '';
    valueInput.value = '';
  }

  function renderDoctorAreas() {
    const body = document.getElementById('doctorAreasBody');
    const empty = document.getElementById('doctorAreasEmpty');
    if (!body || !empty) return;
    empty.hidden = doctorFormAreas.seleccionadas.length !== 0;
    body.innerHTML = doctorFormAreas.seleccionadas
      .map(
        (area) => `
          <tr>
            <td>${escapeHtml(area.nombre)}<input type="hidden" name="areaIds" value="${area.id}"></td>
            <td><button type="button" class="mini-remove" data-id="${area.id}" aria-label="Quitar ${escapeHtml(area.nombre)}">&times;</button></td>
          </tr>
        `,
      )
      .join('');
  }

  document.body.addEventListener('htmx:afterSwap', (event) => {
    if (event.detail.target !== doctorFormModalBody) return;
    // Si el fragmento trae un <form> (carga inicial, o reintento tras un
    // error de validación) el modal debe quedar/seguir abierto. La
    // respuesta de éxito no trae form (solo el swap out-of-band de la
    // tabla) — en ese caso no hay nada que abrir, el evento
    // closeDoctorModal de abajo se encarga de cerrarlo.
    if (!doctorFormModalBody.querySelector('form')) return;

    const datosEl = document.getElementById('doctorFormAreasData');
    const datos = datosEl ? JSON.parse(datosEl.textContent) : { disponibles: [], seleccionadas: [] };
    doctorFormAreas = { disponibles: datos.disponibles, seleccionadas: datos.seleccionadas.slice() };
    renderAreaPicker();
    renderDoctorAreas();
    openDoctorFormModal();
  });

  // US-607 (segunda iteración): abre la lista del picker de especialidades
  // al enfocar el trigger (mismo criterio que el combobox de Estatus en
  // usuario-form.ejs — un input de solo lectura sí recibe foco por click o
  // tab, aunque no se pueda escribir en él).
  doctorFormModalBody.addEventListener('focusin', (event) => {
    if (event.target.id !== 'areaPickerTrigger') return;
    const list = document.getElementById('areaPickerList');
    if (!list) return;
    positionComboboxList(event.target, list);
    list.hidden = false;
  });

  doctorFormModalBody.addEventListener('click', (event) => {
    if (event.target.closest('#doctorFormClose, #doctorFormCancel')) {
      closeDoctorFormModal();
    }
    if (event.target.closest('#doctorFormErrorDismiss')) {
      event.target.closest('.form-error-banner')?.remove();
    }
    const areaItem = event.target.closest('#areaPickerList .combobox-item');
    if (areaItem) {
      // El combobox vive dentro de un <label> (Especialidades), y el <li>
      // no es un control enfocable — sin preventDefault(), el navegador
      // reenvía el click como si fuera sobre el control asociado del label
      // (#areaPickerTrigger), reenfocándolo justo después de seleccionar.
      // Eso dispara el listener de "focusin" de arriba y reabre la lista
      // que este mismo click acaba de cerrar (mismo bug, mismo fix, que
      // selectDoctor() en usuarios.ejs para "Doctor vinculado").
      event.preventDefault();
      document.getElementById('areaPickerTrigger').value = areaItem.dataset.label;
      document.getElementById('areaPickerValue').value = areaItem.dataset.id;
      document.getElementById('areaPickerList').hidden = true;
      return;
    }
    if (event.target.closest('#areaPickerAdd')) {
      const id = Number(document.getElementById('areaPickerValue').value);
      if (!id) return;
      const area = doctorFormAreas.disponibles.find((a) => a.id === id);
      if (!area) return;
      doctorFormAreas.seleccionadas.push(area);
      renderAreaPicker();
      renderDoctorAreas();
    }
    const removeBtn = event.target.closest('.mini-remove');
    if (removeBtn) {
      const id = Number(removeBtn.dataset.id);
      doctorFormAreas.seleccionadas = doctorFormAreas.seleccionadas.filter((a) => a.id !== id);
      renderAreaPicker();
      renderDoctorAreas();
    }
  });

  document.addEventListener('click', (event) => {
    const combobox = document.getElementById('areaPickerCombobox');
    if (combobox && !combobox.contains(event.target)) {
      document.getElementById('areaPickerList')?.setAttribute('hidden', '');
    }
  });

  doctorFormModalBackdrop.addEventListener('click', (event) => {
    if (event.target === doctorFormModalBackdrop) closeDoctorFormModal();
  });

  // HX-Trigger: closeDoctorModal (ver doctores.controller.js, renderExito())
  // — htmx traduce ese header en este evento personalizado.
  document.body.addEventListener('closeDoctorModal', closeDoctorFormModal);
</script>

</body>
</html>
