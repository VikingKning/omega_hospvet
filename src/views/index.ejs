<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Iniciar sesión | Omega Veterinaria & Estética</title>
<link rel="icon" type="image/png" href="assets/imgs/icon.png">
<link rel="stylesheet" href="css/styles.css">
</head>
<body>

  <form class="login-card" novalidate>
    <input type="hidden" id="csrfToken" value="<%= csrfToken %>">

    <div class="login-brand">
      <img src="assets/imgs/icon.png" alt="Omega Veterinaria & Estética">
      <h1>Omega Veterinaria & Estética</h1>
      <p>Panel administrativo</p>
    </div>

    <% if (expired) { %>
      <span class="error-msg show" id="form-notice">Tu sesión expiró. Inicia sesión de nuevo.</span>
    <% } %>
    <span class="error-msg" id="form-error"></span>

    <div class="field">
      <label for="username">Usuario</label>
      <div class="input-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <input type="text" id="username" name="username" placeholder="Ingresa tu usuario" autocomplete="username">
      </div>
      <span class="error-msg" id="username-error">Por favor ingresa tu usuario.</span>
    </div>

    <div class="field">
      <label for="password">Contraseña</label>
      <div class="input-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <input type="password" id="password" name="password" placeholder="Ingresa tu contraseña" autocomplete="current-password">
        <button type="button" class="toggle-pass" id="togglePass" aria-label="Mostrar contraseña">
          <svg id="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
      <span class="error-msg" id="password-error">Por favor ingresa tu contraseña.</span>
    </div>

    <div class="login-options">
      <label><input type="checkbox" name="remember"> Recordarme</label>
      <a href="#">¿Olvidaste tu contraseña?</a>
    </div>

    <button type="submit" class="btn-submit">Iniciar sesión</button>

    <p class="login-footer">&copy; 2026 Omega Veterinaria & Estética</p>
  </form>

<script nonce="<%= cspNonce %>">
  const form = document.querySelector('.login-card');
  const username = document.getElementById('username');
  const password = document.getElementById('password');
  const togglePass = document.getElementById('togglePass');
  const eyeIcon = document.getElementById('eyeIcon');

  function validateField(input, errorId) {
    const error = document.getElementById(errorId);
    if (input.value.trim() === '') {
      input.classList.add('invalid');
      error.classList.add('show');
      return false;
    }
    input.classList.remove('invalid');
    error.classList.remove('show');
    return true;
  }

  [username, password].forEach((input) => {
    input.addEventListener('input', () => validateField(input, `${input.id}-error`));
  });

  const formError = document.getElementById('form-error');
  const submitBtn = form.querySelector('.btn-submit');
  const csrfToken = document.getElementById('csrfToken').value;

  function showFormError(message) {
    formError.textContent = message;
    formError.classList.add('show');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.classList.remove('show');

    const validUser = validateField(username, 'username-error');
    const validPass = validateField(password, 'password-error');
    if (!validUser || !validPass) return;

    submitBtn.disabled = true;
    try {
      const res = await fetch('/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ username: username.value, password: password.value }),
      });
      const data = await res.json();

      if (!res.ok) {
        showFormError(data.error || 'No se pudo iniciar sesión.');
        return;
      }

      window.location.href = data.redirectTo;
    } catch (err) {
      showFormError('No se pudo conectar con el servidor. Intenta de nuevo.');
    } finally {
      submitBtn.disabled = false;
    }
  });

  togglePass.addEventListener('click', () => {
    const isPassword = password.getAttribute('type') === 'password';
    password.setAttribute('type', isPassword ? 'text' : 'password');
    togglePass.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
    eyeIcon.innerHTML = isPassword
      ? '<path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.8 21.8 0 0 1 5.06-6.06M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.8 21.8 0 0 1-3.22 4.36M1 1l22 22"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>'
      : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  });
</script>

</body>
</html>
