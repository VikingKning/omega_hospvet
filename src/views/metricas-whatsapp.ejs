<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<base href="/">
<title>Métricas de WhatsApp | Omega Hospital Veterinario</title>
<link rel="icon" type="image/png" href="assets/imgs/icon.png">
<link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="css/main.css">
<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true}'>
<script src="js/htmx.min.js" nonce="<%= cspNonce %>"></script>
</head>
<body>
  <div class="app" id="app">
    <div class="top-row">
      <div class="sidebar-header">
        <img src="assets/imgs/icon.png" alt="Omega Hospital Veterinario">
        <span class="sidebar-title">Omega Vet</span>
        <button id="sidebarToggle" class="sidebar-toggle-btn" type="button" aria-label="Mostrar u ocultar menú">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>
      <header class="topbar">
        <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <h1 class="topbar-title">Métricas de WhatsApp</h1>
        <a class="topbar-user" href="mi-perfil.html">
          <span class="topbar-user-avatar avatar-color-<%= user.avatar %>"><img src="assets/imgs/<%= user.avatar %>.png" alt=""></span>
          <span class="topbar-user-name"><%= user.nombre %> <%= user.apellidos %></span>
        </a>
      </header>
    </div>
    <div class="body-row">
      <div class="nav-backdrop" id="navBackdrop"></div>
      <%- include('partials/sidebar', { user, currentPage: 'metricas-whatsapp' }) %>
      <main class="main-content" id="metricas-whatsapp-panel">
        <%- include('partials/metricas-whatsapp-panel', { rango, agrupacion, total, exitosos, fallidos, tasaExito, promedioDiario, plantillaMasUtilizada, usosPlantillaMasUtilizada, errorMasFrecuente, ocurrenciasErrorMasFrecuente, tendencia, resultadoEnvios, mensajesPorPlantilla, erroresFrecuentes, porDiaSemana, porHora, plantillasConFallos, mapaCalor, conversacional, zonaHoraria, csrfToken }) %>
      </main>
    </div>
  </div>

<script src="js/sidebar.js" nonce="<%= cspNonce %>"></script>
<script src="js/chart.umd.js" nonce="<%= cspNonce %>"></script>
<script nonce="<%= cspNonce %>">
  const whatsappPanel = document.getElementById('metricas-whatsapp-panel');
  const graficasWhatsapp = {};
  let reporteWhatsappActivo = 'salientes';

  function destruirGraficasWhatsapp() {
    Object.values(graficasWhatsapp).forEach((chart) => chart?.destroy());
  }

  function configurarReportesWhatsapp() {
    const pestanas = [...document.querySelectorAll('[data-whatsapp-report-tab]')];
    const paneles = [...document.querySelectorAll('[data-whatsapp-report]')];
    if (!pestanas.some((pestana) => pestana.dataset.whatsappReportTab === reporteWhatsappActivo)) {
      reporteWhatsappActivo = 'salientes';
    }

    const mostrar = (reporte) => {
      reporteWhatsappActivo = reporte;
      pestanas.forEach((pestana) => {
        const activa = pestana.dataset.whatsappReportTab === reporte;
        pestana.classList.toggle('active', activa);
        pestana.setAttribute('aria-selected', activa ? 'true' : 'false');
        pestana.tabIndex = activa ? 0 : -1;
      });
      paneles.forEach((panel) => {
        panel.hidden = panel.dataset.whatsappReport !== reporte;
      });
      window.requestAnimationFrame(() => {
        Object.values(graficasWhatsapp).forEach((grafica) => grafica?.resize());
      });
    };

    pestanas.forEach((pestana) => {
      pestana.addEventListener('click', () => mostrar(pestana.dataset.whatsappReportTab));
      pestana.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
        event.preventDefault();
        const indice = pestanas.indexOf(pestana);
        const desplazamiento = event.key === 'ArrowRight' ? 1 : -1;
        const siguiente = pestanas[(indice + desplazamiento + pestanas.length) % pestanas.length];
        mostrar(siguiente.dataset.whatsappReportTab);
        siguiente.focus();
      });
    });
    mostrar(reporteWhatsappActivo);
  }

  function barras(canvas, filas, color, horizontal = false) {
    return new Chart(canvas, {
      type: 'bar',
      data: {
        labels: filas.map((fila) => fila.nombre ?? fila.etiqueta),
        datasets: [{ label: 'Mensajes', data: filas.map((fila) => fila.total), backgroundColor: color }],
      },
      options: {
        indexAxis: horizontal ? 'y' : 'x',
        responsive: true,
        plugins: { legend: { display: false } },
        scales: horizontal
          ? { x: { beginAtZero: true, ticks: { precision: 0 } } }
          : { y: { beginAtZero: true, ticks: { precision: 0 } } },
      },
    });
  }

  function construirGraficasWhatsapp() {
    destruirGraficasWhatsapp();
    configurarReportesWhatsapp();
    const dataEl = document.getElementById('metricasWhatsappData');
    if (!dataEl) return;
    const datos = JSON.parse(dataEl.textContent);

    const tendencia = document.getElementById('whatsappChartTendencia');
    if (tendencia) graficasWhatsapp.tendencia = new Chart(tendencia, {
      type: 'line',
      data: { labels: datos.tendencia.map((fila) => fila.etiqueta), datasets: [{ label: 'Mensajes', data: datos.tendencia.map((fila) => fila.total), borderColor: '#2E5090', backgroundColor: '#E8ECF5', fill: true, tension: 0.3 }] },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } },
    });

    const resultados = document.getElementById('whatsappChartResultados');
    if (resultados) graficasWhatsapp.resultados = new Chart(resultados, {
      type: 'doughnut',
      data: { labels: datos.resultadoEnvios.map((fila) => fila.etiqueta), datasets: [{ data: datos.resultadoEnvios.map((fila) => fila.total), backgroundColor: ['#1E8E3E', '#C53929'] }] },
      options: { responsive: true },
    });

    const configuraciones = [
      ['whatsappChartPlantillas', 'plantillas', datos.mensajesPorPlantilla, '#2E5090', false],
      ['whatsappChartErrores', 'errores', datos.erroresFrecuentes, '#C53929', true],
      ['whatsappChartDiaSemana', 'diaSemana', datos.porDiaSemana, '#1E8E3E', false],
      ['whatsappChartHora', 'hora', datos.porHora, '#7356A8', false],
      ['whatsappChartPlantillasFallos', 'plantillasFallos', datos.plantillasConFallos, '#F5A623', true],
    ];
    configuraciones.forEach(([id, clave, filas, color, horizontal]) => {
      const canvas = document.getElementById(id);
      if (canvas) graficasWhatsapp[clave] = barras(canvas, filas, color, horizontal);
    });

    const tasa = document.getElementById('whatsappChartTasa');
    if (tasa) graficasWhatsapp.tasa = new Chart(tasa, {
      type: 'line',
      data: { labels: datos.tendencia.map((fila) => fila.etiqueta), datasets: [{ label: 'Tasa de éxito', data: datos.tendencia.map((fila) => fila.tasaExito), borderColor: '#1E8E3E', backgroundColor: '#DDEFE2', fill: true, tension: 0.3 }] },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, max: 100, ticks: { callback: (valor) => `${valor}%` } } } },
    });

    const mapa = document.getElementById('whatsappMapaCalor');
    const tarjetaMapa = mapa?.closest('.metricas-chart-card');
    const botonesMapa = document.querySelectorAll('[data-whatsapp-mapa]');
    function renderMapa(tipo) {
      if (!mapa) return;
      mapa.replaceChildren();
      tarjetaMapa?.classList.toggle('metricas-heatmap-errors', tipo === 'errores');
      const maximo = Math.max(0, ...datos.mapaCalor.flatMap((dia) => dia[tipo]));
      const agregar = (clase, texto) => {
        const celda = document.createElement('span');
        celda.className = clase;
        celda.textContent = texto;
        mapa.appendChild(celda);
        return celda;
      };
      agregar('metricas-heatmap-corner', 'Día / hora');
      Array.from({ length: 24 }, (_, hora) => agregar('metricas-heatmap-hour', String(hora).padStart(2, '0')));
      datos.mapaCalor.forEach((dia) => {
        agregar('metricas-heatmap-day', dia.etiqueta);
        dia[tipo].forEach((total, hora) => {
          const nivel = total === 0 || maximo === 0 ? 0 : Math.max(1, Math.ceil((total / maximo) * 5));
          const celda = agregar(`metricas-heatmap-cell metricas-heatmap-level-${nivel}`, total ? String(total) : '');
          const concepto = tipo === 'errores' ? 'fallos' : 'mensajes';
          celda.title = `${dia.etiqueta}, ${String(hora).padStart(2, '0')}:00: ${total} ${concepto}`;
        });
      });
      mapa.setAttribute('aria-label', tipo === 'errores' ? 'Mapa de calor de errores por día y hora' : 'Mapa de calor de mensajes enviados por día y hora');
      botonesMapa.forEach((boton) => boton.classList.toggle('active', boton.dataset.whatsappMapa === tipo));
    }
    botonesMapa.forEach((boton) => boton.addEventListener('click', () => renderMapa(boton.dataset.whatsappMapa)));
    renderMapa('enviados');

    const conversacional = datos.conversacional;
    if (!conversacional) return;

    const tendenciaConversacional = document.getElementById('whatsappConversacionalTendencia');
    if (tendenciaConversacional) graficasWhatsapp.conversacionalTendencia = new Chart(tendenciaConversacional, {
      type: 'line',
      data: {
        labels: conversacional.tendencia.map((fila) => fila.etiqueta),
        datasets: [
          { label: 'Entrantes únicos', data: conversacional.tendencia.map((fila) => fila.mensajes), borderColor: '#2E5090', tension: 0.3 },
          { label: 'Grupos', data: conversacional.tendencia.map((fila) => fila.grupos), borderColor: '#7356A8', tension: 0.3 },
          { label: 'Respuestas aceptadas', data: conversacional.tendencia.map((fila) => fila.respuestas), borderColor: '#1E8E3E', tension: 0.3 },
        ],
      },
      options: { responsive: true, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } },
    });

    const agrupacionConversacional = document.getElementById('whatsappConversacionalAgrupacion');
    if (agrupacionConversacional) graficasWhatsapp.conversacionalAgrupacion = barras(
      agrupacionConversacional,
      conversacional.agrupacion.distribucion,
      '#7356A8',
    );
    const rutasConversacionales = document.getElementById('whatsappConversacionalRutas');
    if (rutasConversacionales) graficasWhatsapp.conversacionalRutas = barras(
      rutasConversacionales,
      conversacional.rutas,
      '#2E5090',
      true,
    );
    const claudeConversacional = document.getElementById('whatsappConversacionalClaude');
    if (claudeConversacional) graficasWhatsapp.conversacionalClaude = barras(
      claudeConversacional,
      conversacional.claude.resultados,
      '#7356A8',
    );
    const atencionConversacional = document.getElementById('whatsappConversacionalAtencion');
    if (atencionConversacional) graficasWhatsapp.conversacionalAtencion = barras(
      atencionConversacional,
      conversacional.atencion.transferencias,
      '#C53929',
    );

    const mapaConversacional = document.getElementById('whatsappConversacionalMapaCalor');
    const botonesMapaConversacional = document.querySelectorAll('[data-whatsapp-conversacional-mapa]');
    function renderMapaConversacional(tipo) {
      if (!mapaConversacional) return;
      mapaConversacional.replaceChildren();
      const maximo = Math.max(0, ...conversacional.mapaCalor.flatMap((dia) => dia[tipo]));
      const agregar = (clase, texto) => {
        const celda = document.createElement('span');
        celda.className = clase;
        celda.textContent = texto;
        mapaConversacional.appendChild(celda);
        return celda;
      };
      agregar('metricas-heatmap-corner', 'Día / hora');
      Array.from({ length: 24 }, (_, hora) => agregar('metricas-heatmap-hour', String(hora).padStart(2, '0')));
      conversacional.mapaCalor.forEach((dia) => {
        agregar('metricas-heatmap-day', dia.etiqueta);
        dia[tipo].forEach((total, hora) => {
          const nivel = total === 0 || maximo === 0 ? 0 : Math.max(1, Math.ceil((total / maximo) * 5));
          const celda = agregar(`metricas-heatmap-cell metricas-heatmap-level-${nivel}`, total ? String(total) : '');
          celda.title = `${dia.etiqueta}, ${String(hora).padStart(2, '0')}:00: ${total}`;
        });
      });
      botonesMapaConversacional.forEach((boton) => boton.classList.toggle('active', boton.dataset.whatsappConversacionalMapa === tipo));
    }
    botonesMapaConversacional.forEach((boton) => boton.addEventListener('click', () => renderMapaConversacional(boton.dataset.whatsappConversacionalMapa)));
    renderMapaConversacional('total');
  }

  construirGraficasWhatsapp();
  document.body.addEventListener('htmx:afterSwap', (event) => {
    if (event.detail.target === whatsappPanel) construirGraficasWhatsapp();
  });
</script>
</body>
</html>
