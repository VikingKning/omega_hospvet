<%
// US-613: mismo formulario para alta y edición — el modo se decide por si
// `plantilla` viene o no (edición trae el registro completo, alta viene
// null). Este partial se usa tanto para el primer render (GET
// /plantillas/nuevo o GET /plantillas/:id/editar) como para el re-render
// con error (POST/PUT fallidos, ver plantillas_whatsapp.controller.js) —
// por eso intencion/texto_respuesta viajan aparte de `plantilla`: en un
// re-render por error es lo que el usuario acababa de escribir, no
// necesariamente lo que ya está guardado.
const esEdicion = Boolean(plantilla);
%>
<div class="modal-header">
  <h2><%= esEdicion ? 'Editar plantilla' : 'Nueva plantilla' %></h2>
  <button class="modal-close-btn" type="button" id="plantillaFormClose" aria-label="Cerrar">&times;</button>
</div>

<% if (error) { %>
  <div class="form-error-banner">
    <span><%= error %></span>
    <button type="button" class="modal-close-btn" id="plantillaFormErrorDismiss" aria-label="Cerrar mensaje">&times;</button>
  </div>
<% } %>

<form class="modal-form"
      hx-<%= esEdicion ? 'put' : 'post' %>="<%= esEdicion ? `plantillas/${plantilla.id}` : 'plantillas' %>"
      hx-target="#plantillaFormModalBody" hx-swap="innerHTML"
      hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'>
  <%
    // Intención (y su slug derivado) son inmutables tras el alta —
    // decisión explícita del usuario: son la identidad con la que un LLM
    // matcheará esta plantilla más adelante, y con la que
    // mensajes_whatsapp.plantilla_id enlaza el histórico. Editar el
    // significado bajo el mismo id reinterpretaría en silencio mensajes ya
    // enviados. Por eso en edición se muestran de solo lectura (sin
    // `name`, para que ni siquiera viajen en el submit — mismo criterio
    // que el slug de área en area-form.ejs) y solo se puede tocar el
    // texto de respuesta. Para "cambiar la intención" hay que dar de baja
    // esta plantilla (switch de abajo) y crear una nueva.
  %>
  <% if (esEdicion) { %>
    <label>
      Intención
      <input type="text" value="<%= intencion %>" readonly disabled>
    </label>
    <label>
      Slug (para el LLM)
      <input type="text" value="<%= slug %>" readonly disabled>
    </label>
  <% } else { %>
    <label>
      Intención
      <input type="text" name="intencion" value="<%= intencion %>" required maxlength="100" autofocus>
    </label>
  <% } %>
  <label>
    Texto de respuesta
    <textarea name="texto_respuesta" rows="4" required <%= esEdicion ? 'autofocus' : '' %>><%= texto_respuesta %></textarea>
  </label>
  <%
    // Switch Activo/Inactivo: solo en edición, a petición explícita (no
    // estaba en el AC original de la historia). En alta no tiene sentido
    // mostrarlo — el AC exige activo=true siempre para un registro nuevo.
    // Una plantilla predeterminada del sistema (es_predeterminada) NUNCA
    // lo muestra — pedido explícito del usuario: son inborrables, solo
    // editables (el texto), siempre quedan activas. La defensa real vive
    // en el servidor (plantillas_whatsapp.service.js#editar), esto es
    // solo para no ofrecer un control que de todos modos se ignoraría.
  %>
  <% if (esEdicion && plantilla.es_predeterminada) { %>
    <p class="tutor-form-hint">Esta es una plantilla predeterminada del sistema — siempre permanece activa, solo se puede editar el texto de respuesta.</p>
  <% } else if (esEdicion) { %>
    <label class="switch-field">
      <span class="switch">
        <input type="checkbox" name="activo" value="true" <%= activo ? 'checked' : '' %>>
        <span class="switch-track"></span>
      </span>
      <span class="switch-state-on">Activo</span>
      <span class="switch-state-off">Inactivo</span>
    </label>
  <% } %>
  <div class="modal-actions">
    <button type="button" class="btn-secondary" id="plantillaFormCancel">Cancelar</button>
    <button type="submit" class="btn-primary">Guardar</button>
  </div>
</form>
