<%
const esEdicion = Boolean(plantilla);
%>
<div class="modal-header">
  <h2><%= esEdicion ? 'Editar plantilla' : 'Nueva plantilla' %></h2>
  <button class="modal-close-btn" type="button" id="plantillaFormClose" aria-label="Cerrar">&times;</button>
</div>

<% if (error) { %>
  <div class="form-error-banner">
    <span><%= error %></span>
    <button type="button" class="modal-close-btn" id="plantillaFormErrorDismiss" aria-label="Cerrar mensaje">&times;</button>
  </div>
<% } %>

<form class="modal-form"
      hx-<%= esEdicion ? 'put' : 'post' %>="<%= esEdicion ? `plantillas/${plantilla.id}` : 'plantillas' %>"
      hx-target="#plantillaFormModalBody" hx-swap="innerHTML"
      hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'>

  <% if (esEdicion) { %>
    <div class="profile-form-row">
      <label>
        Intención
        <input type="text" value="<%= intencion %>" readonly disabled>
      </label>
      <label>
        Slug (para el LLM)
        <input type="text" value="<%= slug %>" readonly disabled>
      </label>
    </div>
  <% } else { %>
    <label>
      Intención
      <input type="text" name="intencion" value="<%= intencion %>" required maxlength="100" autofocus>
    </label>
  <% } %>
  
  <div class="plantilla-texto-field">
    <label for="plantillaTextoEditor">Texto de respuesta</label>
    <div class="plantilla-formato-toolbar" role="toolbar" aria-label="Formato de texto de WhatsApp">
      <button type="button" class="plantilla-formato-btn" data-formato="negrita" aria-label="Negrita" data-tooltip="Negrita (*texto*)"><strong>B</strong></button>
      <button type="button" class="plantilla-formato-btn" data-formato="cursiva" aria-label="Cursiva" data-tooltip="Cursiva (_texto_)"><em>I</em></button>
      <button type="button" class="plantilla-formato-btn" data-formato="tachado" aria-label="Tachado" data-tooltip="Tachado (~texto~)"><s>S</s></button>
      <span class="plantilla-formato-toolbar-sep" aria-hidden="true"></span>
      <button type="button" class="plantilla-formato-btn plantilla-formato-btn-mono" data-formato="monoespaciado" aria-label="Monoespaciado" data-tooltip="Monoespaciado (```texto```)"><strong>M</strong></button>
      <button type="button" class="plantilla-formato-btn" data-formato="cita" aria-label="Cita" data-tooltip="Cita (&gt; texto)">Cita</button>
      <span class="plantilla-formato-toolbar-sep" aria-hidden="true"></span>
      <button type="button" class="plantilla-formato-btn plantilla-formato-btn-mono" data-formato="lista" aria-label="Lista con viñetas" data-tooltip="Lista con viñetas (- item)">•</button>
      <button type="button" class="plantilla-formato-btn plantilla-formato-btn-mono" data-formato="numerada" aria-label="Lista numerada" data-tooltip="Lista numerada (1. item)">1.</button>
      <span class="plantilla-formato-toolbar-sep" aria-hidden="true"></span>
      <div class="plantilla-emoji-picker">
        <button type="button" class="plantilla-formato-btn" id="plantillaEmojiToggle" aria-label="Insertar emoticono" aria-expanded="false" data-tooltip="Insertar emoticono">🙂</button>
        <div class="plantilla-emoji-panel" id="plantillaEmojiPanel" hidden>
        <%
          ['👋','🙏','👍','👏','🙌','😊','😀','😉','🥲','😢','❤️','💙','🐾','🐶','🐱','🐰','🐹','🦴','🩺','💊','💉','🌡️','🏥','👨‍⚕️','👩‍⚕️','🚑','📅','⏰','⏳','📍','📞','📱','✉️','📄','📎','✅','☑️','❌','⚠️','🚫','❗','❓','⭐','🔔','🔥','💡','🎉'].forEach((emoji) => {
        %>
            <button type="button" class="plantilla-emoji-btn" aria-label="Insertar <%= emoji %>" data-emoji="<%= emoji %>"><%= emoji %></button>
        <% }) %>
        </div>
      </div>
    </div>
    <div class="plantilla-texto-editor" id="plantillaTextoEditor" contenteditable="true" role="textbox" aria-multiline="true" aria-required="true" aria-label="Texto de respuesta" data-placeholder="Escribe la respuesta que verá el tutor…"></div>
    <div class="plantilla-editor-meta">
      <p class="plantilla-editor-error" id="plantillaEditorError" hidden>Escribe el texto de respuesta.</p>
      <span class="plantilla-editor-counter" id="plantillaEditorCounter" aria-live="polite">550 caracteres disponibles</span>
    </div>
    <textarea name="texto_respuesta" id="plantillaTextoRespuesta" hidden><%= texto_respuesta %></textarea>
  </div>
  <label>
    Tipo de Respuesta 
    <div class="toggle-group" id="plantillaEmergenciaToggle">
      <button type="button" class="toggle-btn<%= es_emergencia ? '' : ' active' %>" data-value="false">Informativa</button>
      <button type="button" class="toggle-btn<%= es_emergencia ? ' active' : '' %>" data-value="true">Emergencia</button>
    </div>
  </label>
  <input type="hidden" name="es_emergencia" id="plantillaEmergenciaInput" value="<%= es_emergencia ? 'true' : 'false' %>">
  
  <% if (esEdicion && plantilla.es_predeterminada) { %>
    <p class="tutor-form-hint">Esta es una plantilla predeterminada del sistema — siempre permanece activa, solo se puede editar el texto de respuesta.</p>
  <% } else if (esEdicion) { %>
    <label class="switch-field">
      Estado
      <span class="switch">
        <input type="checkbox" name="activo" value="true" <%= activo ? 'checked' : '' %>>
        <span class="switch-track"></span>
      </span>
      <span class="switch-state-on">Activo</span>
      <span class="switch-state-off">Inactivo</span>
    </label>
  <% } %>
  <div class="modal-actions">
    <button type="button" class="btn-secondary" id="plantillaFormCancel">Cancelar</button>
    <button type="submit" class="btn-primary">Guardar</button>
  </div>
</form>
