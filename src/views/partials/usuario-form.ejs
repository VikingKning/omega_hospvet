<%
const esEdicion = Boolean(usuario);
const esSoloLectura = Boolean(soloLectura);
const ESTATUS_LABELS = {
  activo: 'Activo',
  bloqueo_temp: 'Bloqueo temporal',
  bloqueado: 'Bloqueado',
  inactivo: 'Inactivo',
  cambio_pwd: 'Cambio de contraseña pendiente',
};

const permissions = user?.permissions ?? [];
const puedeGestionarPermisos = permissions.includes('usuarios.permisos');
const permisosAsignadosSet = new Set(permisosAsignadosIds);
const estaVinculadoADoctor = Boolean(doctorSeleccionado);
const esAdmin = tipoUsuario === 'admin';
const tipoUsuarioEfectivo = esAdmin
  ? 'admin'
  : estaVinculadoADoctor
    ? 'doctor'
    : tipoUsuario || 'usuario';
const TIPOS_USUARIO = [
  { valor: 'doctor', etiqueta: 'Doctor' },
  { valor: 'estilista', etiqueta: 'Estilista' },
  { valor: 'recepcion', etiqueta: 'Recepción' },
  { valor: 'usuario', etiqueta: 'Usuario' },
];

const MODULO_LABELS = {
  tutores: 'Tutores y pacientes',
  laboratorio: 'Laboratorio',
  usuarios: 'Gestión de usuarios',
  doctores: 'Catálogo de doctores',
  areas: 'Catálogo de áreas',
  plantillas: 'Plantillas de WhatsApp',
  configuracion: 'Configuración General',
  metricas_whatsapp: 'WhatsApp',
  metricas_laboratorio: 'Laboratorios',
  metricas_agenda: 'Agenda',
};
const ACCION_LABELS = {
  ver: 'Ver',
  crear: 'Crear',
  editar: 'Editar',
  confirmar: 'Confirmar',
  cancelar: 'Cancelar',
  eliminar: 'Eliminar',
  carga_envio: 'Carga y envío',
  exportar: 'Exportar',
};
function etiqueta(mapa, valor) {
  return mapa[valor] ?? `${valor.charAt(0).toUpperCase()}${valor.slice(1).replace(/_/g, ' ')}`;
}

function estaMarcado(permiso) {
  return String(permiso.id)
    .split(',')
    .map(Number)
    .every((id) => permisosAsignadosSet.has(id));
}
%>
<div class="modal-header">
  <h2><%= esSoloLectura ? 'Usuario' : (esEdicion ? 'Editar usuario' : 'Nuevo usuario') %></h2>
  <button class="modal-close-btn" type="button" id="usuarioFormClose" aria-label="Cerrar">&times;</button>
</div>

<% if (error) { %>
  <div class="form-error-banner">
    <span><%= error %></span>
    <button type="button" class="modal-close-btn" id="usuarioFormErrorDismiss" aria-label="Cerrar mensaje">&times;</button>
  </div>
<% } %>

<form class="modal-form modal-form-columns usuario-form"
      <% if (!esSoloLectura) { %>
      hx-<%= esEdicion ? 'put' : 'post' %>="<%= esEdicion ? `usuarios/${usuario.id}` : 'usuarios' %>"
      hx-target="#usuarioFormModalBody" hx-swap="innerHTML"
      hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'
      <% } %>
      data-es-edicion="<%= esEdicion ? '1' : '' %>">
  <div class="modal-col modal-col-datos">
    <h3 class="modal-col-title">Datos generales</h3>
    <label>
      Doctor vinculado
      <% if (esEdicion) { %>

        <input type="text" value="<%= doctorSeleccionado ? `${doctorSeleccionado.nombre} ${doctorSeleccionado.apellidos}` : 'Sin vínculo' %>" readonly>
      <% } else { %>
        <div class="combobox" id="doctorCombobox">
          <input type="text" id="doctorSearch" placeholder="Buscar doctor..." autocomplete="off"
                 value="<%= doctorSeleccionado ? `${doctorSeleccionado.nombre} ${doctorSeleccionado.apellidos}` : '' %>">
          <input type="hidden" name="doctorId" id="doctorIdInput" value="<%= doctorSeleccionado ? doctorSeleccionado.id : '' %>">
          <ul class="combobox-list" id="doctorList" hidden></ul>
        </div>
      <% } %>
    </label>
    <label>
      Nombre(s)
      <input type="text" name="nombre" id="nombreInput" value="<%= nombre %>" required maxlength="100"
             <%= esSoloLectura ? 'readonly disabled' : 'autofocus' %>>
    </label>
    <label>
      Apellidos
      <input type="text" name="apellidos" id="apellidosInput" value="<%= apellidos %>" required maxlength="100" <%= esSoloLectura ? 'readonly disabled' : '' %>>
    </label>
    <label>
      Correo
      <input type="email" name="correo" value="<%= correo %>" required maxlength="150" <%= esSoloLectura ? 'readonly disabled' : '' %>>
    </label>
    <label>
      Teléfono
      <input type="text" name="telefono" id="telefonoInput" value="<%= telefono %>"
             placeholder="Ej. 5512345678" inputmode="numeric" autocomplete="off"
             pattern="(\d{2}-\d{4}-\d{4}|\d{3}-\d{3}-\d{4})" maxlength="12"
             title="Formato de teléfono en México: 10 dígitos (NN-NNNN-NNNN si inicia con 55/56, NNN-NNN-NNNN en otro caso)"
             <%= esSoloLectura ? 'readonly disabled' : '' %>>
    </label>
    <label>
      Username
      <input type="text" name="username" id="usernameInput" value="<%= username %>" required maxlength="50" autocomplete="off" <%= esSoloLectura ? 'readonly disabled' : '' %>>
    </label>
    <% if (!esEdicion) { %>
      <label>
        Contraseña inicial

        <div class="input-wrap password-field-wrap">
          <input type="password" name="password" id="passwordInput" required minlength="15" maxlength="72"
                 title="La contraseña debe tener al menos 15 caracteres. Puedes utilizar letras, números, símbolos y espacios."
                 autocomplete="new-password">
          <button type="button" class="toggle-pass" id="passwordToggle" aria-label="Mostrar contraseña">
            <svg id="passwordEyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </label>
    <% } %>
    <% if (esEdicion) { %>
      <label>
        Estatus

        <div class="combobox" id="estatusCombobox">
          <input type="text" id="estatusTrigger" class="select-trigger-input" value="<%= ESTATUS_LABELS[estatus] %>" readonly autocomplete="off" <%= esSoloLectura ? 'disabled' : '' %>>
          <input type="hidden" name="estatus" id="estatusInput" value="<%= estatus %>">
          <ul class="combobox-list" id="estatusList" hidden>
            <% ['activo', 'bloqueo_temp', 'bloqueado', 'inactivo'].forEach((valor) => { %>
              <li class="combobox-item" data-value="<%= valor %>"><%= ESTATUS_LABELS[valor] %></li>
            <% }) %>
          </ul>
        </div>
      </label>
    <% } %>
  </div>

  <div class="modal-col modal-col-permisos">
    <div class="usuario-config-row">
      <div class="usuario-config-field">
        <span class="usuario-config-label">Tipo de usuario</span>
        <input type="hidden" name="tipoUsuario" id="tipoUsuarioInput" value="<%= tipoUsuarioEfectivo %>">
        <% if (esAdmin) { %>
          <span class="badge badge-admin">Administrador</span>
        <% } else { %>
          <div class="toggle-group tipo-usuario-toggle" id="tipoUsuarioToggle" role="group"
               aria-label="Tipo de usuario" data-solo-lectura="<%= esSoloLectura ? '1' : '0' %>">
            <% TIPOS_USUARIO.forEach((tipo) => { %>
              <% const deshabilitado = esSoloLectura || estaVinculadoADoctor; %>
              <button type="button"
                      class="toggle-btn<%= tipoUsuarioEfectivo === tipo.valor ? ' active' : '' %>"
                      data-tipo-usuario="<%= tipo.valor %>"
                      aria-pressed="<%= tipoUsuarioEfectivo === tipo.valor ? 'true' : 'false' %>"
                      <%= deshabilitado ? 'disabled' : '' %>><%= tipo.etiqueta %></button>
            <% }) %>
          </div>
          <% if (estaVinculadoADoctor) { %>
            <small class="usuario-config-help">Se asigna automáticamente por el vínculo con el doctor.</small>
          <% } %>
        <% } %>
      </div>

      <div class="usuario-config-field usuario-alertas-field">
        <span class="usuario-config-label">Notificación de alertas</span>
        <label class="switch-field">
          <span class="switch">
            <input type="checkbox" name="notificacionesAlertas" value="true"
                   <%= notificacionesAlertas ? 'checked' : '' %> <%= esSoloLectura ? 'disabled' : '' %>>
            <span class="switch-track"></span>
          </span>
          <span class="switch-state-on">Activo</span>
          <span class="switch-state-off">Inactivo</span>
        </label>
      </div>
    </div>

    <% if (puedeGestionarPermisos) { %>
      <h3 class="modal-col-title">Permisos</h3>

      <input type="hidden" name="permisosSeccion" value="1">

      <% matrizPermisos.tabs.forEach((tab, i) => { %>
        <input type="radio" name="permisosTabUI" id="permisosTab-<%= tab.id %>" class="permisos-tab-radio"
               <%= i === 0 ? 'checked' : '' %> hidden>
      <% }) %>
      <div class="permisos-tabs">
        <% matrizPermisos.tabs.forEach((tab) => { %>
          <label for="permisosTab-<%= tab.id %>" class="permisos-tab-label permisos-tab-label-<%= tab.id %>"><%= tab.titulo %></label>
        <% }) %>
      </div>
      <% matrizPermisos.tabs.forEach((tab) => { %>
        <div class="permisos-tab-panel permisos-tab-panel-<%= tab.id %>">
          <div class="permisos-matrix-wrap">
            <table class="permisos-matrix">
              <thead>
                <tr>
                  <th>Módulo</th>

                  <th>Todos</th>
                  <% tab.acciones.forEach((accion) => { %>
                    <th><%= etiqueta(ACCION_LABELS, accion) %></th>
                  <% }) %>
                </tr>
              </thead>
              <tbody>
                <% tab.secciones.forEach((seccion) => { %>
                  <% if (seccion.titulo) { %>
                    <tr class="permisos-seccion-row">
                      <td colspan="<%= 2 + tab.acciones.length %>"><%= seccion.titulo %></td>
                    </tr>
                  <% } %>
                  <% seccion.modulos.forEach((fila) => { %>
                    <tr>


                      <% const filaCompleta = fila.celdas.every((permiso) => !permiso || estaMarcado(permiso)); %>
                      <td><%= fila.nombre ?? etiqueta(MODULO_LABELS, fila.modulo) %></td>
                      <td class="permiso-cell">
                        <input type="checkbox" class="permiso-todos-checkbox"
                               aria-label="Otorgar todos los permisos de <%= fila.nombre ?? etiqueta(MODULO_LABELS, fila.modulo) %>"
                               title="Marca o desmarca todas las acciones de esta fila"
                               <%= filaCompleta ? 'checked' : '' %> <%= esSoloLectura ? 'disabled' : '' %>>
                      </td>
                      <% fila.celdas.forEach((permiso, celdaIndex) => { %>
                        <td class="permiso-cell">
                          <% if (permiso) { %>

                            <input type="checkbox" name="permisos" value="<%= permiso.id %>"
                                   title="<%= permiso.descripcion ?? '' %>"
                                   data-accion="<%= tab.acciones[celdaIndex] %>"
                                   <%= estaMarcado(permiso) ? 'checked' : '' %> <%= esSoloLectura ? 'disabled' : '' %>>
                          <% } %>
                        </td>
                      <% }) %>
                    </tr>
                  <% }) %>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="modal-actions">
    <% if (esSoloLectura) { %>
      <button type="button" class="btn-secondary" id="usuarioFormCancel">Cerrar</button>
    <% } else { %>
      <button type="button" class="btn-secondary" id="usuarioFormCancel">Cancelar</button>
      <button type="submit" class="btn-primary">Guardar</button>
    <% } %>
  </div>
</form>


<%# Datos inertes: HTMX no ejecuta etiquetas script recibidas en fragmentos. %>
<div id="usuarioFormDoctoresData" hidden><%- JSON.stringify(doctoresDisponibles).replace(/</g, String.fromCharCode(92,117,48,48,51,99)) %></div>
