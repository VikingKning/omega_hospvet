<%
// US-607: mismo formulario para alta y edición — el modo se decide por si
// `doctor` viene o no (edición trae el registro completo, alta viene
// null). Este partial se usa tanto para el primer render (GET
// /doctores/nuevo o GET /doctores/:id/editar) como para el re-render con
// error (POST/PUT fallidos, ver doctores.controller.js) — por eso
// nombre/apellidos/activo viajan aparte de `doctor`: en un re-render por
// error son lo que el usuario acababa de escribir, no necesariamente lo
// que ya está guardado.
const esEdicion = Boolean(doctor);
%>
<div class="modal-header">
  <h2><%= esEdicion ? 'Editar doctor' : 'Nuevo doctor' %></h2>
  <button class="modal-close-btn" type="button" id="doctorFormClose" aria-label="Cerrar">&times;</button>
</div>

<% if (error) { %>
  <div class="form-error-banner">
    <span><%= error %></span>
    <button type="button" class="modal-close-btn" id="doctorFormErrorDismiss" aria-label="Cerrar mensaje">&times;</button>
  </div>
<% } %>

<form class="modal-form"
      hx-<%= esEdicion ? 'put' : 'post' %>="<%= esEdicion ? `doctores/${doctor.id}` : 'doctores' %>"
      hx-target="#doctorFormModalBody" hx-swap="innerHTML"
      hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'>
  <label>
    Nombre(s)
    <input type="text" name="nombre" value="<%= nombre %>" required maxlength="100" autofocus>
  </label>
  <label>
    Apellidos
    <input type="text" name="apellidos" value="<%= apellidos %>" required maxlength="100">
  </label>
  <%
  // Pedido de estilo: mismo switch ya usado en plantilla-form.ejs (US-613)
  // en vez de un checkbox — reusa las clases .switch-field/.switch/
  // .switch-track ya definidas en main.css, sin CSS nuevo. A diferencia de
  // plantillas (donde el switch solo aparece en edición, porque el alta
  // siempre crea activo=true), en doctores ya se mostraba en alta también
  // — se mantiene ese comportamiento, solo cambia el control visual.
  %>
  <label class="switch-field">
    <span class="switch">
      <input type="checkbox" name="activo" value="true" <%= activo ? 'checked' : '' %>>
      <span class="switch-track"></span>
    </span>
    <span class="switch-state-on">Activo</span>
    <span class="switch-state-off">Inactivo</span>
  </label>

  <label>
    Especialidades
    <%
    // US-607 (segunda iteración, pedido de estilo): mismo motivo que el
    // filtro "Estatus" de usuarios-panel.ejs — un <select> nativo no puede
    // tener su lista abierta con esquinas redondeadas. Se reemplaza por un
    // combobox propio (trigger de solo lectura + <ul class="combobox-list">
    // ya poblada por JS, ver doctores.ejs#renderAreaPicker). El input
    // oculto es lo único que lee #areaPickerAdd; ninguno de los dos lleva
    // `name` — nunca se someten directamente, doctorAreasBody es quien
    // arma los `name="areaIds"` reales al agregar.
    %>
    <div class="area-picker-row">
      <div class="combobox" id="areaPickerCombobox">
        <input type="text" id="areaPickerTrigger" class="select-trigger-input" readonly autocomplete="off" placeholder="Selecciona un área...">
        <input type="hidden" id="areaPickerValue">
        <ul class="combobox-list" id="areaPickerList" hidden></ul>
      </div>
      <button type="button" class="btn-secondary" id="areaPickerAdd">Agregar</button>
    </div>
  </label>

  <div class="mini-table-wrap">
    <table class="mini-table">
      <thead>
        <tr><th>Área</th><th>Quitar</th></tr>
      </thead>
      <tbody id="doctorAreasBody"></tbody>
    </table>
    <p class="mini-table-empty" id="doctorAreasEmpty">Sin especialidades asignadas.</p>
  </div>

  <div class="modal-actions">
    <button type="button" class="btn-secondary" id="doctorFormCancel">Cancelar</button>
    <button type="submit" class="btn-primary">Guardar</button>
  </div>
</form>

<%
// Datos para el picker de especialidades (JS de doctores.ejs): una isla de
// datos inerte. NO puede ser un <script> (ni con type="application/json"):
// con allowScriptTags:false en la config de HTMX (SEC-002), HTMX elimina
// TODO <script> del contenido swapeado antes de insertarlo
// (querySelectorAll('script') no distingue por `type`) — confirmado en
// vivo que esto dejaba el picker de Especialidades siempre vacío. Un
// <div hidden> no es un <script>, ni HTMX ni el CSP (que solo rige
// script-src) lo tocan. El JS que la lee vive en el <script> persistente
// de doctores.ejs, delegado sobre #doctorFormModalBody. El caracter
// "menor que" del JSON se re-escapa a su forma unicode (sigue siendo JSON
// válido) para que un nombre de área con `<`/`</div>` nunca pueda cerrar
// el div de forma anticipada.
%>
<div id="doctorFormAreasData" hidden><%- JSON.stringify({
  disponibles: areasDisponibles,
  seleccionadas: areasSeleccionadas,
}).replace(/</g, String.fromCharCode(92,117,48,48,51,99)) %></div>
