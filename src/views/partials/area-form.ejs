<%
const esEdicion = Boolean(area);
const esPredeterminada = Boolean(area?.es_predeterminada);
const esSoloLectura = Boolean(soloLectura);
const nombreBloqueado = esSoloLectura || esPredeterminada;

const selectedColorId = color === null || color === undefined ? '' : String(color);
const selectedColorObj = colores.find((c) => c.id === selectedColorId) ?? null;
%>
<div class="modal-header">
  <h2><%= esSoloLectura ? 'Área del sistema' : (esEdicion ? 'Editar área' : 'Nueva área') %></h2>
  <button class="modal-close-btn" type="button" id="areaFormClose" aria-label="Cerrar">&times;</button>
</div>

<% if (esSoloLectura) { %>
  <div class="form-info-banner">
    <span>Esta es un área predeterminada del sistema — no se puede editar ni eliminar, solo activar o desactivar.</span>
  </div>
<% } else if (esPredeterminada) { %>
  <div class="form-info-banner">
    <span>Esta es un área predeterminada del sistema — solo puedes cambiar su color en Google Calendar.</span>
  </div>
<% } %>

<% if (error) { %>
  <div class="form-error-banner">
    <span><%= error %></span>
    <button type="button" class="modal-close-btn" id="areaFormErrorDismiss" aria-label="Cerrar mensaje">&times;</button>
  </div>
<% } %>

<form class="modal-form"
      <% if (!esSoloLectura) { %>
      hx-<%= esEdicion ? 'put' : 'post' %>="<%= esEdicion ? `areas/${area.id}` : 'areas' %>"
      hx-target="#areaFormModalBody" hx-swap="innerHTML"
      hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'
      <% } %>>
  <label>
    Nombre
    <input type="text" name="nombre" value="<%= nombre %>" required maxlength="100"
           <%= nombreBloqueado ? 'readonly' : '' %> <%= esSoloLectura ? 'disabled' : '' %>
           <%= nombreBloqueado ? '' : 'autofocus' %>>
  </label>
  <% if (esEdicion) { %>
    <label>
      Slug
      <input type="text" value="<%= area.slug %>" readonly disabled>
    </label>
  <% } %>
  <div class="color-field">
    <span class="color-field-label">Color en Google Calendar</span>
    <div class="color-swatch-picker" role="radiogroup" aria-label="Color en Google Calendar" id="areaColorPicker">
      <% colores.forEach((c) => { %>
        <button type="button"
                class="color-swatch-option<%= selectedColorId === c.id ? ' selected' : '' %>"
                data-color-id="<%= c.id %>" data-hex="<%= c.hex %>"
                role="radio" aria-checked="<%= selectedColorId === c.id %>" <%= esSoloLectura ? 'disabled' : '' %>>
          <span class="color-swatch-box" style="--swatch-color: <%= c.hex %>;" aria-hidden="true"></span>
          <span class="color-swatch-name"><%= c.nombre %></span>
        </button>
      <% }) %>
      <button type="button"
              class="color-swatch-option color-swatch-none<%= selectedColorId === '' ? ' selected' : '' %>"
              data-color-id="" role="radio" aria-checked="<%= selectedColorId === '' %>" <%= esSoloLectura ? 'disabled' : '' %>>
        <span class="color-swatch-box color-swatch-box-none" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"/></svg>
        </span>
        <span class="color-swatch-name">Sin color</span>
      </button>
    </div>
    <input type="hidden" name="color" id="areaColorInput" value="<%= selectedColorId %>">
  </div>

  <div class="color-preview-card">
    <span class="color-preview-label">Vista previa en Google Calendar</span>
    <div class="color-preview-calendar">
      <div class="color-preview-day">
        <span class="color-preview-day-name">Lun</span>
        <span class="color-preview-day-num">12</span>
      </div>
      <div class="color-preview-events">
        <div class="color-preview-event" style="--event-color: #7986cb;">
          <span class="color-preview-event-dot"></span>09:00 — Consulta rutina
        </div>
        <div class="color-preview-event color-preview-event-live<%= selectedColorObj ? '' : ' color-preview-event-none' %>"
             id="areaColorPreviewEvent"
             style="<%= selectedColorObj ? `--event-color: ${selectedColorObj.hex};` : '' %>">
          <span class="color-preview-event-dot"></span>
          <span id="areaColorPreviewName"><%= nombre || 'Área sin nombre' %></span>
        </div>
        <div class="color-preview-event" style="--event-color: #0b8043;">
          <span class="color-preview-event-dot"></span>15:30 — Cirugía programada
        </div>
      </div>
    </div>
  </div>
  <div class="modal-actions">
    <% if (esSoloLectura) { %>
      <button type="button" class="btn-secondary" id="areaFormCancel">Cerrar</button>
    <% } else { %>
      <button type="button" class="btn-secondary" id="areaFormCancel">Cancelar</button>
      <button type="submit" class="btn-primary">Guardar</button>
    <% } %>
  </div>
</form>
