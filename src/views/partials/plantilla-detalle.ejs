<%
const esRespuestaEmergencia = Boolean(plantilla.es_emergencia);
%>
<div class="modal-header">
  <h2 style="display:flex; align-items:center; gap:10px;">
    Detalle de la plantilla
    <span class="badge meta-category-badge <%= esRespuestaEmergencia ? 'is-emergencia' : 'is-informativa' %>">
      <%= esRespuestaEmergencia ? 'Respuesta a Emergencia' : 'Respuesta Informativa' %>
    </span>
  </h2>
  <button class="modal-close-btn" type="button" id="plantillaFormClose" aria-label="Cerrar">&times;</button>
</div>
<form class="modal-form">
  <div class="profile-form-row">
    <label>
      Intención
      <input type="text" value="<%= plantilla.intencion %>" readonly disabled>
    </label>
    <label>
      Slug (para el LLM)
      <input type="text" value="<%= plantilla.slug %>" readonly disabled>
    </label>
  </div>
  <div class="profile-form-row">
    <label>
      Estado
      <input type="text" value="<%= plantilla.activo ? 'Activo' : 'Inactivo' %>" readonly disabled>
    </label>
    <label>
      Veces utilizada
      <input type="text" value="<%= plantilla.veces_usada %>" readonly disabled>
    </label>
  </div>
  <div class="profile-form-row">
    <%
      const esTextoLibre = plantilla.categoria_meta === 'TEXTO_LIBRE';
      const estadoMeta = esTextoLibre
        ? 'No Requerido'
        : !plantilla.activo
          ? 'N/A'
          : plantilla.aprobado_meta
            ? 'Aprobado'
            : 'En revisión';
    %>
    <label>
      Estado en Meta
      <input type="text" value="<%= estadoMeta %>" readonly disabled>
    </label>
    <div class="plantilla-detalle-field">
      <span class="plantilla-detalle-label">Categoría Meta</span>
      <%
        const CATEGORIA_META_LABEL = {
          MARKETING: 'Marketing',
          UTILITY: 'Utility',
          AUTHENTICATION: 'Authentication',
          TEXTO_LIBRE: 'Texto Libre',
        };
        const categoriaMeta = String(plantilla.categoria_meta || '').toUpperCase();
        const categoriaMetaLabel = CATEGORIA_META_LABEL[categoriaMeta] || plantilla.categoria_meta || 'Sin categoría';
        const categoriaMetaClase = categoriaMeta === 'TEXTO_LIBRE'
          ? 'is-texto-libre'
          : categoriaMeta === 'UTILITY'
            ? 'is-utility'
            : categoriaMeta === 'MARKETING'
              ? 'is-marketing'
              : 'is-other';
      %>
      <span class="badge meta-category-badge <%= categoriaMetaClase %>"><%= categoriaMetaLabel %></span>
    </div>
  </div>
  <div class="plantilla-texto-field">
    <span class="plantilla-detalle-label">Texto de respuesta</span>
    <div class="plantilla-texto-editor plantilla-texto-preview" data-whatsapp-preview aria-label="Vista previa del texto de respuesta"></div>
    <textarea data-whatsapp-preview-source hidden><%= plantilla.texto_respuesta %></textarea>
  </div>
  <% if (plantilla.es_predeterminada) { %>
    <p class="tutor-form-hint">Plantilla predeterminada del sistema — no se puede eliminar, solo editar su texto de respuesta.</p>
  <% } %>
  <div class="modal-actions">
    <button type="button" class="btn-secondary" id="plantillaFormCancel">Cerrar</button>
  </div>
</form>
