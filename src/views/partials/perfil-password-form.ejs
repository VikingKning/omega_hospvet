<%
// US-110: fragmento independiente de partials/perfil-form.ejs — su propio
// <form> hace hx-post a mi-perfil/password con hx-target="#cambiar-password-panel"
// (definido en perfil-form.ejs), así que un guardado exitoso o un error
// SOLO reemplaza esta sección, nunca el resto de la página ni el <details>
// que la envuelve (que se queda abierto).
//
// AC: la nueva contraseña "puede contener letras, mayúsculas, minúsculas,
// números, símbolos y espacios... no debe exigir obligatoriamente una
// combinación específica de tipos de caracteres" — por eso el único
// atributo de validación de cliente es `minlength`, sin `pattern` (a
// diferencia de Teléfono/Correo en la sección de arriba, que sí exigen un
// formato específico).
//
// Layout pedido explícitamente: ancho completo en 2 columnas — izquierda
// Nueva contraseña + Confirmar (las dos relacionadas entre sí), derecha
// Contraseña actual, botón abajo alineado a la derecha. El ojo de
// mostrar/ocultar (mismo patrón que usuario-form.ejs/index.ejs) se
// delega sobre #perfil-panel en perfil.ejs, no aquí — este fragmento se
// reemplaza completo en cada guardado, un listener puesto aquí se perdería.
%>
<% if (mensaje) { %>
  <div class="form-success-banner">
    <span><%= mensaje %></span>
  </div>
<% } %>
<% if (error) { %>
  <div class="form-error-banner">
    <span><%= error %></span>
  </div>
<% } %>

<form class="modal-form" id="cambiarPasswordForm"
      hx-post="mi-perfil/password" hx-target="#cambiar-password-panel" hx-swap="innerHTML"
      hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'>
  <div class="profile-form-row">
    <div class="profile-form-col">
      <label>
        Contraseña actual
        <div class="input-wrap password-field-wrap">
          <input type="password" name="passwordActual" id="passwordActualInput" required autocomplete="current-password">
          <button type="button" class="toggle-pass" data-input-id="passwordActualInput" data-eye-icon-id="passwordActualEyeIcon" aria-label="Mostrar contraseña">
            <svg id="passwordActualEyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </label>
    </div>
    <div class="profile-form-col">
      <label>
        Nueva contraseña
        <div class="input-wrap password-field-wrap">
          <input type="password" name="passwordNueva" id="passwordNuevaInput" required minlength="15" maxlength="72"
                 autocomplete="new-password"
                 title="La contraseña debe tener al menos 15 caracteres. Puedes utilizar letras, números, símbolos y espacios.">
          <button type="button" class="toggle-pass" data-input-id="passwordNuevaInput" data-eye-icon-id="passwordNuevaEyeIcon" aria-label="Mostrar contraseña">
            <svg id="passwordNuevaEyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </label>
      <label>
        Confirmar nueva contraseña
        <div class="input-wrap password-field-wrap">
          <input type="password" name="confirmarPassword" id="confirmarPasswordInput" required autocomplete="new-password">
          <button type="button" class="toggle-pass" data-input-id="confirmarPasswordInput" data-eye-icon-id="confirmarPasswordEyeIcon" aria-label="Mostrar contraseña">
            <svg id="confirmarPasswordEyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </label>
      <p class="password-policy-hint">La contraseña debe tener al menos 15 caracteres. Puedes utilizar letras, números, símbolos y espacios.</p>
    </div>
  </div>
  <div class="modal-actions">
    <button type="submit" class="btn-primary">Actualizar contraseña</button>
  </div>
</form>
