<%
// Agenda: mismo formulario para alta y edición — el modo se decide por si
// `cita` viene o no (edición trae el registro completo, alta viene null).
// Este partial se usa tanto para el primer render (GET .../citas/nueva o
// .../citas/:id/editar) como para el re-render con error (POST/PUT
// fallidos, ver agenda.controller.js) — por eso fechaHoraInicio/
// duracionMinutos/doctorIdSeleccionado/mascotaSeleccionada viajan aparte de
// `cita`: en un re-render por error son lo que el usuario acababa de
// elegir, no necesariamente lo que ya está guardado.
//
// Los combobox de Mascota/Doctor y la combinación Fecha+Hora -> ISO se
// resuelven con JS delegado en agenda.ejs (este fragmento nunca trae su
// propio <script> — HTMX lo borraría al hacer swap, allowScriptTags:false).
const esEdicion = Boolean(cita);
const permissions = user?.permissions ?? [];
const has = (code) => permissions.includes(code);
const puedeCancelar = has(`agenda.${area.slug}.cancelar`);
// Reserva externa (agenda.reservasExternas.js) sin match completo, ya
// completada a mano por el staff — mismo permiso que editar (no se
// inventa uno nuevo solo para esta acción, ver agenda.routes.js).
const puedeConfirmar = has(`agenda.${area.slug}.editar`);
const esConfirmable = esEdicion && cita.estado === 'registrada';
// Pedido explícito del usuario: una cita que ya pasó no se puede editar
// (evita "agenciarse" citas ya ocurridas cambiando doctor/mascota/motivo a
// posteriori) — el formulario se abre en solo lectura en vez de no abrir
// nada, para poder seguir viendo sus detalles. `soloLectura` viaja desde
// agenda.controller.js (siempre false en alta/re-render por error).
const esSoloLectura = Boolean(soloLectura);
const disabledAttr = esSoloLectura ? 'disabled' : '';

const DURACIONES = [15, 30, 45, 60, 90];
const doctorIdSel = String(doctorIdSeleccionado ?? '');
const doctorSeleccionado = doctores.find((d) => String(d.id) === doctorIdSel);
const doctorLabel = doctorSeleccionado ? `${doctorSeleccionado.nombre} ${doctorSeleccionado.apellidos}` : '';
// Pedido explícito del usuario: el tutor se busca y se elige ANTES que la
// mascota (mismo patrón que laboratorio-form.ejs) — así, cuando una reserva
// externa de Google Calendar (agenda.reservasExternas.js) ya trae el
// teléfono matcheado pero no la mascota, el staff solo tiene que elegir el
// paciente. El nombre de la mascota ya no repite tutor/apellidos (ahora
// viven en su propio campo, arriba).
const hayTutor = Boolean(tutorSeleccionado);
const tutorLabel = hayTutor ? `${tutorSeleccionado.nombre} ${tutorSeleccionado.apellidos}` : '';
const tutorTelefonoLabel = hayTutor ? tutorSeleccionado.telefono : '';
const mascotaLabel = mascotaSeleccionada ? mascotaSeleccionada.nombre : '';
const mascotaTriggerDisabledAttr = esSoloLectura || !hayTutor ? 'disabled' : '';
%>
<div class="modal-header">
  <h2><%= esSoloLectura ? 'Detalle de la cita' : (esEdicion ? 'Editar cita' : 'Nueva cita') %></h2>
  <button class="modal-close-btn" type="button" id="citaFormClose" aria-label="Cerrar">&times;</button>
</div>

<% if (error) { %>
  <div class="form-error-banner">
    <span><%= error %></span>
    <button type="button" class="modal-close-btn" id="citaFormErrorDismiss" aria-label="Cerrar mensaje">&times;</button>
  </div>
<% } %>

<% if (esSoloLectura) { %>
  <div class="form-info-banner">
    <span>Esta cita ya pasó — solo se puede consultar, no editar.</span>
  </div>
<% } %>

<% if (esConfirmable) { %>
  <div class="form-info-banner">
    <span>Reserva pendiente de confirmar (viene de la página de reservas en línea).<%= cita.mascota_id ? '' : ' Selecciona la mascota y da clic en Confirmar cita.' %></span>
  </div>
<% } %>

<form class="modal-form" id="citaForm" data-area-slug="<%= area.slug %>"
      hx-<%= esEdicion ? 'put' : 'post' %>="<%= esEdicion ? `agenda/${area.slug}/citas/${cita.id}` : `agenda/${area.slug}/citas` %>"
      hx-target="#citaFormModalBody" hx-swap="innerHTML"
      hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'>
  <%
  // Pedido explícito del usuario: 2 columnas por fila (Teléfono+Tutor,
  // Mascota+Doctor) y una fila de 3 (Fecha/Hora/Duración) para que el
  // formulario quepa sin scroll — mismo grid que .profile-form-row
  // (perfil-form.ejs/perfil-password-form.ejs), pero con su propio nombre
  // (`.cita-form-row*`): son módulos distintos, mismo criterio ya usado
  // entre tutor-form-*/lab-form-* aunque el CSS sea equivalente.
  %>
  <div class="cita-form-row">
    <label>
      Teléfono del tutor
      <input type="text" id="citaTutorTelefono" placeholder="Ej. 5512345678" inputmode="numeric" autocomplete="off"
             pattern="(\d{2}-\d{4}-\d{4}|\d{3}-\d{3}-\d{4})" maxlength="12"
             title="Formato de teléfono en México: 10 dígitos (NN-NNNN-NNNN si inicia con 55/56, NNN-NNN-NNNN en otro caso)"
             <%= disabledAttr %> value="<%= tutorTelefonoLabel %>">
    </label>

    <label>
      Tutor
      <div class="combobox" id="citaTutorNombreCombobox">
        <input type="text" id="citaTutorNombreInput" autocomplete="off" placeholder="Buscar por nombre..." <%= disabledAttr %> value="<%= tutorLabel %>">
        <ul class="combobox-list" id="citaTutorNombreList" hidden></ul>
      </div>
    </label>
  </div>

  <%
  // Isla de datos JSON (nunca un <script> — HTMX lo borraría al hacer swap
  // del modal): las mascotas del tutor precargado, para que el JS de
  // agenda.ejs pueda repoblar #citaMascotaList sin pedirlas de nuevo al
  // servidor cada vez que se reabre el combobox.
  %>
  <div id="citaTutorData" hidden><%- JSON.stringify(tutorSeleccionado).replace(/</g, String.fromCharCode(92, 117, 48, 48, 51, 99)) %></div>

  <div class="cita-form-row">
    <label>
      Mascota (paciente)
      <div class="combobox" id="citaMascotaCombobox">
        <input type="text" id="citaMascotaTrigger" class="select-trigger-input" readonly autocomplete="off" required
               <%= mascotaTriggerDisabledAttr %>
               placeholder="<%= hayTutor ? 'Selecciona un paciente...' : 'Primero busca al tutor por teléfono o nombre' %>"
               value="<%= mascotaLabel %>">
        <ul class="combobox-list" id="citaMascotaList" hidden></ul>
      </div>
      <input type="hidden" name="mascotaId" id="citaMascotaId" value="<%= mascotaSeleccionada ? mascotaSeleccionada.id : '' %>">
    </label>

    <label>
      Doctor
      <div class="combobox" id="citaDoctorCombobox">
        <input type="text" id="citaDoctorInput" autocomplete="off" required <%= disabledAttr %>
               placeholder="Buscar doctor..." value="<%= doctorLabel %>">
        <ul class="combobox-list" id="citaDoctorList" hidden></ul>
      </div>
      <input type="hidden" name="doctorId" id="citaDoctorId" value="<%= doctorIdSel %>">
    </label>
  </div>

  <div class="cita-form-row-3">
    <label>
      Fecha
      <input type="date" id="citaFecha" required <%= disabledAttr %>>
    </label>
    <label>
      Hora
      <input type="time" id="citaHora" required <%= disabledAttr %>>
    </label>
    <label>
      Duración
      <select name="duracionMinutos" id="citaDuracion" required <%= disabledAttr %>>
        <option value="" disabled <%= duracionMinutos ? '' : 'selected' %>>Selecciona...</option>
        <% DURACIONES.forEach((min) => { %>
          <option value="<%= min %>" <%= String(min) === String(duracionMinutos) ? 'selected' : '' %>><%= min %> min</option>
        <% }) %>
      </select>
    </label>
  </div>
  <input type="hidden" name="fechaHoraInicio" id="citaFechaHoraInicio" value="<%= fechaHoraInicio %>">

  <label>
    Motivo
    <textarea name="motivo" rows="3" <%= disabledAttr %>><%= motivo %></textarea>
  </label>

  <div class="modal-actions">
    <% if (esEdicion && puedeCancelar) { %>
      <button type="button" class="btn-danger" id="citaFormCancelarCita"
              hx-delete="agenda/<%= area.slug %>/citas/<%= cita.id %>"
              hx-target="#citaFormModalBody" hx-swap="innerHTML"
              hx-confirm="¿Cancelar esta cita? El registro se conserva en el historial, solo deja de aparecer en el calendario.">
        Cancelar cita
      </button>
    <% } %>
    <% if (esConfirmable && puedeConfirmar) { %>
      <%
        // "Confirmar cita" manda el <form> completo (hx-include) y hace
        // guardar+confirmar en un solo paso del lado del servidor — pedido
        // explícito del usuario: antes había que Guardar, volver a abrir la
        // cita, y HASTA ENTONCES aparecía habilitado Confirmar, lo cual no
        // tenía sentido para completar una reserva pendiente. El disabled
        // inicial refleja el estado ya guardado (cita.mascota_id); el JS de
        // agenda.ejs lo actualiza en vivo en cuanto se elige una mascota en
        // el combobox de arriba, sin esperar a guardar primero.
      %>
      <button type="button" class="btn-primary" id="citaFormConfirmar"
              <%= cita.mascota_id ? '' : 'disabled data-tooltip="Selecciona la mascota primero"' %>
              hx-post="agenda/<%= area.slug %>/citas/<%= cita.id %>/confirmar"
              hx-include="#citaForm"
              hx-target="#citaFormModalBody" hx-swap="innerHTML">
        Confirmar cita
      </button>
    <% } %>
    <button type="button" class="btn-secondary" id="citaFormCancel">Cerrar</button>
    <% if (!esSoloLectura && !esConfirmable) { %>
      <button type="submit" class="btn-primary">Guardar</button>
    <% } %>
  </div>
</form>
