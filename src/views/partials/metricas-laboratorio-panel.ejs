<%
function horasLabel(horas) {
  return horas === null ? '—' : `${horas} h`;
}
%>
<form id="metricas-laboratorio-filters"
      hx-post="metricas/laboratorio.html" hx-target="#metricas-laboratorio-panel" hx-swap="innerHTML"
      hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'>
  <div class="lab-toolbar">
    <div class="metricas-rango-fechas">
      <label>Desde
        <input type="date" name="desde" value="<%= rango.desde %>">
      </label>
      <label>Hasta
        <input type="date" name="hasta" value="<%= rango.hasta %>">
      </label>
      <button type="submit" class="btn-primary">Aplicar</button>
    </div>
    <div class="toggle-group">
      <button type="button" class="toggle-btn"
              hx-post="metricas/laboratorio.html" hx-include="#metricas-laboratorio-filters" hx-target="#metricas-laboratorio-panel"
              hx-vals='{"preset":7}'>Últimos 7 días</button>
      <button type="button" class="toggle-btn"
              hx-post="metricas/laboratorio.html" hx-include="#metricas-laboratorio-filters" hx-target="#metricas-laboratorio-panel"
              hx-vals='{"preset":30}'>Últimos 30 días</button>
      <button type="button" class="toggle-btn"
              hx-post="metricas/laboratorio.html" hx-include="#metricas-laboratorio-filters" hx-target="#metricas-laboratorio-panel"
              hx-vals='{"preset":90}'>Últimos 90 días</button>
    </div>
  </div>
</form>

<div class="metricas-kpis metricas-kpis-laboratorio">
  <div class="metricas-kpi-card">
    <span class="metricas-kpi-label">Total de órdenes</span>
    <span class="metricas-kpi-value"><%= total %></span>
    <span class="metricas-kpi-description">Órdenes en total</span>
  </div>
  <% porEstado.forEach((fila) => { %>
    <div class="metricas-kpi-card">
      <span class="metricas-kpi-label"><%= fila.etiqueta %></span>
      <span class="metricas-kpi-value"><%= fila.total %></span>
      <span class="metricas-kpi-description"><%= total ? Math.round((fila.total / total) * 100) : 0 %>% de las órdenes</span>
    </div>
  <% }) %>
  <div class="metricas-kpi-card">
    <span class="metricas-kpi-label">Pendiente → Cargado</span>
    <span class="metricas-kpi-value"><%= horasLabel(tiempos.horasPendienteACargado) %></span>
    <span class="metricas-kpi-description">Transición promedio</span>
  </div>
  <div class="metricas-kpi-card">
    <span class="metricas-kpi-label">Cargado → Enviado</span>
    <span class="metricas-kpi-value"><%= horasLabel(tiempos.horasCargadoAEnviado) %></span>
    <span class="metricas-kpi-description">Transición promedio</span>
  </div>
  <div class="metricas-kpi-card">
    <span class="metricas-kpi-label">Total: Pendiente → Enviado</span>
    <span class="metricas-kpi-value"><%= horasLabel(tiempos.horasPendienteAEnviado) %></span>
    <span class="metricas-kpi-description">Transición promedio</span>
  </div>
</div>

<% if (total === 0) { %>
  <div class="lab-table-wrap">
    <div class="empty-state-panel">
      <span class="empty-state-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>
      </span>
      <p class="empty-state-title">No hay órdenes en este rango de fechas</p>
      <p class="empty-state-description">Prueba con un rango más amplio, o ajusta las fechas a mano arriba.</p>
    </div>
  </div>
<% } else { %>
  <div class="metricas-charts">
    <div class="metricas-chart-card">
      <h3>Tendencia diaria</h3>
      <canvas id="metricasChartTendencia"></canvas>
    </div>
    <div class="metricas-chart-card">
      <h3>Órdenes por estado</h3>
      <canvas id="metricasChartEstados"></canvas>
    </div>
    <div class="metricas-chart-card">
      <h3>Órdenes por especie</h3>
      <p class="metricas-chart-description">Distribución de la demanda de laboratorio entre perros y gatos.</p>
      <canvas id="metricasChartEspecies"></canvas>
    </div>
    <div class="metricas-chart-card">
      <h3>Estudios más solicitados</h3>
      <canvas id="metricasChartEstudios"></canvas>
    </div>
    <div class="metricas-chart-card">
      <h3>Categorías más solicitadas</h3>
      <canvas id="metricasChartCategorias"></canvas>
    </div>
    <div class="metricas-chart-card">
      <h3>Doctores que más solicitan</h3>
      <canvas id="metricasChartDoctores"></canvas>
    </div>
    <div class="metricas-chart-card">
      <h3>Antigüedad de órdenes abiertas</h3>
      <p class="metricas-chart-description">Tiempo transcurrido desde la recepción, separado entre pendientes y cargadas sin enviar.</p>
      <canvas id="metricasChartAntiguedad"></canvas>
    </div>
    <div class="metricas-chart-card">
      <h3>Envíos por canal y resultado</h3>
      <p class="metricas-chart-description">Intentos exitosos y fallidos por canal. “Ambos medios” es exitoso únicamente cuando funcionaron WhatsApp y correo.</p>
      <canvas id="metricasChartEnviosCanal"></canvas>
    </div>
    <div class="metricas-chart-card metricas-chart-card-wide">
      <h3>Mapa de calor de recepción de órdenes</h3>
      <p class="metricas-chart-description">Órdenes recibidas por día de la semana y hora local. Los tonos más intensos señalan las horas pico.</p>
      <div class="metricas-heatmap-scroll">
        <div id="metricasMapaRecepcion" class="metricas-heatmap" role="img" aria-label="Mapa de calor de órdenes recibidas por día y hora"></div>
      </div>
      <div class="metricas-heatmap-legend" aria-hidden="true">
        <span>Menor demanda</span>
        <% for (let nivel = 0; nivel <= 5; nivel += 1) { %>
          <span class="metricas-heatmap-swatch metricas-heatmap-level-<%= nivel %>"></span>
        <% } %>
        <span>Mayor demanda</span>
      </div>
    </div>
  </div>
<% } %>

<%
// Isla de datos JSON (nunca un <script> — HTMX lo borraría al hacer swap
// de este panel, allowScriptTags:false): el <script> de metricas-laboratorio.ejs
// (nunca se swapea) la lee en cada htmx:afterSwap para (re)construir las
// gráficas de Chart.js — mismo patrón ya establecido en el proyecto (ver
// #citaTutorData en cita-form.ejs).
%>
<div id="metricasLabData" hidden><%- JSON.stringify({ porDia, porEstado, topEstudios, topCategorias, topDoctores, mapaRecepcion, porEspecie, antiguedadAbiertas, enviosPorCanal }).replace(/</g, String.fromCharCode(92, 117, 48, 48, 51, 99)) %></div>
