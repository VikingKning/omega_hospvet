<%
const permissions = user?.permissions ?? [];
const has = (code) => permissions.includes(code);

function sortVals(column) {
  const nextDir = sort === column && dir === 'asc' ? 'desc' : 'asc';
  return JSON.stringify({ sort: column, dir: nextDir, page: 1 });
}

function initials(nombre, apellidos) {
  return `${nombre.charAt(0)}${apellidos.charAt(0)}`.toUpperCase();
}

const ESTATUS_LABELS = {
  activo: 'Activo',
  bloqueo_temp: 'Bloqueo temporal',
  bloqueado: 'Bloqueado',
  inactivo: 'Inactivo',
  cambio_pwd: 'Cambio de contraseña pendiente',
  todos: 'Todos',
};

const ESTATUS_BADGE_CLASS = {
  activo: ' is-active',
  bloqueo_temp: ' is-warning',
  bloqueado: ' is-danger',
  inactivo: '',
  cambio_pwd: ' is-warning',
};

const SORT_LABELS = { nombre: 'Nombre', username: 'Username', correo: 'Correo', estatus: 'Estatus' };

const bannerError = typeof error === 'undefined' ? null : error;
%>
<% if (bannerError) { %>
  <div class="form-error-banner">
    <span><%= bannerError %></span>
    <button type="button" class="modal-close-btn" id="usuariosBannerErrorDismiss" aria-label="Cerrar mensaje">&times;</button>
  </div>
<% } %>
<% if (catalogoVacio) { %>
  <div class="lab-table-wrap">
    <div class="empty-state-panel">
      <span class="empty-state-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <p class="empty-state-title">Todavía no hay usuarios registrados</p>
      <p class="empty-state-description">Da de alta el primer usuario del panel para empezar a asignarle permisos.</p>
      <% if (has('usuarios.crear')) { %>
        <button class="btn-primary" type="button"
                hx-get="usuarios/nuevo" hx-target="#usuarioFormModalBody" hx-swap="innerHTML">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          Registrar primer usuario
        </button>
      <% } %>
    </div>
  </div>
<% } else { %>
  <form id="usuarios-filters"
        hx-post="usuarios.html" hx-target="#usuarios-panel" hx-swap="innerHTML"
        hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'
        hx-trigger="input changed delay:400ms from:#usuarios-search, submit"
        hx-vals='{"page":1}'>
    <input type="hidden" name="sort" value="<%= sort %>">
    <input type="hidden" name="dir" value="<%= dir %>">
    <input type="hidden" name="page" value="<%= page %>">

    <div class="lab-toolbar">
      <div class="lab-toolbar-filters">
        <div class="lab-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <input type="text" id="usuarios-search" name="q" value="<%= q %>" placeholder="Buscar por nombre, usuario o correo...">
          <span class="lab-search-spinner htmx-indicator" aria-hidden="true"></span>
        </div>

        <input type="hidden" name="estatus" value="<%= estatus %>">
        <div class="combobox" id="estatusFiltroCombobox">
          <input type="text" id="estatusFiltroTrigger" class="lab-select select-trigger-input" readonly autocomplete="off"
                 placeholder="Todos"
                 value="<%= (estatus && estatus !== 'todos') ? ESTATUS_LABELS[estatus] : '' %>">

          <ul class="combobox-list" id="estatusFiltroList" hidden hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'>
            <% ['activo', 'bloqueo_temp', 'bloqueado', 'cambio_pwd', 'inactivo', 'todos'].forEach((valor) => { %>
              <li class="combobox-item"
                  hx-post="usuarios.html" hx-include="#usuarios-filters" hx-target="#usuarios-panel"
                  hx-vals='<%- JSON.stringify({ estatus: valor, page: 1 }) %>'><%= ESTATUS_LABELS[valor] %></li>
            <% }) %>
          </ul>
        </div>
      </div>
      <% if (has('usuarios.crear')) { %>
        <button class="btn-primary" type="button"
                hx-get="usuarios/nuevo" hx-target="#usuarioFormModalBody" hx-swap="innerHTML">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          Nuevo usuario
        </button>
      <% } %>
    </div>

    <div class="lab-table-wrap">
      <table class="lab-table">
        <thead>
          <tr>
            <% ['nombre', 'username', 'correo'].forEach((column) => { %>
              <th class="sortable-th">
                <button type="button" class="sortable-th-link"
                        hx-post="usuarios.html" hx-include="#usuarios-filters" hx-target="#usuarios-panel"
                        hx-vals='<%- sortVals(column) %>'>
                  <%= SORT_LABELS[column] %>
                  <svg class="sort-arrow<%= sort === column ? ' active' : '' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <% if (sort === column && dir === 'desc') { %>
                      <path d="M6 9l6 6 6-6"/>
                    <% } else { %>
                      <path d="M18 15l-6-6-6 6"/>
                    <% } %>
                  </svg>
                </button>
              </th>
            <% }) %>
            <th>Doctor vinculado</th>
            <th class="sortable-th">
              <button type="button" class="sortable-th-link"
                      hx-post="usuarios.html" hx-include="#usuarios-filters" hx-target="#usuarios-panel"
                      hx-vals='<%- sortVals("estatus") %>'>
                Estatus
                <svg class="sort-arrow<%= sort === 'estatus' ? ' active' : '' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <% if (sort === 'estatus' && dir === 'desc') { %>
                    <path d="M6 9l6 6 6-6"/>
                  <% } else { %>
                    <path d="M18 15l-6-6-6 6"/>
                  <% } %>
                </svg>
              </button>
            </th>
            <th class="text-right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% usuarios.forEach((usuario) => { %>
            <tr>
              <td>
                <div class="person-cell">
                  <span class="avatar-circle"><%= initials(usuario.nombre, usuario.apellidos) %></span>
                  <div>
                    <div class="person-cell-name"><%= usuario.nombre %> <%= usuario.apellidos %></div>
                  </div>
                </div>
              </td>
              <td><%= usuario.username %></td>
              <td><%= usuario.correo %></td>
              <td>
                <% if (usuario.doctor_nombre) { %>
                  <%= usuario.doctor_nombre %> <%= usuario.doctor_apellidos %>
                <% } else { %>
                  <span class="area-tag-empty">Sin vínculo</span>
                <% } %>
              </td>
              <td>
                <span class="status-badge<%= ESTATUS_BADGE_CLASS[usuario.estatus] ?? '' %>"><%= ESTATUS_LABELS[usuario.estatus] ?? usuario.estatus %></span>
              </td>
              <td class="text-right">
                <div class="row-actions">
                  <% if (has('usuarios.ver')) { %>
                    <button class="row-action-btn" type="button" data-tooltip="Ver"
                            aria-label="Ver usuario <%= usuario.username %>"
                            hx-get="usuarios/<%= usuario.id %>/ver" hx-target="#usuarioFormModalBody" hx-swap="innerHTML">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/>
                      </svg>
                    </button>
                  <% } %>
                  <% if (has('usuarios.editar')) { %>
                    <button class="row-action-btn row-action-edit" type="button" data-tooltip="Editar"
                            aria-label="Editar usuario <%= usuario.username %>"
                            hx-get="usuarios/<%= usuario.id %>/editar" hx-target="#usuarioFormModalBody" hx-swap="innerHTML">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                      </svg>
                    </button>
                  <% } %>

                  <% if (has('usuarios.resetear_password') && usuario.estatus !== 'inactivo' && usuario.id !== user.id) { %>
                    <button class="row-action-btn row-action-reset" type="button" data-tooltip="Resetear contraseña"
                            aria-label="Resetear contraseña de <%= usuario.username %>"
                            hx-post="usuarios/<%= usuario.id %>/resetear-password" hx-include="#usuarios-filters"
                            hx-target="#usuarios-panel" hx-swap="innerHTML"
                            data-confirm-label="Restablecer"
                            hx-confirm="Favor de confirmar el restablecimiento de contraseña de <%= usuario.nombre %> <%= usuario.apellidos %> (<%= usuario.username %>).&#10;Se generará una nueva contraseña temporal y, si tiene una sesión activa, se cerrará de inmediato.">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l1.8-1.8a1 1 0 0 0 0-1.4L19.4 5a1 1 0 0 0-1.4 0l-1.8 1.8a1 1 0 0 0 0 1.4Z"/>
                        <path d="m21 2-9.6 9.6"/>
                        <circle cx="7.5" cy="15.5" r="5.5"/>
                      </svg>
                    </button>
                  <% } %>

                  <% if (has('usuarios.eliminar') && usuario.estatus !== 'inactivo' && usuario.id !== user.id) { %>
                    <button class="row-action-btn row-action-delete" type="button" data-tooltip="Eliminar"
                            aria-label="Dar de baja a <%= usuario.username %>"
                            hx-delete="usuarios/<%= usuario.id %>" hx-include="#usuarios-filters"
                            hx-target="#usuarios-panel" hx-swap="innerHTML"
                            hx-confirm="Favor de confirmar la eliminación del usuario: <%= usuario.nombre %> <%= usuario.apellidos %> (<%= usuario.username %>)&#10;Perderá el acceso al sistema, pero su información e historial no se eliminan.">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/>
                      </svg>
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (usuarios.length === 0) { %>
        <p class="lab-empty">No hay resultados para tu búsqueda.</p>
      <% } %>

      <div class="table-footer">

        <span><%= usuarios.length %> resultado<%= usuarios.length === 1 ? '' : 's' %> – <%= total %> usuario<%= total === 1 ? '' : 's' %> en total</span>
        <% if (totalPages > 1) { %>
          <nav class="pagination" aria-label="Paginación">
            <button type="button" class="pagination-btn" aria-disabled="<%= page <= 1 %>" <%= page <= 1 ? 'disabled' : '' %>
                    hx-post="usuarios.html" hx-include="#usuarios-filters" hx-target="#usuarios-panel"
                    hx-vals='{"page":<%= Math.max(1, page - 1) %>}' aria-label="Página anterior">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <% for (let p = 1; p <= totalPages; p++) { %>
              <button type="button" class="pagination-page<%= p === page ? ' current' : '' %>"
                      hx-post="usuarios.html" hx-include="#usuarios-filters" hx-target="#usuarios-panel"
                      hx-vals='{"page":<%= p %>}'><%= p %></button>
            <% } %>
            <button type="button" class="pagination-btn" aria-disabled="<%= page >= totalPages %>" <%= page >= totalPages ? 'disabled' : '' %>
                    hx-post="usuarios.html" hx-include="#usuarios-filters" hx-target="#usuarios-panel"
                    hx-vals='{"page":<%= Math.min(totalPages, page + 1) %>}' aria-label="Página siguiente">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </nav>
        <% } %>
      </div>
    </div>
  </form>
<% } %>
