<%
// US-109 (extensión "Datos de mi cuenta", rediseño según mockup
// mockup_mi_perfil_omega.html / mockup_mi_perfil_omega_colapsable.html):
// "Mi cuenta" es un resumen SIEMPRE visible (pedido explícito: "no
// colapsable"); Datos personales/Áreas asignadas/Permisos/Cambiar
// contraseña son 4 secciones <details> — Datos personales abre por
// default (es la única con algo que hacer), las otras tres arrancan
// cerradas, igual que en el mockup colapsable.
//
// Username se muestra como texto plano dentro de "Mi cuenta" (no un
// <input>) — más fuerte que el criterio "readonly sin name" de antes: si
// no es un campo de formulario, no hay nada que ni siquiera intentar
// someter.
const ESTATUS_LABELS = {
  activo: 'Activo',
  bloqueo_temp: 'Bloqueo temporal',
  bloqueado: 'Bloqueado',
  inactivo: 'Inactivo',
  cambio_pwd: 'Cambio de contraseña pendiente',
};
const ESTATUS_BADGE_CLASS = {
  activo: ' is-active',
  bloqueo_temp: ' is-warning',
  bloqueado: ' is-danger',
  inactivo: '',
  cambio_pwd: ' is-warning',
};

// Mismos mapas de etiquetas que usuario-form.ejs (Módulo/Acción),
// duplicados a propósito — mismo criterio de independencia entre módulos
// que el resto de perfil/ (no se importa nada de usuarios/).
const MODULO_LABELS = {
  tutores: 'Tutores y pacientes',
  laboratorio: 'Laboratorio',
  usuarios: 'Gestión de usuarios',
  doctores: 'Catálogo de doctores',
  areas: 'Catálogo de áreas',
  plantillas: 'Plantillas de WhatsApp',
  metricas_whatsapp: 'WhatsApp',
  metricas_laboratorio: 'Laboratorios',
  metricas_agenda: 'Agenda',
};
const ACCION_LABELS = {
  ver: 'Ver',
  crear: 'Crear',
  editar: 'Editar',
  confirmar: 'Confirmar',
  cancelar: 'Cancelar',
  eliminar: 'Eliminar',
  carga_envio: 'Carga y envío',
  exportar: 'Exportar',
};
function etiqueta(mapa, valor) {
  return mapa[valor] ?? `${valor.charAt(0).toUpperCase()}${valor.slice(1).replace(/_/g, ' ')}`;
}

// Misma mecánica que usuario-form.ejs#estaMarcado (checkbox "Carga y
// Envío" combinado = 2 ids), aquí decide si se dibuja un check o un guion
// en vez de si un checkbox nace marcado.
const permisosAsignadosSet = new Set(permisosAsignadosIds);
function estaMarcado(permiso) {
  return String(permiso.id)
    .split(',')
    .map(Number)
    .every((id) => permisosAsignadosSet.has(id));
}

function formatearUltimoAcceso(fecha) {
  if (!fecha) return 'Sin registro';
  return new Date(fecha).toLocaleString('es-MX', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}
%>
<div class="perfil-page">

  <div class="profile-card profile-summary-card">
    <div class="profile-section-header">
      <svg class="profile-section-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/></svg>
      <span class="profile-section-title">Mi cuenta</span>
      <span class="account-status-badge<%= ESTATUS_BADGE_CLASS[estatus] ?? '' %>"><%= ESTATUS_LABELS[estatus] ?? estatus %></span>
    </div>
    <div class="profile-summary-grid">
      <div>
        <div class="profile-summary-label">Username</div>
        <div class="profile-summary-value"><%= username %></div>
      </div>
      <div>
        <div class="profile-summary-label">Correo</div>
        <div class="profile-summary-value"><%= correo %></div>
      </div>
      <div>
        <div class="profile-summary-label">Doctor vinculado</div>
        <div class="profile-summary-value"><%= doctor ? `${doctor.nombre} ${doctor.apellidos}` : 'Sin vínculo' %></div>
      </div>
      <div>
        <div class="profile-summary-label">Último acceso</div>
        <div class="profile-summary-value"><%= formatearUltimoAcceso(ultimoLoginEn) %></div>
      </div>
    </div>
  </div>

  <details class="profile-card profile-section" open>
    <summary class="profile-section-header">
      <svg class="profile-section-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      <span class="profile-section-title">Datos personales</span>
      <svg class="profile-section-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <div class="profile-section-body">
      <% if (mensaje) { %>
        <div class="form-success-banner">
          <span><%= mensaje %></span>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="form-error-banner">
          <span><%= error %></span>
        </div>
      <% } %>

      <form class="modal-form" id="perfilForm"
            hx-post="mi-perfil.html" hx-target="#perfil-panel" hx-swap="innerHTML"
            hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'>
        <div class="profile-form-row">
          <label>
            Nombre(s)
            <input type="text" name="nombre" value="<%= nombre %>" required maxlength="100" autofocus>
          </label>
          <label>
            Apellidos
            <input type="text" name="apellidos" value="<%= apellidos %>" required maxlength="100">
          </label>
        </div>
        <div class="profile-form-row">
          <label>
            Correo electrónico
            <input type="email" name="correo" value="<%= correo %>" required maxlength="150">
          </label>
          <label>
            Teléfono
            <input type="text" name="telefono" id="telefonoInput" value="<%= telefono %>"
                   placeholder="NN-NNNN-NNNN" inputmode="numeric" autocomplete="off"
                   pattern="\d{2}-\d{4}-\d{4}" maxlength="12"
                   title="Formato de teléfono en México: 10 dígitos (NN-NNNN-NNNN)">
          </label>
        </div>
        <div class="modal-actions">
          <button type="submit" class="btn-primary">Guardar cambios</button>
        </div>
      </form>
    </div>
  </details>

  <details class="profile-card profile-section">
    <summary class="profile-section-header">
      <svg class="profile-section-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/></svg>
      <span class="profile-section-title">Áreas asignadas</span>
      <span class="profile-section-subtitle">heredadas del doctor vinculado</span>
      <svg class="profile-section-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <div class="profile-section-body">
      <% if (!doctor) { %>
        <p class="account-permisos-vacio">Esta cuenta no tiene un doctor vinculado.</p>
      <% } else if (areasDoctor.length) { %>
        <div class="account-areas">
          <% areasDoctor.forEach((area) => { %><span class="area-tag"><%= area.nombre %></span><% }) %>
        </div>
      <% } else { %>
        <span class="area-tag-empty">Sin área asignada</span>
      <% } %>
    </div>
  </details>

  <details class="profile-card profile-section">
    <summary class="profile-section-header">
      <svg class="profile-section-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
      <span class="profile-section-title">Permisos</span>
      <span class="profile-section-subtitle">solo lectura</span>
      <svg class="profile-section-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <div class="profile-section-body">
      <% if (matrizPermisos.tabs.length) { %>
        <% matrizPermisos.tabs.forEach((tab, i) => { %>
          <input type="radio" name="perfilPermisosTabUI" id="permisosTab-<%= tab.id %>" class="permisos-tab-radio"
                 <%= i === 0 ? 'checked' : '' %> hidden>
        <% }) %>
        <div class="permisos-tabs">
          <% matrizPermisos.tabs.forEach((tab) => { %>
            <label for="permisosTab-<%= tab.id %>" class="permisos-tab-label permisos-tab-label-<%= tab.id %>"><%= tab.titulo %></label>
          <% }) %>
        </div>
        <% matrizPermisos.tabs.forEach((tab) => { %>
          <div class="permisos-tab-panel permisos-tab-panel-<%= tab.id %>">
            <div class="permisos-matrix-wrap">
              <table class="permisos-matrix">
                <thead>
                  <tr>
                    <th>Módulo</th>
                    <% tab.acciones.forEach((accion) => { %>
                      <th><%= etiqueta(ACCION_LABELS, accion) %></th>
                    <% }) %>
                  </tr>
                </thead>
                <tbody>
                  <% tab.secciones.forEach((seccion) => { %>
                    <% if (seccion.titulo) { %>
                      <tr class="permisos-seccion-row">
                        <td colspan="<%= 1 + tab.acciones.length %>"><%= seccion.titulo %></td>
                      </tr>
                    <% } %>
                    <% seccion.modulos.forEach((fila) => { %>
                      <tr>
                        <td><%= fila.nombre ?? etiqueta(MODULO_LABELS, fila.modulo) %></td>
                        <% fila.celdas.forEach((permiso) => { %>
                          <td class="permiso-cell">
                            <% if (permiso && estaMarcado(permiso)) { %>
                              <svg class="permiso-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-label="Otorgado"><polyline points="20 6 9 17 4 12"/></svg>
                            <% } else if (permiso) { %>
                              <span class="permiso-dash" aria-label="No otorgado">&mdash;</span>
                            <% } %>
                          </td>
                        <% }) %>
                      </tr>
                    <% }) %>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="account-permisos-vacio">Esta cuenta no tiene permisos asignados.</p>
      <% } %>
    </div>
  </details>

  <details class="profile-card profile-section">
    <summary class="profile-section-header">
      <svg class="profile-section-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span class="profile-section-title">Cambiar contraseña</span>
      <svg class="profile-section-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <%
    // US-110: fragmento HTMX independiente del resto de la página — el
    // target es este mismo div (#cambiar-password-panel), no #perfil-panel,
    // así un guardado exitoso o un error solo reemplaza esta sección: el
    // <details> que la envuelve nunca se toca, se queda abierto, y no hace
    // falta volver a consultar doctor/áreas/matriz de permisos por un
    // cambio que no los afecta (ver perfil.controller.js#cambiarPassword).
    %>
    <div class="profile-section-body" id="cambiar-password-panel">
      <%- include('perfil-password-form', { mensaje: null, error: null, csrfToken }) %>
    </div>
  </details>

</div>
