<%
// Partial compartido por main.ejs, agenda.ejs, grooming.ejs y laboratorio.ejs
// (antes copiado igual en las 4 vistas). Recibe `user` (con `permissions`,
// el set cacheado en sesión al hacer login) y `currentPage` para resaltar
// el ítem activo. AC6 de US-101: un módulo al que el usuario no tiene
// acceso nunca se renderiza, ni brevemente — el filtrado ocurre aquí, en el
// servidor, antes de que el HTML salga hacia el navegador.
const permissions = user?.permissions ?? [];
const has = (code) => permissions.includes(code);
const agendaOpen = currentPage === 'agenda' || currentPage === 'grooming';
const configPerms = ['usuarios.ver', 'usuarios.permisos', 'doctores.ver', 'plantillas_whatsapp.ver'];
const showConfigGroup = configPerms.some(has);
const configOpen = currentPage === 'doctores';
%>
<nav class="sidebar-nav" id="sidebar">
  <% if (has('agenda.ver') || has('grooming.ver')) { %>
    <div class="nav-group">
      <button class="nav-link nav-toggle<%= agendaOpen ? ' active' : '' %>" type="button" data-target="agenda-menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        <span>Agenda</span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="submenu<%= agendaOpen ? ' open' : '' %>" id="agenda-menu">
        <% if (has('agenda.ver')) { %>
          <a href="agenda.html" class="submenu-link<%= currentPage === 'agenda' ? ' current' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/></svg>
            <span>Consultas y cirugías</span>
          </a>
        <% } %>
        <% if (has('grooming.ver')) { %>
          <a href="grooming.html" class="submenu-link<%= currentPage === 'grooming' ? ' current' : '' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/><path d="M5 12v5a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-5"/><path d="M7 20v1"/><path d="M17 20v1"/><circle cx="9" cy="6" r="1"/><circle cx="13" cy="4.5" r="1"/><circle cx="16" cy="7" r="1"/></svg>
            <span>Grooming</span>
          </a>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (has('laboratorio.ver')) { %>
    <a href="laboratorio.html" class="nav-link<%= currentPage === 'laboratorio' ? ' current' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v5.5L4.5 17a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L15 8.5V3"/><path d="M9 3h6M8 14h8"/></svg>
      <span>Laboratorio</span>
    </a>
  <% } %>

  <% if (has('metricas.ver')) { %>
    <a href="#" class="nav-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>
      <span>Métricas</span>
    </a>
  <% } %>

  <% if (showConfigGroup) { %>
    <div class="nav-group">
      <button class="nav-link nav-toggle<%= configOpen ? ' active' : '' %>" type="button" data-target="config-menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span>Configuraciones</span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="submenu<%= configOpen ? ' open' : '' %>" id="config-menu">
        <% if (has('usuarios.ver')) { %><a href="#" class="submenu-link">Gestión de usuarios</a><% } %>
        <a href="#" class="submenu-link">Cambio de contraseña</a>
        <% if (has('usuarios.permisos')) { %><a href="#" class="submenu-link">Roles y accesos</a><% } %>
        <% if (has('doctores.ver')) { %><a href="doctores.html" class="submenu-link<%= currentPage === 'doctores' ? ' current' : '' %>">Catalogo de Doctores</a><% } %>
        <% if (has('plantillas_whatsapp.ver')) { %><a href="#" class="submenu-link">Plantillas de respuesta</a><% } %>
      </div>
    </div>
  <% } %>

  <a href="/logout" class="nav-link nav-logout">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
    <span>Cerrar sesión</span>
  </a>
</nav>
