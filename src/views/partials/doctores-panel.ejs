<%
const permissions = user?.permissions ?? [];
const has = (code) => permissions.includes(code);

function sortVals(column) {
  const nextDir = sort === column && dir === 'asc' ? 'desc' : 'asc';
  return JSON.stringify({ sort: column, dir: nextDir, page: 1 });
}

function initials(nombre, apellidos) {
  return `${nombre.charAt(0)}${apellidos.charAt(0)}`.toUpperCase();
}
%>
<% if (catalogoVacio) { %>
  <div class="lab-table-wrap">
    <div class="empty-state-panel">
      <span class="empty-state-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </span>
      <p class="empty-state-title">Todavía no hay doctores registrados</p>
      <p class="empty-state-description">Da de alta al primer doctor de la clínica y asígnale una o más áreas para que empiece a aparecer como doctor solicitante en Agenda y en Laboratorio.</p>
      <% if (has('doctores.crear')) { %>
        <button class="btn-primary" type="button"
                hx-get="doctores/nuevo" hx-target="#doctorFormModalBody" hx-swap="innerHTML">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          Registrar primer doctor
        </button>
      <% } %>
    </div>
  </div>
<% } else { %>
  <form id="doctores-filters"
        hx-post="doctores.html" hx-target="#doctores-panel" hx-swap="innerHTML"
        hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'
        hx-trigger="input changed delay:400ms from:#doctores-search, submit"
        hx-vals='{"page":1}'>
    <input type="hidden" name="estado" value="<%= estado %>">
    <input type="hidden" name="sort" value="<%= sort %>">
    <input type="hidden" name="dir" value="<%= dir %>">
    <input type="hidden" name="page" value="<%= page %>">

    <div class="lab-toolbar">
      <div class="lab-toolbar-filters">
        <div class="lab-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <input type="text" id="doctores-search" name="q" value="<%= q %>" placeholder="Buscar por doctor o área...">
        </div>
        <div class="toggle-group">
          <button type="button" class="toggle-btn<%= estado === 'activos' ? ' active' : '' %>"
                  hx-post="doctores.html" hx-include="#doctores-filters" hx-target="#doctores-panel"
                  hx-vals='{"estado":"activos","page":1}'>Activos</button>
          <button type="button" class="toggle-btn<%= estado === 'todos' ? ' active' : '' %>"
                  hx-post="doctores.html" hx-include="#doctores-filters" hx-target="#doctores-panel"
                  hx-vals='{"estado":"todos","page":1}'>Todos</button>
        </div>
      </div>
      <% if (has('doctores.crear')) { %>
        <button class="btn-primary" type="button"
                hx-get="doctores/nuevo" hx-target="#doctorFormModalBody" hx-swap="innerHTML">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          Nuevo doctor
        </button>
      <% } %>
    </div>

    <div class="lab-table-wrap">
      <table class="lab-table">
        <thead>
          <tr>
            <% ['doctor', 'areas', 'estado'].forEach((column) => { %>
              <th class="sortable-th">
                <button type="button" class="sortable-th-link"
                        hx-post="doctores.html" hx-include="#doctores-filters" hx-target="#doctores-panel"
                        hx-vals='<%- sortVals(column) %>'>
                  <%= { doctor: 'Doctor', areas: 'Áreas', estado: 'Estado' }[column] %>
                  <svg class="sort-arrow<%= sort === column ? ' active' : '' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <% if (sort === column && dir === 'desc') { %>
                      <path d="M6 9l6 6 6-6"/>
                    <% } else { %>
                      <path d="M18 15l-6-6-6 6"/>
                    <% } %>
                  </svg>
                </button>
              </th>
            <% }) %>
            <th class="text-right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% doctores.forEach((doctor) => { %>
            <tr>
              <td>
                <div class="person-cell">
                  <span class="avatar-circle"><%= initials(doctor.nombre, doctor.apellidos) %></span>
                  <div>
                    <div class="person-cell-name"><%= doctor.nombre %> <%= doctor.apellidos %></div>
                  </div>
                </div>
              </td>
              <td>
                <%
                // Pedido de estilo: más de 3 áreas colapsa a una sola
                // etiqueta "Varios" con tooltip (ver .area-tag-varios en
                // main.css) — listar las 6-7 áreas de un doctor con todas
                // asignadas desbordaba la celda y forzaba scroll horizontal
                // en la tabla (.lab-table-wrap tiene overflow-x:auto).
                const listaAreas = doctor.areas ? doctor.areas.split(', ') : [];
                %>
                <% if (listaAreas.length === 0) { %>
                  <span class="area-tag-empty">Sin área asignada</span>
                <% } else if (listaAreas.length > 3) { %>
                  <span class="area-tag area-tag-varios" data-tooltip="<%= listaAreas.join(', ') %>">Varias</span>
                <% } else { %>
                  <% listaAreas.forEach((area) => { %><span class="area-tag"><%= area %></span><% }) %>
                <% } %>
              </td>
              <td>
                <span class="status-badge<%= doctor.activo ? ' is-active' : '' %>"><%= doctor.activo ? 'Activo' : 'Inactivo' %></span>
              </td>
              <td class="text-right">
                <div class="row-actions">
                  <% if (has('doctores.editar')) { %>
                    <button class="row-action-btn row-action-edit" type="button" data-tooltip="Editar"
                            aria-label="Editar doctor <%= doctor.nombre %> <%= doctor.apellidos %>"
                            hx-get="doctores/<%= doctor.id %>/editar" hx-target="#doctorFormModalBody" hx-swap="innerHTML">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                      </svg>
                    </button>
                  <% } %>
                  <% if (has('doctores.eliminar') && doctor.activo) { %>
                    <button class="row-action-btn row-action-delete" type="button" data-tooltip="Eliminar"
                            aria-label="Dar de baja a <%= doctor.nombre %> <%= doctor.apellidos %>"
                            hx-delete="doctores/<%= doctor.id %>" hx-include="#doctores-filters"
                            hx-target="#doctores-panel" hx-swap="innerHTML"
                            hx-confirm='Favor de confirmar la eliminación del o de la Dr(a). <%= doctor.nombre %> <%= doctor.apellidos %>.&#10;No se elimina su historial de citas ni de laboratorio, solo deja de aparecer como doctor activo.'>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/>
                      </svg>
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (doctores.length === 0) { %>
        <p class="lab-empty">No hay resultados para tu búsqueda.</p>
      <% } %>

      <div class="table-footer">
        <span><%= doctores.length %> resultados · <%= total %> doctores en total</span>
        <% if (totalPages > 1) { %>
          <nav class="pagination" aria-label="Paginación">
            <button type="button" class="pagination-btn" aria-disabled="<%= page <= 1 %>" <%= page <= 1 ? 'disabled' : '' %>
                    hx-post="doctores.html" hx-include="#doctores-filters" hx-target="#doctores-panel"
                    hx-vals='{"page":<%= Math.max(1, page - 1) %>}' aria-label="Página anterior">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <% for (let p = 1; p <= totalPages; p++) { %>
              <button type="button" class="pagination-page<%= p === page ? ' current' : '' %>"
                      hx-post="doctores.html" hx-include="#doctores-filters" hx-target="#doctores-panel"
                      hx-vals='{"page":<%= p %>}'><%= p %></button>
            <% } %>
            <button type="button" class="pagination-btn" aria-disabled="<%= page >= totalPages %>" <%= page >= totalPages ? 'disabled' : '' %>
                    hx-post="doctores.html" hx-include="#doctores-filters" hx-target="#doctores-panel"
                    hx-vals='{"page":<%= Math.min(totalPages, page + 1) %>}' aria-label="Página siguiente">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </nav>
        <% } %>
      </div>
    </div>
  </form>
<% } %>
