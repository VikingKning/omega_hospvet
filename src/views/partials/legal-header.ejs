<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= descripcion %>">
  <title><%= titulo %> | OmegaVet</title>
  <link rel="icon" type="image/png" href="/assets/imgs/icon.png">
  <link rel="stylesheet" href="/css/legal.css">
</head>
<body>
  <% const legalInicioUrl = legalBasePath || '/'; %>
  <header class="legal-header">
    <div class="legal-shell legal-header-inner">
      <a class="legal-brand" href="<%= legalInicioUrl %>" aria-label="Inicio de información legal de OmegaVet">
        <img src="/assets/imgs/icon.png" alt="Logo de Omega Hospital Veterinario">
        <span>
          <strong>OmegaVet</strong>
          <small>Omega Hospital Veterinario</small>
        </span>
      </a>
      <nav class="legal-nav" aria-label="Información pública y legal">
        <a href="<%= legalInicioUrl %>" <% if (rutaActual === legalInicioUrl) { %>aria-current="page"<% } %>>Información</a>
        <a href="<%= legalBasePath %>/aviso-privacidad" <% if (rutaActual === `${legalBasePath}/aviso-privacidad`) { %>aria-current="page"<% } %>>Privacidad</a>
        <a href="<%= legalBasePath %>/terminos" <% if (rutaActual === `${legalBasePath}/terminos`) { %>aria-current="page"<% } %>>Términos</a>
        <a href="<%= legalBasePath %>/eliminacion-de-datos" <% if (rutaActual === `${legalBasePath}/eliminacion-de-datos`) { %>aria-current="page"<% } %>>Eliminar datos</a>
      </nav>
    </div>
  </header>
  <main>
