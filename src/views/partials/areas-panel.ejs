<%
// US-609: catálogo de áreas — mismo patrón que doctores-panel.ejs (tabla
// estándar del sistema). Solo lectura por ahora: los botones de alta/
// edición/baja son intencionalmente decorativos (AC de la historia).
const permissions = user?.permissions ?? [];
const has = (code) => permissions.includes(code);

function sortVals(column) {
  const nextDir = sort === column && dir === 'asc' ? 'desc' : 'asc';
  return JSON.stringify({ sort: column, dir: nextDir, page: 1 });
}
%>
<% if (catalogoVacio) { %>
  <div class="lab-table-wrap">
    <div class="empty-state-panel">
      <span class="empty-state-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
      </span>
      <p class="empty-state-title">Todavía no hay áreas registradas</p>
      <p class="empty-state-description">Da de alta la primera área de la clínica para que empiece a estar disponible al asignar doctores y agendar citas.</p>
      <% if (has('areas.crear')) { %>
        <button class="btn-primary" type="button"
                hx-get="areas/nuevo" hx-target="#areaFormModalBody" hx-swap="innerHTML">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          Registrar primera área
        </button>
      <% } %>
    </div>
  </div>
<% } else { %>
  <form id="areas-filters"
        hx-post="areas.html" hx-target="#areas-panel" hx-swap="innerHTML"
        hx-headers='{"x-csrf-token": "<%= csrfToken %>"}'
        hx-trigger="input changed delay:400ms from:#areas-search, submit"
        hx-vals='{"page":1}'>
    <input type="hidden" name="estado" value="<%= estado %>">
    <input type="hidden" name="sort" value="<%= sort %>">
    <input type="hidden" name="dir" value="<%= dir %>">
    <input type="hidden" name="page" value="<%= page %>">

    <div class="lab-toolbar">
      <div class="lab-toolbar-filters">
        <div class="lab-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <input type="text" id="areas-search" name="q" value="<%= q %>" placeholder="Buscar por nombre o slug...">
        </div>
        <div class="toggle-group">
          <button type="button" class="toggle-btn<%= estado === 'activos' ? ' active' : '' %>"
                  hx-post="areas.html" hx-include="#areas-filters" hx-target="#areas-panel"
                  hx-vals='{"estado":"activos","page":1}'>Activos</button>
          <button type="button" class="toggle-btn<%= estado === 'todos' ? ' active' : '' %>"
                  hx-post="areas.html" hx-include="#areas-filters" hx-target="#areas-panel"
                  hx-vals='{"estado":"todos","page":1}'>Todos</button>
        </div>
      </div>
      <% if (has('areas.crear')) { %>
        <button class="btn-primary" type="button"
                hx-get="areas/nuevo" hx-target="#areaFormModalBody" hx-swap="innerHTML">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          Nueva área
        </button>
      <% } %>
    </div>

    <div class="lab-table-wrap">
      <table class="lab-table">
        <thead>
          <tr>
            <th>Color</th>
            <% ['nombre', 'slug', 'estado'].forEach((column) => { %>
              <th class="sortable-th">
                <button type="button" class="sortable-th-link"
                        hx-post="areas.html" hx-include="#areas-filters" hx-target="#areas-panel"
                        hx-vals='<%- sortVals(column) %>'>
                  <%= { nombre: 'Nombre', slug: 'Agenda URL', estado: 'Estado' }[column] %>
                  <svg class="sort-arrow<%= sort === column ? ' active' : '' %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <% if (sort === column && dir === 'desc') { %>
                      <path d="M6 9l6 6 6-6"/>
                    <% } else { %>
                      <path d="M18 15l-6-6-6 6"/>
                    <% } %>
                  </svg>
                </button>
              </th>
            <% }) %>
            <th class="text-right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% areas.forEach((area) => { %>
            <tr>
              <td>
                <span class="color-swatch-dot<%= area.color.hex ? '' : ' color-swatch-dot-none' %>"
                      style="<%= area.color.hex ? `--swatch-color: ${area.color.hex};` : '' %>"
                      data-tooltip="<%= area.color.nombre %>" aria-label="Color: <%= area.color.nombre %>"></span>
              </td>
              <td><%= area.nombre %></td>
              <td><span class="area-tag-empty"><%= area.slug %></span></td>
              <td>
                <span class="status-badge<%= area.activo ? ' is-active' : '' %>"><%= area.activo ? 'Activo' : 'Inactivo' %></span>
              </td>
              <td class="text-right">
                <div class="row-actions">
                  <% if (has('areas.editar') && area.activo) { %>
                    <button class="row-action-btn row-action-edit" type="button" data-tooltip="Editar" aria-label="Editar área <%= area.nombre %>"
                            hx-get="areas/<%= area.id %>/editar" hx-target="#areaFormModalBody" hx-swap="innerHTML">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>
                      </svg>
                    </button>
                  <% } %>
                  <% if (has('areas.eliminar') && area.activo) { %>
                    <button class="row-action-btn row-action-delete" type="button" data-tooltip="Eliminar"
                            aria-label="Dar de baja el área <%= area.nombre %>"
                            hx-delete="areas/<%= area.id %>" hx-include="#areas-filters"
                            hx-target="#areas-panel" hx-swap="innerHTML"
                            hx-confirm="¿Dar de baja el área <%= area.nombre %>? Las citas históricas asociadas se conservan, solo deja de aparecer como área activa.">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/>
                      </svg>
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (areas.length === 0) { %>
        <p class="lab-empty">No hay resultados para tu búsqueda.</p>
      <% } %>

      <div class="table-footer">
        <span><%= areas.length %> resultados · <%= total %> áreas en total</span>
        <% if (totalPages > 1) { %>
          <nav class="pagination" aria-label="Paginación">
            <button type="button" class="pagination-btn" aria-disabled="<%= page <= 1 %>" <%= page <= 1 ? 'disabled' : '' %>
                    hx-post="areas.html" hx-include="#areas-filters" hx-target="#areas-panel"
                    hx-vals='{"page":<%= Math.max(1, page - 1) %>}' aria-label="Página anterior">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <% for (let p = 1; p <= totalPages; p++) { %>
              <button type="button" class="pagination-page<%= p === page ? ' current' : '' %>"
                      hx-post="areas.html" hx-include="#areas-filters" hx-target="#areas-panel"
                      hx-vals='{"page":<%= p %>}'><%= p %></button>
            <% } %>
            <button type="button" class="pagination-btn" aria-disabled="<%= page >= totalPages %>" <%= page >= totalPages ? 'disabled' : '' %>
                    hx-post="areas.html" hx-include="#areas-filters" hx-target="#areas-panel"
                    hx-vals='{"page":<%= Math.min(totalPages, page + 1) %>}' aria-label="Página siguiente">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </nav>
        <% } %>
      </div>
    </div>
  </form>
<% } %>
