<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%# La ruta anidada requiere una base explícita para los assets y enlaces relativos. %>
<base href="/">
<title><%= soloLectura ? 'Ver propietario' : (propietario ? 'Editar propietario' : 'Nuevo propietario') %> | Omega Hospital Veterinario</title>
<link rel="icon" type="image/png" href="assets/imgs/icon.png">
<link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="css/main.css">
</head>
<body>

  <%
  const esEdicion = Boolean(propietario);
  const conBusquedaTelefono = !esEdicion;
  const esSoloLectura = Boolean(soloLectura);
  %>

  <div class="app" id="app">
    <div class="top-row">
      <div class="sidebar-header">
        <img src="assets/imgs/icon.png" alt="Omega Hospital Veterinario">
        <span class="sidebar-title">Omega Vet</span>
        <button id="sidebarToggle" class="sidebar-toggle-btn" type="button" aria-label="Mostrar u ocultar menú">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>

      <header class="topbar">
        <span class="topbar-icon-badge">
          <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.5 4.05 3 5.5l7 7Z"/></svg>
        </span>
        <h1 class="topbar-title"><span class="topbar-breadcrumb-prefix">Tutores y Pacientes &rsaquo; Catálogo &rsaquo; </span><%= esSoloLectura ? 'Ver propietario' : (esEdicion ? 'Editar propietario' : 'Nuevo propietario') %></h1>
        <a class="topbar-user" href="mi-perfil.html">
          <span class="topbar-user-avatar avatar-color-<%= user.avatar %>">
            <img src="assets/imgs/<%= user.avatar %>.png" alt="">
          </span>
          <span class="topbar-user-name"><%= user.nombre %> <%= user.apellidos %></span>
        </a>
      </header>
    </div>

    <div class="body-row">
    <div class="nav-backdrop" id="navBackdrop"></div>
    <%- include('partials/sidebar', { user, currentPage: 'tutores' }) %>

    <main class="main-content">
      <div class="tutor-form-page">
        <div class="tutor-form-heading">
          <span class="tutor-form-heading-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          <div class="tutor-form-heading-text">
            <h2 id="tutorFormTitulo"><%= esSoloLectura ? 'Ver propietario' : (esEdicion ? 'Editar propietario' : 'Nuevo propietario') %></h2>
            <p>Capture la información del propietario y sus pacientes.</p>
          </div>
          <a class="btn-secondary" href="tutores.html">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Regresar al listado
          </a>
        </div>


        <div class="lab-form-scroll">
        <span class="form-error-banner" id="tutorFormError" style="display:none">
          <span id="tutorFormErrorText"></span>
          <button type="button" class="modal-close-btn" id="tutorFormErrorDismiss" aria-label="Cerrar mensaje">&times;</button>
        </span>
        <span class="form-success-banner" id="tutorFormSuccess" style="display:none"></span>


        <section class="profile-card">
          <h3 class="tutor-form-card-title">Información del propietario</h3>

          <div class="modal-form tutor-form-grid<%= esEdicion ? ' tutor-form-grid-con-estado' : '' %>">
            <label>
              Teléfono *


              <% if (conBusquedaTelefono) { %>
                <div class="combobox" id="tutorTelefonoCombobox">
                  <input type="text" id="tutorTelefono" placeholder="Ej. 5512345678" inputmode="numeric" autocomplete="off" pattern="(\d{2}-\d{4}-\d{4}|\d{3}-\d{3}-\d{4})" maxlength="12" title="Formato de teléfono en México: 10 dígitos (NN-NNNN-NNNN si inicia con 55/56, NNN-NNN-NNNN en otro caso)" value="">
                  <ul class="combobox-list" id="tutorTelefonoList" hidden></ul>
                </div>
              <% } else { %>
                <input type="text" id="tutorTelefono" placeholder="Ej. 5512345678" inputmode="numeric" autocomplete="off" pattern="(\d{2}-\d{4}-\d{4}|\d{3}-\d{3}-\d{4})" maxlength="12" title="Formato de teléfono en México: 10 dígitos (NN-NNNN-NNNN si inicia con 55/56, NNN-NNN-NNNN en otro caso)" value="<%= propietario?.telefono ?? '' %>" <%= esSoloLectura ? 'readonly disabled' : '' %>>
              <% } %>
              <span class="error-msg" id="tutorTelefonoError">El teléfono es obligatorio.</span>
            </label>
            <label>
              Nombre(s) *
              <input type="text" id="tutorNombre" maxlength="150" placeholder="Ej. Juan" value="<%= propietario?.nombre ?? '' %>" <%= esSoloLectura ? 'readonly disabled' : '' %>>
              <span class="error-msg" id="tutorNombreError">El nombre es obligatorio.</span>
            </label>
            <label>
              Apellidos *
              <input type="text" id="tutorApellidos" maxlength="150" placeholder="Ej. Pérez López" value="<%= propietario?.apellidos ?? '' %>" <%= esSoloLectura ? 'readonly disabled' : '' %>>
              <span class="error-msg" id="tutorApellidosError">Los apellidos son obligatorios.</span>
            </label>
            <label>
              Correo electrónico
              <input type="email" id="tutorCorreo" maxlength="150" placeholder="Ej. juan.perez@correo.com" value="<%= propietario?.correo ?? '' %>" <%= esSoloLectura ? 'readonly disabled' : '' %>>
            </label>


            <% if (esEdicion) { %>
              <label>
                Estado
                <span class="switch-field">
                  <span class="switch">
                    <input type="checkbox" id="tutorActivo" <%= propietario.activo ? 'checked' : '' %> <%= esSoloLectura ? 'disabled' : '' %>>
                    <span class="switch-track"></span>
                  </span>
                  <span class="switch-state-on">Activo</span>
                  <span class="switch-state-off">Inactivo</span>
                </span>
              </label>
            <% } %>
          </div>
          <p class="tutor-form-hint">* Campos obligatorios</p>
        </section>

        <section class="profile-card">
          <div class="tutor-pacientes-header">
            <h3 class="tutor-form-card-title" style="margin:0">Pacientes asociados</h3>

            <button class="btn-primary" type="button" id="agregarPacienteBtn" <%= esSoloLectura ? 'disabled' : '' %>>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
              Agregar paciente
            </button>
          </div>
          <div class="lab-table-wrap">
            <table class="lab-table tutor-pacientes-table">
              <thead>
                <tr>
                  <th>NHC</th>
                  <th>Especie</th>
                  <th>Nombre</th>
                  <th>Sexo</th>
                  <th>Edad</th>
                  <th>Raza</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody id="pacientesTableBody"></tbody>
            </table>
            <p class="lab-empty" id="pacientesEmpty" hidden>Todavía no hay pacientes agregados.</p>
          </div>
          <p class="tutor-form-hint">Puede agregar tantos pacientes como necesite antes de guardar.</p>
        </section>
        </div>

        <div class="tutor-form-actions">
          <a class="btn-secondary" href="tutores.html">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            Cancelar
          </a>
          <div class="tutor-form-actions-right">
            <button type="button" class="btn-secondary" id="guardarContinuarBtn" <%= esSoloLectura ? 'disabled' : '' %>>Guardar y continuar</button>
            <button type="button" class="btn-primary" id="guardarBtn" <%= esSoloLectura ? 'disabled' : '' %>>Guardar</button>
          </div>
        </div>
      </div>
    </main>
    </div>
  </div>

  <div class="modal-backdrop" id="reactivarModalBackdrop">
    <div class="modal-card">
      <div class="modal-header">
        <h2>¿Reactivar propietario existente?</h2>
        <button class="modal-close-btn" type="button" id="reactivarModalClose" aria-label="Cerrar">&times;</button>
      </div>
      <p>Ya existe un propietario <strong>inactivo</strong> registrado con este teléfono. Verifica que sea la misma persona antes de continuar — se cargará su información y sus pacientes en este formulario:</p>
      <p>
        <strong id="reactivarModalNombre"></strong><br>
        <span id="reactivarModalTelefono"></span>
      </p>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="reactivarModalCancel">Cancelar</button>
        <button type="button" class="btn-primary" id="reactivarModalConfirm">Reactivar</button>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="telefonoActivoModalBackdrop">
    <div class="modal-card">
      <div class="modal-header">
        <h2>Teléfono ya registrado</h2>
        <button class="modal-close-btn" type="button" id="telefonoActivoModalClose" aria-label="Cerrar">&times;</button>
      </div>
      <p>El teléfono ya está registrado por <strong id="telefonoActivoModalNombre"></strong>. ¿Desea editarlo?</p>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="telefonoActivoModalCancel">Cancelar</button>
        <button type="button" class="btn-primary" id="telefonoActivoModalConfirm">Editar</button>
      </div>
    </div>
  </div>


  <div id="tutorFormPacientesData" hidden><%- JSON.stringify(pacientes).replace(/</g, String.fromCharCode(92, 117, 48, 48, 51, 99)) %></div>

  <script src="js/sidebar.js" nonce="<%= cspNonce %>"></script>
  <script src="js/telefono.js" nonce="<%= cspNonce %>"></script>
  <script src="js/combobox.js" nonce="<%= cspNonce %>"></script>
  <script nonce="<%= cspNonce %>">
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text ?? '';
      return div.innerHTML;
    }

    const TELEFONO_REGEX = /^(\d{2}-\d{4}-\d{4}|\d{3}-\d{3}-\d{4})$/;


    let tutorId = <%- propietario ? propietario.id : 'null' %>;
    const SOLO_LECTURA = <%- esSoloLectura ? 'true' : 'false' %>;
    const csrfToken = '<%= csrfToken %>';
    const datosEl = document.getElementById('tutorFormPacientesData');
    let pacientes = datosEl ? JSON.parse(datosEl.textContent) : [];

    let reactivandoId = null;
    let telefonoVerificado = null;

    const tutorNombreInput = document.getElementById('tutorNombre');
    const tutorApellidosInput = document.getElementById('tutorApellidos');
    const tutorTelefonoInput = document.getElementById('tutorTelefono');
    const tutorCorreoInput = document.getElementById('tutorCorreo');
    const tutorActivoInput = document.getElementById('tutorActivo');
    const pacientesTableBody = document.getElementById('pacientesTableBody');
    const pacientesEmpty = document.getElementById('pacientesEmpty');
    const errorBanner = document.getElementById('tutorFormError');
    const successBanner = document.getElementById('tutorFormSuccess');

    const DOG_SVG =
      '<svg width="32" height="32" fill="currentColor" viewBox="0 0 640 640"><path d="M64 176C80.6 176 94.2 188.6 95.8 204.7L96.1 211.3C97.8 227.4 111.4 240 128 240L307.1 240L448 300.4L448 544C448 561.7 433.7 576 416 576L384 576C366.3 576 352 561.7 352 544L352 412.7C328 425 300.8 432 272 432C243.2 432 216 425 192 412.7L192 544C192 561.7 177.7 576 160 576L128 576C110.3 576 96 561.7 96 544L96 298.4C58.7 285.2 32 249.8 32 208C32 190.3 46.3 176 64 176zM387.8 32C395.5 32 402.7 35.6 407.4 41.8L424 64L476.1 64C488.8 64 501 69.1 510 78.1L528 96L584 96C597.3 96 608 106.7 608 120L608 144C608 188.2 572.2 224 528 224L464 224L457 252L332.3 198.6L363.9 51.4C366.3 40.1 376.2 32 387.8 32zM480 108C469 108 460 117 460 128C460 139 469 148 480 148C491 148 500 139 500 128C500 117 491 108 480 108z"/></svg>';
    const CAT_SVG =
      '<svg width="32" height="32" fill="currentColor" viewBox="0 0 640 640"><path d="M96 160C149 160 192 203 192 256L192 341.8C221.7 297.1 269.8 265.6 325.4 257.8C351 317.8 410.6 359.9 480 359.9C490.9 359.9 501.6 358.8 512 356.8L512 544C512 561.7 497.7 576 480 576C462.3 576 448 561.7 448 544L448 403.2L312 512L368 512C385.7 512 400 526.3 400 544C400 561.7 385.7 576 368 576L224 576C171 576 128 533 128 480L128 256C128 239.4 115.4 225.8 99.3 224.2L92.7 223.9C76.6 222.2 64 208.6 64 192C64 174.3 78.3 160 96 160zM565.8 67.2C576.2 58.5 592 65.9 592 79.5L592 192C592 253.9 541.9 304 480 304C418.1 304 368 253.9 368 192L368 79.5C368 65.9 383.8 58.5 394.2 67.2L448 112L512 112L565.8 67.2zM432 172C421 172 412 181 412 192C412 203 421 212 432 212C443 212 452 203 452 192C452 181 443 172 432 172zM528 172C517 172 508 181 508 192C508 203 517 212 528 212C539 212 548 203 548 192C548 181 539 172 528 172z"/></svg>';

    const MALE_SVG =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="14" r="6"/><path d="M14.5 9.5 20 4"/><path d="M15 4h5v5"/></svg>';
    const FEMALE_SVG =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M12 15v7"/><path d="M9 19h6"/></svg>';

    const CLOSE_SVG =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';

    function showError(message) {
      successBanner.style.display = 'none';
      document.getElementById('tutorFormErrorText').textContent = message;
      errorBanner.style.display = 'flex';
    }

    function hideBanners() {
      errorBanner.style.display = 'none';
      successBanner.style.display = 'none';
    }

    document.getElementById('tutorFormErrorDismiss').addEventListener('click', () => {
      errorBanner.style.display = 'none';
    });

    function showSuccess(message) {
      errorBanner.style.display = 'none';
      successBanner.textContent = message;
      successBanner.style.display = 'flex';
    }

    function renderPacientes() {
      pacientesEmpty.hidden = pacientes.length !== 0;

      pacientesTableBody.innerHTML = pacientes
        .map((paciente, index) => {
          const disabledAttr = SOLO_LECTURA ? 'disabled' : '';
          const tipoCell = `
            <div class="tipo-picker" role="group" aria-label="Tipo de mascota">
              <button type="button" class="tipo-picker-btn${paciente.tipo === 'Perro' ? ' active' : ''}" data-tipo="Perro" data-index="${index}" data-tooltip="Perro" aria-label="Perro" ${disabledAttr}>${DOG_SVG}</button>
              <button type="button" class="tipo-picker-btn${paciente.tipo === 'Gato' ? ' active' : ''}" data-tipo="Gato" data-index="${index}" data-tooltip="Gato" aria-label="Gato" ${disabledAttr}>${CAT_SVG}</button>
            </div>
          `;

          const sexoCell = `
            <div class="tipo-picker" role="group" aria-label="Sexo de la mascota">
              <button type="button" class="tipo-picker-btn paciente-sexo-btn${paciente.sexo === 'Macho' ? ' active' : ''}" data-sexo="Macho" data-index="${index}" data-tooltip="Macho" aria-label="Macho" ${disabledAttr}>${MALE_SVG}</button>
              <button type="button" class="tipo-picker-btn paciente-sexo-btn${paciente.sexo === 'Hembra' ? ' active' : ''}" data-sexo="Hembra" data-index="${index}" data-tooltip="Hembra" aria-label="Hembra" ${disabledAttr}>${FEMALE_SVG}</button>
            </div>
          `;

          const estadoCell = paciente.id
            ? `<label class="switch-field">
                 <span class="switch">
                   <input type="checkbox" class="paciente-activo-toggle" data-index="${index}" ${paciente.activo ? 'checked' : ''} ${disabledAttr}>
                   <span class="switch-track"></span>
                 </span>
                 <span class="switch-state-on">Activo</span>
                 <span class="switch-state-off">Inactivo</span>
               </label>`
            : `<button class="paciente-cancelar-btn" type="button" data-tooltip="Quitar" aria-label="Quitar paciente nuevo" data-index="${index}" ${disabledAttr}>${CLOSE_SVG}</button>`;

          return `
            <tr>
              <td><input type="text" class="paciente-input paciente-input-nhc" data-field="nhc" data-index="${index}" inputmode="numeric" maxlength="8" placeholder="Ej. 12345678" value="${paciente.nhc ?? ''}" ${disabledAttr}></td>
              <td>${tipoCell}</td>
              <td><input type="text" class="paciente-input paciente-input-nombre" data-field="nombre" data-index="${index}" maxlength="100" placeholder="Ej. Max" value="${escapeHtml(paciente.nombre)}" ${disabledAttr}></td>
              <td>${sexoCell}</td>
              <td><input type="number" class="paciente-input paciente-input-edad" data-field="edad" data-index="${index}" min="0" max="40" placeholder="Años" value="${paciente.edad ?? ''}" ${disabledAttr}></td>
              <td><input type="text" class="paciente-input paciente-input-raza" data-field="raza" data-index="${index}" maxlength="100" placeholder="Ej. Labrador" value="${escapeHtml(paciente.raza)}" ${disabledAttr}></td>
              <td>${estadoCell}</td>
            </tr>
          `;
        })
        .join('');
    }

    function aplicarDatosExistente(tutor) {
      tutorNombreInput.value = tutor.nombre;
      tutorNombreInput.classList.remove('invalid');
      document.getElementById('tutorNombreError').classList.remove('show');
      tutorApellidosInput.value = tutor.apellidos;
      tutorApellidosInput.classList.remove('invalid');
      document.getElementById('tutorApellidosError').classList.remove('show');
      tutorCorreoInput.value = tutor.correo || '';
      pacientes = tutor.pacientes.map((p) => ({
        id: p.id,
        nhc: p.nhc ?? '',
        nombre: p.nombre,
        tipo: p.tipo || '',
        raza: p.raza || '',
        sexo: p.sexo || '',
        edad: p.edad ?? '',
        activo: p.activo,
      }));
      renderPacientes();
    }

    function limpiarFormulario() {
      tutorNombreInput.value = '';
      tutorNombreInput.classList.remove('invalid');
      document.getElementById('tutorNombreError').classList.remove('show');
      tutorApellidosInput.value = '';
      tutorApellidosInput.classList.remove('invalid');
      document.getElementById('tutorApellidosError').classList.remove('show');
      tutorTelefonoInput.value = '';
      tutorTelefonoInput.classList.remove('invalid');
      document.getElementById('tutorTelefonoError').classList.remove('show');
      tutorCorreoInput.value = '';
      pacientes = [];
      reactivandoId = null;
      telefonoVerificado = null;
      renderPacientes();
    }

    document.getElementById('agregarPacienteBtn').addEventListener('click', () => {
      pacientes.push({ id: null, nhc: '', nombre: '', tipo: '', raza: '', sexo: '', edad: '', activo: true });
      renderPacientes();
      pacientesTableBody.querySelector('tr:last-child input[data-field="nhc"]')?.focus();
    });

    pacientesTableBody.addEventListener('input', (event) => {
      const field = event.target.dataset.field;
      if (!field) return;
      const index = Number(event.target.dataset.index);
      if (field === 'nhc') {
        event.target.value = event.target.value.replace(/\D/g, '').slice(0, 8);
      }
      pacientes[index][field] = event.target.value;
      if (field === 'nombre') event.target.classList.remove('invalid');
    });

    pacientesTableBody.addEventListener('change', (event) => {
      if (!event.target.classList.contains('paciente-activo-toggle')) return;
      const index = Number(event.target.dataset.index);
      pacientes[index].activo = event.target.checked;
    });

    pacientesTableBody.addEventListener('click', (event) => {
      const sexoBtn = event.target.closest('.paciente-sexo-btn');
      if (sexoBtn) {
        const index = Number(sexoBtn.dataset.index);
        pacientes[index].sexo = pacientes[index].sexo === sexoBtn.dataset.sexo ? '' : sexoBtn.dataset.sexo;
        renderPacientes();
        return;
      }

      const tipoBtn = event.target.closest('.tipo-picker-btn');
      if (tipoBtn) {
        const index = Number(tipoBtn.dataset.index);
        pacientes[index].tipo = tipoBtn.dataset.tipo;
        renderPacientes();
        return;
      }

      const cancelarBtn = event.target.closest('.paciente-cancelar-btn');
      if (cancelarBtn) {
        const index = Number(cancelarBtn.dataset.index);
        pacientes.splice(index, 1);
        renderPacientes();
      }
    });

    tutorNombreInput.addEventListener('input', () => {
      tutorNombreInput.classList.remove('invalid');
      document.getElementById('tutorNombreError').classList.remove('show');
    });

    tutorApellidosInput.addEventListener('input', () => {
      tutorApellidosInput.classList.remove('invalid');
      document.getElementById('tutorApellidosError').classList.remove('show');
    });

    tutorTelefonoInput.addEventListener('input', () => {
      const digitos = tutorTelefonoInput.value.replace(/\D/g, '').slice(0, 10);
      tutorTelefonoInput.value = formatearTelefono(digitos);
      tutorTelefonoInput.classList.remove('invalid');
      document.getElementById('tutorTelefonoError').classList.remove('show');
      reactivandoId = null;
      telefonoVerificado = null;
    });

    const tutorTelefonoCombobox = document.getElementById('tutorTelefonoCombobox');
    if (tutorTelefonoCombobox) {
      const tutorTelefonoList = document.getElementById('tutorTelefonoList');
      let telefonoBusquedaTimer = null;

      function ocultarTelefonoList() {
        tutorTelefonoList.hidden = true;
      }

      function renderTelefonoList(resultados) {
        if (!resultados.length) {
          ocultarTelefonoList();
          return;
        }
        tutorTelefonoList.innerHTML = resultados
          .map((r) => `<li class="combobox-item" data-id="${r.id}">${escapeHtml(r.nombre)} ${escapeHtml(r.apellidos)} — ${escapeHtml(r.telefono)}</li>`)
          .join('');
        tutorTelefonoList.hidden = false;
      }

      async function buscarTelefono(q) {
        const res = await fetch('tutores/buscar-telefono', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ q }),
        });
        if (res.redirected) {
          window.location.href = res.url;
          return;
        }
        if (!res.ok) return;
        renderTelefonoList(await res.json());
      }

      tutorTelefonoInput.addEventListener('input', () => {
        clearTimeout(telefonoBusquedaTimer);
        telefonoBusquedaTimer = setTimeout(() => buscarTelefono(tutorTelefonoInput.value), 400);
      });

      tutorTelefonoInput.addEventListener('focus', () => buscarTelefono(tutorTelefonoInput.value));

      tutorTelefonoList.addEventListener('click', (event) => {
        const item = event.target.closest('.combobox-item[data-id]');
        if (!item) return;
        event.preventDefault();
        window.location.href = `tutores/${item.dataset.id}/editar`;
      });

      document.addEventListener('click', (event) => {
        if (!tutorTelefonoCombobox.contains(event.target)) ocultarTelefonoList();
      });

      tutorTelefonoInput.addEventListener('blur', async () => {
        const valor = tutorTelefonoInput.value.trim();
        if (!TELEFONO_REGEX.test(valor) || valor === telefonoVerificado) return;

        const res = await fetch('tutores/verificar-telefono', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ telefono: valor }),
        });
        if (res.redirected) {
          window.location.href = res.url;
          return;
        }
        if (!res.ok) return;
        const data = await res.json();
        if (tutorTelefonoInput.value.trim() !== valor) return;
        telefonoVerificado = valor;
        if (!data.existe) return;

        if (data.activo) {
          const editar = await abrirTelefonoActivoModal(data.tutor);
          if (editar) window.location.href = `tutores/${data.tutor.id}/editar`;
          return;
        }

        const confirmado = await abrirReactivarModal(data.tutor);
        if (confirmado) {
          reactivandoId = data.tutor.id;
          aplicarDatosExistente(data.tutor);
        }
      });

      attachComboboxKeyboardNav(tutorTelefonoInput, tutorTelefonoList);
      attachComboboxClearButton(tutorTelefonoCombobox, tutorTelefonoInput, () => {
        tutorTelefonoInput.value = '';
        ocultarTelefonoList();
      });
    }

    function validarCliente() {
      let valido = true;
      if (!tutorNombreInput.value.trim()) {
        tutorNombreInput.classList.add('invalid');
        document.getElementById('tutorNombreError').classList.add('show');
        valido = false;
      }
      if (!tutorApellidosInput.value.trim()) {
        tutorApellidosInput.classList.add('invalid');
        document.getElementById('tutorApellidosError').classList.add('show');
        valido = false;
      }
      const tutorTelefonoError = document.getElementById('tutorTelefonoError');
      if (!tutorTelefonoInput.value.trim()) {
        tutorTelefonoInput.classList.add('invalid');
        tutorTelefonoError.textContent = 'El teléfono es obligatorio.';
        tutorTelefonoError.classList.add('show');
        valido = false;
      } else if (!TELEFONO_REGEX.test(tutorTelefonoInput.value.trim())) {
        tutorTelefonoInput.classList.add('invalid');
        tutorTelefonoError.textContent = 'El teléfono debe tener el formato NN-NNNN-NNNN o NNN-NNN-NNNN.';
        tutorTelefonoError.classList.add('show');
        valido = false;
      }
      pacientes.forEach((paciente, index) => {
        if (!paciente.nombre.trim()) {
          const input = pacientesTableBody.querySelector(`input[data-field="nombre"][data-index="${index}"]`);
          input?.classList.add('invalid');
          valido = false;
        }
      });
      return valido;
    }

    function construirBody(confirmarReactivacion) {
      return JSON.stringify({
        nombre: tutorNombreInput.value,
        apellidos: tutorApellidosInput.value,
        telefono: tutorTelefonoInput.value,
        correo: tutorCorreoInput.value,
        ...(tutorActivoInput ? { activo: tutorActivoInput.checked } : {}),
        pacientes: pacientes.map((p) => ({
          id: p.id,
          nhc: p.nhc,
          nombre: p.nombre,
          tipo: p.tipo,
          raza: p.raza,
          sexo: p.sexo,
          edad: p.edad,
          activo: p.activo,
        })),
        confirmarReactivacion: Boolean(confirmarReactivacion),
      });
    }

    const reactivarModalBackdrop = document.getElementById('reactivarModalBackdrop');
    let resolveReactivar = null;

    function abrirReactivarModal(tutorExistente) {
      document.getElementById('reactivarModalNombre').textContent = `${tutorExistente.nombre} ${tutorExistente.apellidos}`;
      document.getElementById('reactivarModalTelefono').textContent = tutorExistente.telefono;
      reactivarModalBackdrop.classList.add('open');
      return new Promise((resolve) => {
        resolveReactivar = resolve;
      });
    }

    function cerrarReactivarModal(resultado) {
      reactivarModalBackdrop.classList.remove('open');
      if (!resultado) limpiarFormulario();
      resolveReactivar?.(resultado);
      resolveReactivar = null;
    }

    document.getElementById('reactivarModalCancel').addEventListener('click', () => cerrarReactivarModal(false));
    document.getElementById('reactivarModalClose').addEventListener('click', () => cerrarReactivarModal(false));
    document.getElementById('reactivarModalConfirm').addEventListener('click', () => cerrarReactivarModal(true));
    reactivarModalBackdrop.addEventListener('click', (event) => {
      if (event.target === reactivarModalBackdrop) cerrarReactivarModal(false);
    });

    const telefonoActivoModalBackdrop = document.getElementById('telefonoActivoModalBackdrop');
    let resolveTelefonoActivo = null;

    function abrirTelefonoActivoModal(tutorExistente) {
      document.getElementById('telefonoActivoModalNombre').textContent = `${tutorExistente.nombre} ${tutorExistente.apellidos}`;
      telefonoActivoModalBackdrop.classList.add('open');
      return new Promise((resolve) => {
        resolveTelefonoActivo = resolve;
      });
    }

    function cerrarTelefonoActivoModal(resultado) {
      telefonoActivoModalBackdrop.classList.remove('open');
      if (!resultado) limpiarFormulario();
      resolveTelefonoActivo?.(resultado);
      resolveTelefonoActivo = null;
    }

    document.getElementById('telefonoActivoModalCancel').addEventListener('click', () => cerrarTelefonoActivoModal(false));
    document.getElementById('telefonoActivoModalClose').addEventListener('click', () => cerrarTelefonoActivoModal(false));
    document.getElementById('telefonoActivoModalConfirm').addEventListener('click', () => cerrarTelefonoActivoModal(true));
    telefonoActivoModalBackdrop.addEventListener('click', (event) => {
      if (event.target === telefonoActivoModalBackdrop) cerrarTelefonoActivoModal(false);
    });

    async function guardar({ continuar }) {
      hideBanners();
      if (!validarCliente()) return;

      let body = construirBody(Boolean(reactivandoId));
      let res = await fetch(tutorId ? `tutores/${tutorId}` : 'tutores', {
        method: tutorId ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body,
      });

      if (res.ok) {
        const data = await res.json();
        if (data.requiereConfirmacion) {
          const confirmado = await abrirReactivarModal(data.tutorExistente);
          if (!confirmado) return;
          body = construirBody(true);
          res = await fetch(tutorId ? `tutores/${tutorId}` : 'tutores', {
            method: tutorId ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
            body,
          });
        } else {
          return finalizarGuardado(data, continuar);
        }
      }

      if (res.redirected) {
        window.location.href = res.url;
        return;
      }

      const data = await res.json();
      if (!res.ok) {
        showError(data.error || 'No se pudo guardar el propietario.');
        return;
      }
      finalizarGuardado(data, continuar);
    }

    function finalizarGuardado(data, continuar) {
      reactivandoId = null;
      if (!continuar) {
        window.location.href = data.redirectTo;
        return;
      }
      tutorId = data.id;
      pacientes = data.propietario.pacientes;
      document.getElementById('tutorFormTitulo').textContent = 'Editar propietario';
      document.title = 'Editar propietario | Omega Hospital Veterinario';
      history.replaceState(null, '', `tutores/${tutorId}/editar`);
      renderPacientes();
      showSuccess('Propietario guardado correctamente.');
    }

    document.getElementById('guardarBtn').addEventListener('click', () => guardar({ continuar: false }));
    document.getElementById('guardarContinuarBtn').addEventListener('click', () => guardar({ continuar: true }));

    renderPacientes();
  </script>

</body>
</html>
