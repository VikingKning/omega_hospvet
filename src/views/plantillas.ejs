<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Plantillas de WhatsApp | Omega Veterinaria & Estética</title>
<link rel="icon" type="image/png" href="assets/imgs/icon.png">
<link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="css/main.css">
<script src="js/htmx.min.js"></script>
</head>
<body>

  <div class="app" id="app">
    <div class="top-row">
      <div class="sidebar-header">
        <img src="assets/imgs/icon.png" alt="Omega Veterinaria & Estética">
        <span class="sidebar-title">Omega Vet</span>
        <button id="sidebarToggle" class="sidebar-toggle-btn" type="button" aria-label="Mostrar u ocultar menú">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>

      <header class="topbar">
        <span class="topbar-icon-badge">
          <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </span>
        <h1 class="topbar-title">Catálogo de Plantillas de WhatsApp</h1>
      </header>
    </div>

    <div class="body-row">
    <div class="nav-backdrop" id="navBackdrop"></div>
    <%- include('partials/sidebar', { user, currentPage: 'plantillas' }) %>

    <main class="main-content" id="plantillas-panel">
      <%- include('partials/plantillas-panel', { plantillas, total, catalogoVacio, page, totalPages, pageSize, q, estado, sort, dir, user, csrfToken }) %>
    </main>
    </div>
  </div>

  <!--
    Modal de confirmación reutilizable para acciones destructivas de esta
    vista (por ahora solo "dar de baja", US-614). Vive fuera de
    #plantillas-panel a propósito: HTMX reemplaza ese contenedor en cada
    filtro/orden/página, y si el modal viviera adentro se destruiría a
    medio uso en cuanto la petición terminara. Mismo patrón que
    confirmModalBackdrop en doctores.ejs/areas.ejs.
  -->
  <div class="modal-backdrop" id="confirmModalBackdrop">
    <div class="modal-card">
      <div class="modal-header">
        <h2>Confirmar acción</h2>
        <button class="modal-close-btn" type="button" id="confirmModalClose" aria-label="Cerrar">&times;</button>
      </div>
      <p id="confirmModalMessage"></p>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="confirmModalCancel">Cancelar</button>
        <button type="button" class="btn-danger" id="confirmModalConfirm">Dar de baja</button>
      </div>
    </div>
  </div>

  <!--
    Modal de alta/edición (US-613): mismo formulario para las dos acciones,
    el contenido real lo llena HTMX (partials/plantilla-form.ejs) al hacer
    clic en el botón de alta del toolbar o en el ícono de editar de una
    fila — ver plantillas-panel.ejs. Vive fuera de #plantillas-panel: HTMX
    reemplaza ese contenedor en cada filtro/orden/página, y si el modal
    viviera adentro se destruiría a medio uso en cuanto la petición
    terminara (mismo patrón que areaFormModalBackdrop en areas.ejs).
  -->
  <div class="modal-backdrop" id="plantillaFormModalBackdrop">
    <div class="modal-card" id="plantillaFormModalBody"></div>
  </div>

<script>
  const sidebar = document.getElementById('sidebar');
  const app = document.querySelector('.app');
  const sidebarToggle = document.getElementById('sidebarToggle');
  const navBackdrop = document.getElementById('navBackdrop');

  sidebarToggle.addEventListener('click', () => {
    app.classList.toggle('sidebar-hidden');
    app.classList.toggle('mobile-menu-open');
  });

  navBackdrop.addEventListener('click', () => {
    app.classList.remove('sidebar-hidden');
    app.classList.remove('mobile-menu-open');
  });

  document.querySelectorAll('.nav-toggle').forEach((toggle) => {
    const submenu = document.getElementById(toggle.dataset.target);
    if (submenu.classList.contains('open')) {
      submenu.style.maxHeight = `${submenu.scrollHeight}px`;
    }

    toggle.addEventListener('click', () => {
      const isOpen = submenu.classList.contains('open');

      document.querySelectorAll('.submenu.open').forEach((open) => {
        if (open !== submenu) {
          open.classList.remove('open');
          open.style.maxHeight = null;
          open.previousElementSibling?.classList.remove('active');
        }
      });

      submenu.classList.toggle('open', !isOpen);
      toggle.classList.toggle('active', !isOpen);
      submenu.style.maxHeight = !isOpen ? `${submenu.scrollHeight}px` : null;
    });
  });

  // Modal de confirmación en vez del confirm() nativo del navegador (US-614)
  // — patrón documentado por HTMX (evento htmx:confirm +
  // evt.detail.issueRequest). Solo se intercepta cuando el elemento que
  // disparó la petición trae hx-confirm — así los demás triggers de esta
  // vista (buscar, ordenar, paginar) siguen sin pedir confirmación, como
  // hasta ahora.
  const confirmModalBackdrop = document.getElementById('confirmModalBackdrop');
  const confirmModalMessage = document.getElementById('confirmModalMessage');
  let resolveConfirm = null;

  function openConfirmModal(message) {
    confirmModalMessage.textContent = message;
    confirmModalBackdrop.classList.add('open');
    return new Promise((resolve) => {
      resolveConfirm = resolve;
    });
  }

  function closeConfirmModal(result) {
    confirmModalBackdrop.classList.remove('open');
    resolveConfirm?.(result);
    resolveConfirm = null;
  }

  document.getElementById('confirmModalCancel').addEventListener('click', () => closeConfirmModal(false));
  document.getElementById('confirmModalClose').addEventListener('click', () => closeConfirmModal(false));
  document.getElementById('confirmModalConfirm').addEventListener('click', () => closeConfirmModal(true));
  confirmModalBackdrop.addEventListener('click', (event) => {
    if (event.target === confirmModalBackdrop) closeConfirmModal(false);
  });

  document.body.addEventListener('htmx:confirm', (event) => {
    if (!event.target.hasAttribute('hx-confirm')) return;
    event.preventDefault();
    openConfirmModal(event.detail.question).then((confirmed) => {
      if (confirmed) event.detail.issueRequest(true);
    });
  });

  // Modal de alta/edición (US-613). El contenido de #plantillaFormModalBody
  // lo reemplaza HTMX en cada apertura/reintento, así que los botones de
  // adentro (cerrar, cancelar, cerrar el mensaje de error) se manejan por
  // delegación en el contenedor — un addEventListener directo sobre esos
  // botones se perdería en cuanto HTMX los vuelva a crear. Mismo patrón que
  // areaFormModalBody en areas.ejs.
  const plantillaFormModalBackdrop = document.getElementById('plantillaFormModalBackdrop');
  const plantillaFormModalBody = document.getElementById('plantillaFormModalBody');

  function openPlantillaFormModal() {
    plantillaFormModalBackdrop.classList.add('open');
  }

  function closePlantillaFormModal() {
    plantillaFormModalBackdrop.classList.remove('open');
  }

  document.body.addEventListener('htmx:afterSwap', (event) => {
    if (event.detail.target !== plantillaFormModalBody) return;
    // Si el fragmento trae un <form> (carga inicial, o reintento tras un
    // error de validación/intención duplicada) el modal debe quedar/seguir
    // abierto. La respuesta de éxito no trae form (solo el swap
    // out-of-band de la tabla) — en ese caso no hay nada que abrir, el
    // evento closePlantillaModal de abajo se encarga de cerrarlo.
    if (plantillaFormModalBody.querySelector('form')) openPlantillaFormModal();
  });

  plantillaFormModalBody.addEventListener('click', (event) => {
    if (event.target.closest('#plantillaFormClose, #plantillaFormCancel')) {
      closePlantillaFormModal();
    }
    if (event.target.closest('#plantillaFormErrorDismiss')) {
      event.target.closest('.form-error-banner')?.remove();
    }
  });

  plantillaFormModalBackdrop.addEventListener('click', (event) => {
    if (event.target === plantillaFormModalBackdrop) closePlantillaFormModal();
  });

  // HX-Trigger: closePlantillaModal (ver plantillas_whatsapp.controller.js,
  // renderExito()) — htmx traduce ese header en este evento personalizado.
  document.body.addEventListener('closePlantillaModal', closePlantillaFormModal);
</script>

</body>
</html>
