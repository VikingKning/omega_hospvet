<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Plantillas de WhatsApp | Omega Hospital Veterinario</title>
<link rel="icon" type="image/png" href="assets/imgs/icon.png">
<link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="css/main.css">
<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true}'>
<script src="js/htmx.min.js" nonce="<%= cspNonce %>"></script>
</head>
<body>

  <div class="app" id="app">
    <div class="top-row">
      <div class="sidebar-header">
        <img src="assets/imgs/icon.png" alt="Omega Hospital Veterinario">
        <span class="sidebar-title">Omega Vet</span>
        <button id="sidebarToggle" class="sidebar-toggle-btn" type="button" aria-label="Mostrar u ocultar menú">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>

      <header class="topbar">
        <span class="topbar-icon-badge">
          <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </span>
        <h1 class="topbar-title">Catálogo de Plantillas de WhatsApp</h1>
        <a class="topbar-user" href="mi-perfil.html">
          <span class="topbar-user-avatar avatar-color-<%= user.avatar %>">
            <img src="assets/imgs/<%= user.avatar %>.png" alt="">
          </span>
          <span class="topbar-user-name"><%= user.nombre %> <%= user.apellidos %></span>
        </a>
      </header>
    </div>

    <div class="body-row">
    <div class="nav-backdrop" id="navBackdrop"></div>
    <%- include('partials/sidebar', { user, currentPage: 'plantillas' }) %>

    <main class="main-content" id="plantillas-panel">
      <%- include('partials/plantillas-panel', { plantillas, total, catalogoVacio, page, totalPages, pageSize, q, estado, sort, dir, user, csrfToken }) %>
    </main>
    </div>
  </div>

  <%#
    Modal de confirmación reutilizable para acciones destructivas de esta
    vista (por ahora solo "dar de baja", US-614). Vive fuera de
    #plantillas-panel a propósito: HTMX reemplaza ese contenedor en cada
    filtro/orden/página, y si el modal viviera adentro se destruiría a
    medio uso en cuanto la petición terminara. Mismo patrón que
    confirmModalBackdrop en doctores.ejs/areas.ejs.
  %>
  <div class="modal-backdrop" id="confirmModalBackdrop">
    <div class="modal-card">
      <div class="modal-header">
        <h2>Confirmar acción</h2>
        <button class="modal-close-btn" type="button" id="confirmModalClose" aria-label="Cerrar">&times;</button>
      </div>
      <p id="confirmModalMessage"></p>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="confirmModalCancel">Cancelar</button>
        <button type="button" class="btn-danger" id="confirmModalConfirm">Dar de baja</button>
      </div>
    </div>
  </div>

  <%#
    Modal de alta/edición (US-613): mismo formulario para las dos acciones,
    el contenido real lo llena HTMX (partials/plantilla-form.ejs) al hacer
    clic en el botón de alta del toolbar o en el ícono de editar de una
    fila — ver plantillas-panel.ejs. Vive fuera de #plantillas-panel: HTMX
    reemplaza ese contenedor en cada filtro/orden/página, y si el modal
    viviera adentro se destruiría a medio uso en cuanto la petición
    terminara (mismo patrón que areaFormModalBackdrop en areas.ejs).
  %>
  <%#
    modal-card-wide (720px, ya usada en el resto del sistema): pedido
    explícito del usuario — el detalle/formulario de plantilla ahora se
    organiza en 2 columnas (ver partials/plantilla-detalle.ejs/
    plantilla-form.ejs), y en 1 columna se veía apretado.
  %>
  <div class="modal-backdrop" id="plantillaFormModalBackdrop">
    <div class="modal-card modal-card-wide" id="plantillaFormModalBody"></div>
  </div>

<script src="js/sidebar.js" nonce="<%= cspNonce %>"></script>
<script src="js/confirmModal.js" nonce="<%= cspNonce %>"></script>
<script nonce="<%= cspNonce %>">
  // Modal de alta/edición (US-613). El contenido de #plantillaFormModalBody
  // lo reemplaza HTMX en cada apertura/reintento, así que los botones de
  // adentro (cerrar, cancelar, cerrar el mensaje de error) se manejan por
  // delegación en el contenedor — un addEventListener directo sobre esos
  // botones se perdería en cuanto HTMX los vuelva a crear. Mismo patrón que
  // areaFormModalBody en areas.ejs.
  const plantillaFormModalBackdrop = document.getElementById('plantillaFormModalBackdrop');
  const plantillaFormModalBody = document.getElementById('plantillaFormModalBody');

  function openPlantillaFormModal() {
    plantillaFormModalBackdrop.classList.add('open');
  }

  function closePlantillaFormModal() {
    plantillaFormModalBackdrop.classList.remove('open');
    rangoEditorGuardado = null;
  }

  document.body.addEventListener('htmx:afterSwap', (event) => {
    if (event.detail.target !== plantillaFormModalBody) return;
    // Si el fragmento trae un <form> (carga inicial, o reintento tras un
    // error de validación/intención duplicada) el modal debe quedar/seguir
    // abierto. La respuesta de éxito no trae form (solo el swap
    // out-of-band de la tabla) — en ese caso no hay nada que abrir, el
    // evento closePlantillaModal de abajo se encarga de cerrarlo.
    if (plantillaFormModalBody.querySelector('form')) {
      openPlantillaFormModal();
      inicializarEditorPlantilla();
      inicializarVistaPreviaWhatsapp();
    }
  });

  // ---- Editor visual del texto de respuesta (pedido explícito del
  // usuario: "que se vea negritas ya en el textbox... lo guardas con el
  // formato para que whatsapp de ese formato") ----
  // #plantillaTextoEditor es un contenteditable que MUESTRA el formato
  // aplicado (negrita se ve en negritas, etc.); #plantillaTextoRespuesta
  // (oculto) es el <textarea> real que viaja en el submit, siempre con la
  // sintaxis de texto plano de WhatsApp (*negrita*, _cursiva_, etc.) —
  // nunca HTML. La barra ofrece negrita, cursiva, tachado, monoespaciado,
  // lista con viñetas, lista numerada, cita y emoticonos. Se conserva el
  // parseo de `código` para mostrar correctamente plantillas antiguas,
  // aunque ya no se ofrece como control de edición.
  const CODE_A_MARCADOR = { 'wa-mono': '```', 'wa-code': '`' };
  const ETIQUETA_A_MARCADOR_INLINE = { STRONG: '*', B: '*', EM: '_', I: '_', S: '~', STRIKE: '~', DEL: '~' };

  // Escapa HTML antes de insertar texto plano como innerHTML — necesario
  // porque el texto guardado es texto plano de verdad (puede traer < > &
  // sueltos) y este editor jamás debe interpretarlo como marcado.
  function escaparHtml(texto) {
    const div = document.createElement('div');
    div.textContent = texto;
    return div.innerHTML;
  }

  // Convierte el marcado inline de UNA línea (*negrita*, _cursiva_,
  // ~tachado~, ```mono```, `código`) a HTML — deliberadamente sin soportar
  // combinaciones anidadas (ej. negrita+cursiva a la vez): cubre el caso
  // real de una plantilla de respuesta corta, sin la complejidad de un
  // parser de Markdown completo. El orden importa: monoespaciado (```)
  // ANTES que código en línea (`), si no el regex de código en línea
  // partiría los marcadores triples a la mitad.
  function parsearInlineWhatsapp(texto) {
    let html = escaparHtml(texto);
    html = html.replace(/```([^`]+)```/g, '<code class="wa-mono">$1</code>');
    html = html.replace(/`([^`]+)`/g, '<code class="wa-code">$1</code>');
    // Los límites evitan interpretar como cursiva nombres técnicos como
    // resultados_laboratorio_listos_v2 o fragmentos similares de una URL.
    const limiteInicial = '(^|[\\s\\(\\[\\{>"\'¿¡])';
    const limiteFinal = '(?=$|[\\s\\)\\]\\}<"\'.,!?;:])';
    html = html.replace(new RegExp(`${limiteInicial}\\*([^*]+)\\*${limiteFinal}`, 'g'), '$1<strong>$2</strong>');
    html = html.replace(new RegExp(`${limiteInicial}_([^_]+)_${limiteFinal}`, 'g'), '$1<em>$2</em>');
    html = html.replace(new RegExp(`${limiteInicial}~([^~]+)~${limiteFinal}`, 'g'), '$1<s>$2</s>');
    return html;
  }

  // Texto plano (con la sintaxis real de WhatsApp) -> HTML del editor.
  // Agrupa renglones consecutivos de lista. Las citas se conservan como
  // bloques independientes para poder activar o desactivar sólo el renglón
  // señalado por el cursor durante una edición posterior.
  function parsearWhatsapp(texto) {
    const lineas = (texto ?? '').split('\n');
    const bloques = [];
    let grupoActual = null;

    function cerrarGrupo() {
      if (grupoActual) bloques.push(grupoActual);
      grupoActual = null;
    }

    lineas.forEach((linea) => {
      const bullet = /^[-*] (.*)$/.exec(linea);
      const numerada = /^\d+\. (.*)$/.exec(linea);
      const cita = /^> (.*)$/.exec(linea);

      if (bullet) {
        if (!grupoActual || grupoActual.tipo !== 'ul') {
          cerrarGrupo();
          grupoActual = { tipo: 'ul', lineas: [] };
        }
        grupoActual.lineas.push(bullet[1]);
      } else if (numerada) {
        if (!grupoActual || grupoActual.tipo !== 'ol') {
          cerrarGrupo();
          grupoActual = { tipo: 'ol', lineas: [] };
        }
        grupoActual.lineas.push(numerada[1]);
      } else if (cita) {
        cerrarGrupo();
        bloques.push({ tipo: 'quote', lineas: [cita[1]] });
      } else {
        cerrarGrupo();
        bloques.push({ tipo: 'linea', lineas: [linea] });
      }
    });
    cerrarGrupo();

    return bloques
      .map((bloque) => {
        if (bloque.tipo === 'ul') {
          return `<ul>${bloque.lineas.map((l) => `<li>${parsearInlineWhatsapp(l)}</li>`).join('')}</ul>`;
        }
        if (bloque.tipo === 'ol') {
          return `<ol>${bloque.lineas.map((l) => `<li>${parsearInlineWhatsapp(l)}</li>`).join('')}</ol>`;
        }
        if (bloque.tipo === 'quote') {
          return `<blockquote>${bloque.lineas.map(parsearInlineWhatsapp).join('<br>')}</blockquote>`;
        }
        const contenido = parsearInlineWhatsapp(bloque.lineas[0]);
        return `<div>${contenido || '<br>'}</div>`;
      })
      .join('');
  }

  // HTML del editor -> texto plano con la sintaxis real de WhatsApp
  // (exactamente el inverso de parsearWhatsapp/parsearInlineWhatsapp).
  function serializarNodoInline(nodo) {
    if (nodo.nodeType === Node.TEXT_NODE) return nodo.textContent;
    if (nodo.nodeName === 'BR') return '\n';
    if (nodo.nodeName === 'CODE') {
      const marcador = CODE_A_MARCADOR[nodo.className] || '`';
      return `${marcador}${nodo.textContent}${marcador}`;
    }
    if (ETIQUETA_A_MARCADOR_INLINE[nodo.nodeName]) {
      const marcador = ETIQUETA_A_MARCADOR_INLINE[nodo.nodeName];
      return `${marcador}${serializarInline(nodo)}${marcador}`;
    }
    // Cualquier otra etiqueta que el navegador haya metido sola
    // (ej. un <span> al pegar texto de otro lado) se "desenvuelve":
    // se conserva el texto, se ignora la etiqueta desconocida.
    return serializarInline(nodo);
  }

  function serializarInline(nodo) {
    return Array.from(nodo.childNodes).map(serializarNodoInline).join('');
  }

  function serializarWhatsappEditor(editor) {
    const lineas = [];
    let inlineEnRaiz = '';

    function vaciarInlineEnRaiz() {
      if (!inlineEnRaiz) return;
      lineas.push(inlineEnRaiz);
      inlineEnRaiz = '';
    }

    Array.from(editor.childNodes).forEach((nodo) => {
      if (nodo.nodeName === 'UL') {
        vaciarInlineEnRaiz();
        Array.from(nodo.children).forEach((li) => lineas.push(`- ${serializarInline(li)}`));
      } else if (nodo.nodeName === 'OL') {
        vaciarInlineEnRaiz();
        Array.from(nodo.children).forEach((li, indice) => lineas.push(`${indice + 1}. ${serializarInline(li)}`));
      } else if (nodo.nodeName === 'BLOCKQUOTE') {
        vaciarInlineEnRaiz();
        lineas.push(
          serializarInline(nodo)
            .split('\n')
            .map((linea) => `> ${linea}`)
            .join('\n'),
        );
      } else if (nodo.nodeName === 'DIV' || nodo.nodeName === 'P') {
        vaciarInlineEnRaiz();
        const esRenglonVacio = nodo.childNodes.length === 1 && nodo.firstChild.nodeName === 'BR';
        lineas.push(esRenglonVacio ? '' : serializarInline(nodo));
      } else {
        // El navegador puede dejar texto y etiquetas inline (B/EM/CODE)
        // como hermanos directos del editor. Deben formar UNA sola línea,
        // no una línea nueva por cada fragmento formateado.
        inlineEnRaiz += serializarNodoInline(nodo);
      }
    });
    vaciarInlineEnRaiz();
    return lineas.join('\n');
  }

  // Los botones de la barra viven fuera del contenteditable. Al hacer clic,
  // el navegador puede mover el foco y perder el rango que el usuario había
  // seleccionado. Se conserva una copia del último rango válido para que
  // cada comando actúe exactamente sobre esa selección o línea.
  const TEXTO_RESPUESTA_MAX_LENGTH = 550;
  const estadoValidoPorEditor = new WeakMap();
  let rangoEditorGuardado = null;

  function guardarRangoEditor(editor) {
    const seleccion = window.getSelection();
    if (!seleccion || seleccion.rangeCount === 0) return;
    const rango = seleccion.getRangeAt(0);
    if (editor.contains(rango.commonAncestorContainer)) {
      rangoEditorGuardado = rango.cloneRange();
    }
  }

  function restaurarRangoEditor(editor) {
    // Conserva una copia ANTES de devolver el foco: el evento focus del
    // editor puede crear una selección nueva y no debe reemplazar la
    // posición donde el usuario estaba escribiendo.
    const rangoAnterior =
      rangoEditorGuardado && editor.contains(rangoEditorGuardado.commonAncestorContainer)
        ? rangoEditorGuardado.cloneRange()
        : null;
    editor.focus();
    const seleccion = window.getSelection();
    if (!seleccion) return false;
    if (rangoAnterior) {
      seleccion.removeAllRanges();
      seleccion.addRange(rangoAnterior);
      return true;
    }
    const rango = document.createRange();
    rango.selectNodeContents(editor);
    rango.collapse(false);
    seleccion.removeAllRanges();
    seleccion.addRange(rango);
    return true;
  }

  function colocarCursorAlFinal(editor) {
    const seleccion = window.getSelection();
    if (!seleccion) return;
    const rango = document.createRange();
    rango.selectNodeContents(editor);
    rango.collapse(false);
    seleccion.removeAllRanges();
    seleccion.addRange(rango);
    guardarRangoEditor(editor);
  }

  function actualizarContadorEditor(texto) {
    const contador = document.getElementById('plantillaEditorCounter');
    if (!contador) return;
    const restantes = TEXTO_RESPUESTA_MAX_LENGTH - Array.from(texto).length;
    contador.textContent =
      restantes >= 0
        ? `${restantes} caracteres disponibles`
        : `Excede por ${Math.abs(restantes)} caracteres`;
    contador.classList.toggle('is-near-limit', restantes <= 25);
    contador.classList.toggle('is-over-limit', restantes < 0);
  }

  function sincronizarEditor(editor, mostrarError = false) {
    const textareaOculto = document.getElementById('plantillaTextoRespuesta');
    if (!textareaOculto) return false;
    const textoNuevo = serializarWhatsappEditor(editor).replace(/\u200B/g, '');
    const longitudNueva = Array.from(textoNuevo).length;
    const estadoAnterior = estadoValidoPorEditor.get(editor);

    // Si una escritura, pegado o formato rebasa el límite, se restaura el
    // último estado válido. Los marcadores (*, _, ~, ``` y prefijos de
    // listas/citas) forman parte del texto enviado y también se cuentan.
    if (
      estadoAnterior &&
      longitudNueva > TEXTO_RESPUESTA_MAX_LENGTH &&
      longitudNueva >= estadoAnterior.longitud
    ) {
      editor.innerHTML = estadoAnterior.html;
      textareaOculto.value = estadoAnterior.texto;
      actualizarContadorEditor(estadoAnterior.texto);
      colocarCursorAlFinal(editor);
      return false;
    }

    textareaOculto.value = textoNuevo;
    estadoValidoPorEditor.set(editor, {
      html: editor.innerHTML,
      texto: textoNuevo,
      longitud: longitudNueva,
    });
    actualizarContadorEditor(textoNuevo);
    const vacio = !textareaOculto.value.trim();
    const excedido = longitudNueva > TEXTO_RESPUESTA_MAX_LENGTH;
    const error = document.getElementById('plantillaEditorError');
    if (!vacio || mostrarError) {
      editor.toggleAttribute('aria-invalid', vacio || excedido);
      error?.toggleAttribute('hidden', !vacio);
    }
    return !vacio && !excedido;
  }

  function ejecutarComandoEditor(editor, comando, valor = null) {
    restaurarRangoEditor(editor);
    document.execCommand(comando, false, valor);
    guardarRangoEditor(editor);
    sincronizarEditor(editor);
  }

  function ancestroDentroDelEditor(editor, nodo, selector) {
    let actual = nodo?.nodeType === Node.ELEMENT_NODE ? nodo : nodo?.parentElement;
    while (actual && actual !== editor) {
      if (actual.matches?.(selector)) return actual;
      actual = actual.parentElement;
    }
    return null;
  }

  function bloqueSuperiorEditor(editor, nodo) {
    let actual = nodo?.nodeType === Node.ELEMENT_NODE ? nodo : nodo?.parentElement;
    while (actual && actual.parentElement !== editor) actual = actual.parentElement;
    return actual?.parentElement === editor ? actual : null;
  }

  function alternarCodigo(editor, className) {
    restaurarRangoEditor(editor);
    const seleccion = window.getSelection();
    if (!seleccion || seleccion.rangeCount === 0) return;
    const rango = seleccion.getRangeAt(0);
    const codigoExistente = ancestroDentroDelEditor(editor, rango.commonAncestorContainer, `code.${className}`);
    if (codigoExistente) {
      codigoExistente.replaceWith(...codigoExistente.childNodes);
    } else {
      const codigo = document.createElement('code');
      codigo.className = className;
      const contenido = rango.extractContents();
      codigo.appendChild(contenido);
      if (!codigo.textContent) codigo.appendChild(document.createTextNode('\u200B'));
      rango.insertNode(codigo);
      const nuevoRango = document.createRange();
      nuevoRango.selectNodeContents(codigo);
      nuevoRango.collapse(false);
      seleccion.removeAllRanges();
      seleccion.addRange(nuevoRango);
    }
    guardarRangoEditor(editor);
    sincronizarEditor(editor);
  }

  function alternarCita(editor) {
    restaurarRangoEditor(editor);
    const seleccion = window.getSelection();
    if (!seleccion || seleccion.rangeCount === 0) return;
    const rango = seleccion.getRangeAt(0);

    let bloques;
    if (rango.collapsed) {
      bloques = [bloqueSuperiorEditor(editor, rango.startContainer)].filter(Boolean);
    } else {
      bloques = Array.from(editor.children).filter(
        (nodo) => ['DIV', 'P', 'BLOCKQUOTE'].includes(nodo.nodeName) && rango.intersectsNode(nodo),
      );
    }

    // Si el navegador dejó texto directo en la raíz, formatBlock sirve de
    // respaldo. Normalmente cada renglón ya es DIV/P por la inicialización
    // del editor, por lo que nunca se toca contenido fuera de la selección.
    if (!bloques.length) {
      ejecutarComandoEditor(editor, 'formatBlock', 'blockquote');
      return;
    }

    const convertirACita = !bloques.every((bloque) => bloque.nodeName === 'BLOCKQUOTE');

    // Una selección parcial dentro de un solo renglón se separa en tres
    // bloques: texto anterior, fragmento citado y texto posterior. Esto es
    // necesario porque WhatsApp representa una cita al inicio de su propio
    // renglón (`> texto`); envolverla inline produciría un formato inválido.
    if (!rango.collapsed && bloques.length === 1) {
      const bloque = bloques[0];
      const bloqueInicio = bloqueSuperiorEditor(editor, rango.startContainer);
      const bloqueFin = bloqueSuperiorEditor(editor, rango.endContainer);
      if (bloque === bloqueInicio && bloque === bloqueFin) {
        const rangoAntes = document.createRange();
        rangoAntes.selectNodeContents(bloque);
        rangoAntes.setEnd(rango.startContainer, rango.startOffset);
        const rangoDespues = document.createRange();
        rangoDespues.selectNodeContents(bloque);
        rangoDespues.setStart(rango.endContainer, rango.endOffset);

        const partes = [
          { fragmento: rangoAntes.cloneContents(), etiqueta: bloque.nodeName.toLowerCase() },
          { fragmento: rango.cloneContents(), etiqueta: convertirACita ? 'blockquote' : 'div', seleccionada: true },
          { fragmento: rangoDespues.cloneContents(), etiqueta: bloque.nodeName.toLowerCase() },
        ];
        const reemplazos = partes
          .filter(({ fragmento, seleccionada }) => seleccionada || fragmento.textContent || fragmento.querySelector?.('br'))
          .map(({ fragmento, etiqueta, seleccionada }) => {
            const elemento = document.createElement(etiqueta);
            elemento.appendChild(fragmento);
            return { elemento, seleccionada };
          });
        bloque.replaceWith(...reemplazos.map(({ elemento }) => elemento));
        const bloqueSeleccionado = reemplazos.find(({ seleccionada }) => seleccionada).elemento;
        const nuevoRango = document.createRange();
        nuevoRango.selectNodeContents(bloqueSeleccionado);
        seleccion.removeAllRanges();
        seleccion.addRange(nuevoRango);
        guardarRangoEditor(editor);
        sincronizarEditor(editor);
        return;
      }
    }

    let ultimoBloque = bloques[bloques.length - 1];
    bloques.forEach((bloque) => {
      const yaEsCita = bloque.nodeName === 'BLOCKQUOTE';
      if (yaEsCita === convertirACita) return;
      const reemplazo = document.createElement(convertirACita ? 'blockquote' : 'div');
      reemplazo.append(...bloque.childNodes);
      bloque.replaceWith(reemplazo);
      if (bloque === ultimoBloque) ultimoBloque = reemplazo;
    });

    const nuevoRango = document.createRange();
    nuevoRango.selectNodeContents(ultimoBloque);
    nuevoRango.collapse(false);
    seleccion.removeAllRanges();
    seleccion.addRange(nuevoRango);
    guardarRangoEditor(editor);
    sincronizarEditor(editor);
  }

  function alternarLista(editor, tipoLista) {
    restaurarRangoEditor(editor);
    const seleccion = window.getSelection();
    if (!seleccion || seleccion.rangeCount === 0) return;
    const rango = seleccion.getRangeAt(0);
    const bloqueInicio = bloqueSuperiorEditor(editor, rango.startContainer);
    const bloqueFin = bloqueSuperiorEditor(editor, rango.endContainer);

    // Cursor o selección dentro de una lista existente: se separan sólo
    // los LI alcanzados. Los elementos anteriores y posteriores continúan
    // en sus listas originales.
    if (bloqueInicio && bloqueInicio === bloqueFin && ['UL', 'OL'].includes(bloqueInicio.nodeName)) {
      const listaOriginal = bloqueInicio;
      const items = Array.from(listaOriginal.children);
      const seleccionados = rango.collapsed
        ? [ancestroDentroDelEditor(editor, rango.startContainer, 'li')].filter(Boolean)
        : items.filter((item) => rango.intersectsNode(item));
      if (!seleccionados.length) return;

      const primerIndice = items.indexOf(seleccionados[0]);
      const ultimoIndice = items.indexOf(seleccionados[seleccionados.length - 1]);
      const reemplazos = [];

      function agregarLista(etiqueta, elementos) {
        if (!elementos.length) return;
        const lista = document.createElement(etiqueta);
        lista.append(...elementos);
        reemplazos.push(lista);
      }

      const itemInicio = ancestroDentroDelEditor(editor, rango.startContainer, 'li');
      const itemFin = ancestroDentroDelEditor(editor, rango.endContainer, 'li');
      if (!rango.collapsed && seleccionados.length === 1 && itemInicio === itemFin) {
        const itemOriginal = seleccionados[0];
        const rangoAntes = document.createRange();
        rangoAntes.selectNodeContents(itemOriginal);
        rangoAntes.setEnd(rango.startContainer, rango.startOffset);
        const rangoDespues = document.createRange();
        rangoDespues.selectNodeContents(itemOriginal);
        rangoDespues.setStart(rango.endContainer, rango.endOffset);
        const antes = rangoAntes.cloneContents();
        const contenidoSeleccionado = rango.cloneContents();
        const despues = rangoDespues.cloneContents();
        const itemsAnteriores = items.slice(0, primerIndice);
        const itemsPosteriores = items.slice(ultimoIndice + 1);
        if (antes.textContent || antes.querySelector?.('br')) {
          const itemAntes = document.createElement('li');
          itemAntes.appendChild(antes);
          itemsAnteriores.push(itemAntes);
        }
        if (despues.textContent || despues.querySelector?.('br')) {
          const itemDespues = document.createElement('li');
          itemDespues.appendChild(despues);
          itemsPosteriores.unshift(itemDespues);
        }
        agregarLista(listaOriginal.nodeName.toLowerCase(), itemsAnteriores);
        let destinoSeleccionado;
        if (listaOriginal.nodeName.toLowerCase() === tipoLista) {
          destinoSeleccionado = document.createElement('div');
          destinoSeleccionado.appendChild(contenidoSeleccionado);
          reemplazos.push(destinoSeleccionado);
        } else {
          destinoSeleccionado = document.createElement(tipoLista);
          const item = document.createElement('li');
          item.appendChild(contenidoSeleccionado);
          destinoSeleccionado.appendChild(item);
          reemplazos.push(destinoSeleccionado);
        }
        agregarLista(listaOriginal.nodeName.toLowerCase(), itemsPosteriores);
        listaOriginal.replaceWith(...reemplazos);

        const nuevoRango = document.createRange();
        nuevoRango.selectNodeContents(destinoSeleccionado);
        nuevoRango.collapse(false);
        seleccion.removeAllRanges();
        seleccion.addRange(nuevoRango);
        guardarRangoEditor(editor);
        sincronizarEditor(editor);
        return;
      }

      agregarLista(listaOriginal.nodeName.toLowerCase(), items.slice(0, primerIndice));
      let destinoSeleccionado;
      if (listaOriginal.nodeName.toLowerCase() === tipoLista) {
        // Pulsar otra vez el mismo botón quita la lista sólo a los items
        // seleccionados; cada uno vuelve a ser un renglón normal.
        seleccionados.forEach((item) => {
          const renglon = document.createElement('div');
          renglon.append(...item.childNodes);
          reemplazos.push(renglon);
          destinoSeleccionado = renglon;
        });
      } else {
        destinoSeleccionado = document.createElement(tipoLista);
        destinoSeleccionado.append(...seleccionados);
        reemplazos.push(destinoSeleccionado);
      }
      agregarLista(listaOriginal.nodeName.toLowerCase(), items.slice(ultimoIndice + 1));
      listaOriginal.replaceWith(...reemplazos);

      const nuevoRango = document.createRange();
      nuevoRango.selectNodeContents(destinoSeleccionado);
      nuevoRango.collapse(false);
      seleccion.removeAllRanges();
      seleccion.addRange(nuevoRango);
      guardarRangoEditor(editor);
      sincronizarEditor(editor);
      return;
    }

    const bloques = rango.collapsed
      ? [bloqueInicio].filter((bloque) => bloque && ['DIV', 'P', 'BLOCKQUOTE'].includes(bloque.nodeName))
      : Array.from(editor.children).filter(
          (bloque) => ['DIV', 'P', 'BLOCKQUOTE'].includes(bloque.nodeName) && rango.intersectsNode(bloque),
        );

    if (!bloques.length) return;

    // Selección parcial de un solo renglón: texto anterior y posterior se
    // mantienen normales; únicamente la selección se convierte en LI.
    if (!rango.collapsed && bloques.length === 1 && bloqueInicio === bloqueFin) {
      const bloque = bloques[0];
      const rangoAntes = document.createRange();
      rangoAntes.selectNodeContents(bloque);
      rangoAntes.setEnd(rango.startContainer, rango.startOffset);
      const rangoDespues = document.createRange();
      rangoDespues.selectNodeContents(bloque);
      rangoDespues.setStart(rango.endContainer, rango.endOffset);

      const antes = rangoAntes.cloneContents();
      const contenidoItem = rango.cloneContents();
      const despues = rangoDespues.cloneContents();
      const reemplazos = [];
      if (antes.textContent || antes.querySelector?.('br')) {
        const renglonAntes = document.createElement(bloque.nodeName.toLowerCase());
        renglonAntes.appendChild(antes);
        reemplazos.push(renglonAntes);
      }
      const lista = document.createElement(tipoLista);
      const item = document.createElement('li');
      item.appendChild(contenidoItem);
      lista.appendChild(item);
      reemplazos.push(lista);
      if (despues.textContent || despues.querySelector?.('br')) {
        const renglonDespues = document.createElement(bloque.nodeName.toLowerCase());
        renglonDespues.appendChild(despues);
        reemplazos.push(renglonDespues);
      }
      bloque.replaceWith(...reemplazos);

      const nuevoRango = document.createRange();
      nuevoRango.selectNodeContents(item);
      seleccion.removeAllRanges();
      seleccion.addRange(nuevoRango);
      guardarRangoEditor(editor);
      sincronizarEditor(editor);
      return;
    }

    // Cursor o varios renglones seleccionados: sólo esos bloques pasan a
    // ser elementos de una lista común.
    const lista = document.createElement(tipoLista);
    bloques.forEach((bloque) => {
      const item = document.createElement('li');
      item.append(...bloque.childNodes);
      lista.appendChild(item);
    });
    bloques[0].replaceWith(lista);
    bloques.slice(1).forEach((bloque) => bloque.remove());
    const nuevoRango = document.createRange();
    nuevoRango.selectNodeContents(lista.lastElementChild);
    nuevoRango.collapse(false);
    seleccion.removeAllRanges();
    seleccion.addRange(nuevoRango);
    guardarRangoEditor(editor);
    sincronizarEditor(editor);
  }

  function inicializarVistaPreviaWhatsapp() {
    const vistaPrevia = plantillaFormModalBody.querySelector('[data-whatsapp-preview]');
    const origen = plantillaFormModalBody.querySelector('[data-whatsapp-preview-source]');
    if (!vistaPrevia || !origen) return;
    vistaPrevia.innerHTML = parsearWhatsapp(origen.value);
  }

  // Se llama en cada apertura/reintento del modal (htmx:afterSwap, ver
  // arriba) — el contenteditable siempre arranca desde CERO a partir del
  // valor real del <textarea> oculto (vacío en alta; el texto guardado o
  // el que el usuario acababa de escribir en edición/reintento).
  function inicializarEditorPlantilla() {
    const editor = document.getElementById('plantillaTextoEditor');
    const textareaOculto = document.getElementById('plantillaTextoRespuesta');
    if (!editor || !textareaOculto) return;

    rangoEditorGuardado = null;
    editor.innerHTML = textareaOculto.value ? parsearWhatsapp(textareaOculto.value) : '';
    document.execCommand('defaultParagraphSeparator', false, 'div');
    sincronizarEditor(editor);

    editor.addEventListener('focus', () => {
      if (editor.childNodes.length) return;
      const renglon = document.createElement('div');
      renglon.appendChild(document.createElement('br'));
      editor.appendChild(renglon);
      const rango = document.createRange();
      rango.setStart(renglon, 0);
      rango.collapse(true);
      const seleccion = window.getSelection();
      seleccion.removeAllRanges();
      seleccion.addRange(rango);
      guardarRangoEditor(editor);
    });

    editor.addEventListener('input', () => {
      sincronizarEditor(editor);
      guardarRangoEditor(editor);
    });
    ['focus', 'keyup', 'mouseup'].forEach((evento) => {
      editor.addEventListener(evento, () => guardarRangoEditor(editor));
    });
    editor.addEventListener('paste', (event) => {
      event.preventDefault();
      restaurarRangoEditor(editor);
      const texto = event.clipboardData?.getData('text/plain') || '';
      document.execCommand('insertText', false, texto);
      guardarRangoEditor(editor);
      sincronizarEditor(editor);
    });

    const formulario = editor.closest('form');
    formulario?.addEventListener('submit', (event) => {
      const textoValido = sincronizarEditor(editor, true);
      if (!textoValido) {
        event.preventDefault();
        event.stopImmediatePropagation();
        editor.focus();
      }
    }, true);
  }

  const COMANDOS_INLINE = { negrita: 'bold', cursiva: 'italic', tachado: 'strikeThrough' };
  const FORMATOS_LISTA = { lista: 'ul', numerada: 'ol' };
  const FORMATOS_CODIGO = { monoespaciado: 'wa-mono' };

  // Evita que los controles de formato roben el foco antes del click. Así
  // una lista comienza en el renglón del cursor y no convierte todo el
  // contenido por haber perdido la selección.
  plantillaFormModalBody.addEventListener('mousedown', (event) => {
    if (event.target.closest('.plantilla-formato-btn, .plantilla-emoji-btn')) {
      event.preventDefault();
    }
  });

  plantillaFormModalBody.addEventListener('click', (event) => {
    if (event.target.closest('#plantillaFormClose, #plantillaFormCancel')) {
      closePlantillaFormModal();
    }
    if (event.target.closest('#plantillaFormErrorDismiss')) {
      event.target.closest('.form-error-banner')?.remove();
    }

    const botonFormato = event.target.closest('[data-formato]');
    if (botonFormato) {
      const editor = document.getElementById('plantillaTextoEditor');
      if (!editor) return;
      const formato = botonFormato.dataset.formato;
      if (COMANDOS_INLINE[formato]) ejecutarComandoEditor(editor, COMANDOS_INLINE[formato]);
      else if (FORMATOS_LISTA[formato]) alternarLista(editor, FORMATOS_LISTA[formato]);
      else if (FORMATOS_CODIGO[formato]) alternarCodigo(editor, FORMATOS_CODIGO[formato]);
      else if (formato === 'cita') alternarCita(editor);
      return;
    }

    const emojiPanel = document.getElementById('plantillaEmojiPanel');
    const emojiToggle = event.target.closest('#plantillaEmojiToggle');
    if (emojiToggle) {
      const abrir = emojiPanel?.hasAttribute('hidden');
      emojiPanel?.toggleAttribute('hidden');
      emojiToggle.setAttribute('aria-expanded', String(Boolean(abrir)));
      return;
    }

    const botonEmoji = event.target.closest('.plantilla-emoji-btn');
    if (botonEmoji) {
      const editor = document.getElementById('plantillaTextoEditor');
      const emoji = botonEmoji.dataset.emoji;
      if (editor && emoji) {
        restaurarRangoEditor(editor);
        document.execCommand('insertText', false, emoji);
        guardarRangoEditor(editor);
        sincronizarEditor(editor);
      }
      emojiPanel?.setAttribute('hidden', '');
      document.getElementById('plantillaEmojiToggle')?.setAttribute('aria-expanded', 'false');
      return;
    }

    if (emojiPanel && !emojiPanel.hasAttribute('hidden') && !event.target.closest('.plantilla-emoji-picker')) {
      emojiPanel.setAttribute('hidden', '');
      document.getElementById('plantillaEmojiToggle')?.setAttribute('aria-expanded', 'false');
    }

  });

  plantillaFormModalBackdrop.addEventListener('click', (event) => {
    if (event.target === plantillaFormModalBackdrop) closePlantillaFormModal();
  });

  // HX-Trigger: closePlantillaModal (ver plantillas_whatsapp.controller.js,
  // renderExito()) — htmx traduce ese header en este evento personalizado.
  document.body.addEventListener('closePlantillaModal', closePlantillaFormModal);
</script>

