<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Laboratorio | Omega Veterinaria & Estética</title>
<link rel="icon" type="image/png" href="assets/imgs/icon.png">
<link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="css/main.css">
<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true}'>
<script src="js/htmx.min.js" nonce="<%= cspNonce %>"></script>
</head>
<body>

  <div class="app" id="app">
    <div class="top-row">
      <div class="sidebar-header">
        <img src="assets/imgs/icon.png" alt="Omega Veterinaria & Estética">
        <span class="sidebar-title">Omega Vet</span>
        <button id="sidebarToggle" class="sidebar-toggle-btn" type="button" aria-label="Mostrar u ocultar menú">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>

      <header class="topbar">
        <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v5.5L4.5 17a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L15 8.5V3"/><path d="M9 3h6M8 14h8"/></svg>
        <h1 class="topbar-title">Laboratorio</h1>
        <a class="topbar-user" href="mi-perfil.html">
          <span class="topbar-user-avatar avatar-color-<%= user.avatar %>">
            <img src="assets/imgs/<%= user.avatar %>.png" alt="">
          </span>
          <span class="topbar-user-name"><%= user.nombre %> <%= user.apellidos %></span>
        </a>
      </header>
    </div>

    <div class="body-row">
    <div class="nav-backdrop" id="navBackdrop"></div>
    <%- include('partials/sidebar', { user, currentPage: 'laboratorio' }) %>

    <main class="main-content" id="laboratorio-panel">
      <%- include('partials/laboratorio-panel', { registros, total, catalogoVacio, page, totalPages, pageSize, q, estado, categoriaId, sort, dir, categorias, user, csrfToken }) %>
    </main>
    </div>
  </div>

  <%#
    Mismo token que ya viaja dentro del panel (hx-headers de #laboratorio-filters)
    pero SIEMPRE presente, incluso cuando catalogoVacio muestra el estado
    vacío en vez del toolbar (ese estado no trae ningún <form>) — sin esto,
    no hay ninguna forma de obtener un token válido para una acción vía
    fetch() mientras el catálogo está vacío.
  %>
  <input type="hidden" id="laboratorioPageCsrfToken" value="<%= csrfToken %>">

  <%# Modal de confirmación reutilizable (eliminar) — mismo patrón que doctores.ejs. %>
  <div class="modal-backdrop" id="confirmModalBackdrop">
    <div class="modal-card">
      <div class="modal-header">
        <h2>Confirmar acción</h2>
        <button class="modal-close-btn" type="button" id="confirmModalClose" aria-label="Cerrar">&times;</button>
      </div>
      <p id="confirmModalMessage"></p>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="confirmModalCancel">Cancelar</button>
        <button type="button" class="btn-danger" id="confirmModalConfirm">Eliminar</button>
      </div>
    </div>
  </div>

<script nonce="<%= cspNonce %>">
  const sidebar = document.getElementById('sidebar');
  const app = document.querySelector('.app');
  const sidebarToggle = document.getElementById('sidebarToggle');
  const navBackdrop = document.getElementById('navBackdrop');

  sidebarToggle.addEventListener('click', () => {
    app.classList.toggle('sidebar-hidden');
    app.classList.toggle('mobile-menu-open');
  });

  navBackdrop.addEventListener('click', () => {
    app.classList.remove('sidebar-hidden');
    app.classList.remove('mobile-menu-open');
  });

  document.querySelectorAll('.nav-toggle').forEach((toggle) => {
    const submenu = document.getElementById(toggle.dataset.target);
    if (submenu.classList.contains('open')) {
      submenu.style.maxHeight = `${submenu.scrollHeight}px`;
    }

    toggle.addEventListener('click', () => {
      const isOpen = submenu.classList.contains('open');

      document.querySelectorAll('.submenu.open').forEach((open) => {
        if (open !== submenu) {
          open.classList.remove('open');
          open.style.maxHeight = null;
          open.previousElementSibling?.classList.remove('active');
        }
      });

      submenu.classList.toggle('open', !isOpen);
      toggle.classList.toggle('active', !isOpen);
      submenu.style.maxHeight = !isOpen ? `${submenu.scrollHeight}px` : null;
    });
  });

  // ---- Combobox flotante genérico del toolbar de filtros (mismo patrón
  // que usuarios.ejs/agenda.ejs — un "portal" a <body> para escapar el
  // stacking context de `.main-content > *`). ----
  function openFloatingList(trigger, list) {
    if (!list._homeParent) list._homeParent = list.parentElement;
    document.body.appendChild(list);
    const rect = trigger.getBoundingClientRect();
    list.style.position = 'fixed';
    list.style.top = `${rect.bottom + 4}px`;
    list.style.left = `${rect.left}px`;
    list.style.width = `${rect.width}px`;
    list.style.right = 'auto';
    list.style.zIndex = '1000';
    list.hidden = false;
  }

  function closeFloatingList(list) {
    list.hidden = true;
    if (list._homeParent) list._homeParent.appendChild(list);
  }

  // Red de seguridad: si un swap de HTMX ocurre mientras alguna lista sigue
  // flotando en <body> (mismo motivo documentado en usuarios.ejs).
  document.body.addEventListener('htmx:beforeSwap', () => {
    document.querySelectorAll('.combobox-list').forEach((list) => {
      if (list.parentElement === document.body) list.remove();
    });
  });

  // ---- Filtros del toolbar (Estado / Tipo de estudio): mismo patrón que el
  // combobox de "Estatus" en usuarios.ejs — cada <li> trae su propio
  // hx-post, este listener solo abre/cierra la lista. Delegado sobre
  // document.body porque HTMX reemplaza #laboratorio-panel entero en cada
  // filtro/orden/página. ----
  function wireFiltroCombobox(triggerId, listId, comboboxId) {
    document.body.addEventListener('click', (event) => {
      const list = document.getElementById(listId);
      if (!list) return;
      const trigger = document.getElementById(triggerId);
      if (event.target.closest(`#${triggerId}`)) {
        if (list.hidden) openFloatingList(trigger, list);
        else closeFloatingList(list);
        return;
      }
      const combobox = document.getElementById(comboboxId);
      if ((combobox && combobox.contains(event.target)) || list.contains(event.target)) return;
      closeFloatingList(list);
    });
  }

  wireFiltroCombobox('estadoFiltroTrigger', 'estadoFiltroList', 'estadoFiltroCombobox');
  wireFiltroCombobox('categoriaFiltroTrigger', 'categoriaFiltroList', 'categoriaFiltroCombobox');

  // ---- Modal de confirmación (eliminar) — patrón htmx:confirm ya
  // establecido en doctores.ejs/agenda.ejs. ----
  const confirmModalBackdrop = document.getElementById('confirmModalBackdrop');
  const confirmModalMessage = document.getElementById('confirmModalMessage');
  let resolveConfirm = null;

  function openConfirmModal(message) {
    confirmModalMessage.textContent = message;
    confirmModalBackdrop.classList.add('open');
    return new Promise((resolve) => {
      resolveConfirm = resolve;
    });
  }

  function closeConfirmModal(result) {
    confirmModalBackdrop.classList.remove('open');
    resolveConfirm?.(result);
    resolveConfirm = null;
  }

  document.getElementById('confirmModalCancel').addEventListener('click', () => closeConfirmModal(false));
  document.getElementById('confirmModalClose').addEventListener('click', () => closeConfirmModal(false));
  document.getElementById('confirmModalConfirm').addEventListener('click', () => closeConfirmModal(true));
  confirmModalBackdrop.addEventListener('click', (event) => {
    if (event.target === confirmModalBackdrop) closeConfirmModal(false);
  });

  document.body.addEventListener('htmx:confirm', (event) => {
    if (!event.target.hasAttribute('hx-confirm')) return;
    event.preventDefault();
    openConfirmModal(event.detail.question).then((confirmed) => {
      if (confirmed) event.detail.issueRequest(true);
    });
  });
</script>

</body>
</html>
