      <form id="labForm" class="modal-form modal-form-columns">
        <div class="modal-col">
          <h3 class="modal-col-title">Datos de la mascota</h3>

          <label>Tipo de mascota
            <select id="fPetType" required>
              <option value="Perro">Perro</option>
              <option value="Gato">Gato</option>
            </select>
          </label>
          <label>Nombre de la mascota
            <input type="text" id="fPetName" required placeholder="Ej. Sparky">
          </label>
          <label>Raza
            <input type="text" id="fBreed" required placeholder="Ej. Labrador">
          </label>
          <label>Dr. Solicitante
            <input type="text" id="fDoctor" required placeholder="Ej. Dra. Ana Gómez">
          </label>
          <label>Fecha de solicitud
            <input type="date" id="fDate" required>
          </label>
        </div>

        <div class="modal-col">
          <h3 class="modal-col-title">Estudios</h3>

          <label>Categoría
            <select id="fCategoria"></select>
          </label>
          <label>Estudio
            <div class="combobox" id="fEstudioCombobox">
              <input type="text" id="fEstudioSearch" placeholder="Selecciona un estudio..." autocomplete="off">
              <input type="hidden" id="fEstudio">
              <ul class="combobox-list" id="fEstudioList" hidden></ul>
            </div>
          </label>
          <label id="fZonaWrap" hidden>Zona anatómica
            <select id="fZona"></select>
          </label>

          <button type="button" class="btn-secondary btn-add-study" id="btnAddStudy">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            Agregar estudio
          </button>

          <div class="mini-table-wrap">
            <table class="mini-table">
              <thead>
                <tr><th>Estudio solicitado</th><th>Acciones</th></tr>
              </thead>
              <tbody id="fStudiesBody"></tbody>
            </table>
            <p class="mini-table-empty" id="fStudiesEmpty">Aún no has agregado ningún estudio.</p>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-secondary" id="modalCancel">Cancelar</button>
          <button type="submit" class="btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <input type="file" id="resultFileInput" hidden>

<script>
  const sidebar = document.getElementById('sidebar');
  const app = document.querySelector('.app');
  const sidebarToggle = document.getElementById('sidebarToggle');
  const navBackdrop = document.getElementById('navBackdrop');

  sidebarToggle.addEventListener('click', () => {
    app.classList.toggle('sidebar-hidden');
    app.classList.toggle('mobile-menu-open');
  });

  navBackdrop.addEventListener('click', () => {
    app.classList.remove('sidebar-hidden');
    app.classList.remove('mobile-menu-open');
  });

  document.querySelectorAll('.nav-toggle').forEach((toggle) => {
    const submenu = document.getElementById(toggle.dataset.target);
    if (submenu.classList.contains('open')) {
      submenu.style.maxHeight = `${submenu.scrollHeight}px`;
    }

    toggle.addEventListener('click', () => {
      const isOpen = submenu.classList.contains('open');

      document.querySelectorAll('.submenu.open').forEach((open) => {
        if (open !== submenu) {
          open.classList.remove('open');
          open.style.maxHeight = null;
          open.previousElementSibling?.classList.remove('active');
        }
      });

      submenu.classList.toggle('open', !isOpen);
      toggle.classList.toggle('active', !isOpen);
      submenu.style.maxHeight = !isOpen ? `${submenu.scrollHeight}px` : null;
    });
  });

  // ---------- Laboratorio: datos, tabla, filtros, alta y carga de resultados ----------

  let nextId = 11;
  const records = [
    { id: 1, pet: 'Perro - Sparky, Labrador', studies: ['Biometría hemática'], doctor: 'Dra. Ana Gómez', requested: '2026-07-28', status: 'Enviado', sent: '2026-07-29' },
    { id: 2, pet: 'Gato - Michi, Siamés', studies: ['Urianálisis general'], doctor: 'Dra. Fernanda López', requested: '2026-07-29', status: 'Pendiente', sent: null },
    { id: 3, pet: 'Perro - Rocky, Bulldog Francés', studies: ['Radiografía torácica'], doctor: 'Dr. Carlos Ruiz', requested: '2026-07-30', status: 'Enviado', sent: '2026-07-31' },
    { id: 4, pet: 'Gato - Luna, Persa', studies: ['Perfil tiroideo T4'], doctor: 'Dra. Paola Méndez', requested: '2026-07-30', status: 'Pendiente', sent: null },
    { id: 5, pet: 'Perro - Toby, Schnauzer', studies: ['Coprológico'], doctor: 'Dr. Luis Torres', requested: '2026-07-31', status: 'Enviado', sent: '2026-08-01' },
    { id: 6, pet: 'Perro - Max, Pitbull', studies: ['Química sanguínea 6 elementos'], doctor: 'Dra. Ana Gómez', requested: '2026-08-01', status: 'Pendiente', sent: null },
    { id: 7, pet: 'Gato - Salem, Negro común', studies: ['Urocultivo'], doctor: 'Dra. Fernanda López', requested: '2026-08-01', status: 'Enviado', sent: '2026-08-02' },
    { id: 8, pet: 'Perro - Hope, Pastor Alemán', studies: ['Ecografía abdominal'], doctor: 'Dr. Carlos Ruiz', requested: '2026-08-02', status: 'Pendiente', sent: null },
    { id: 9, pet: 'Gato - Kiara, Angora', studies: ['Citología de oído'], doctor: 'Dra. Paola Méndez', requested: '2026-08-02', status: 'Pendiente', sent: null },
    { id: 10, pet: 'Perro - Firulais, Criollo', studies: ['Prueba de Ehrlichia/Anaplasma'], doctor: 'Dr. Luis Torres', requested: '2026-08-03', status: 'Pendiente', sent: null },
  ];

  const tableBody = document.getElementById('labTableBody');
  const labEmpty = document.getElementById('labEmpty');
  const searchInput = document.getElementById('labSearch');
  const estadoFilter = document.getElementById('labFilterEstado');
  const tipoFilter = document.getElementById('labFilterTipo');

  function formatDate(isoDate) {
    if (!isoDate) return '—';
    const [y, m, d] = isoDate.split('-');
    return `${d}/${m}/${y}`;
  }

  function idLabel(id) {
    return `LAB-${String(id).padStart(3, '0')}`;
  }

  function renderTable() {
    const search = searchInput.value.trim().toLowerCase();
    const estado = estadoFilter.value;
    const tipo = tipoFilter.value.toLowerCase();

    const filtered = records.filter((r) => {
      const matchesSearch = !search || r.pet.toLowerCase().includes(search) || r.doctor.toLowerCase().includes(search);
      const matchesEstado = !estado || r.status === estado;
      const matchesTipo = !tipo || r.studies.some((s) => s.toLowerCase().includes(tipo));
      return matchesSearch && matchesEstado && matchesTipo;
    });

    tableBody.innerHTML = '';
    labEmpty.hidden = filtered.length !== 0;

    filtered.forEach((r) => {
      const tr = document.createElement('tr');

      const badgeClass = r.status === 'Enviado' ? 'badge-enviado' : 'badge-pendiente';
      const btnClass = r.status === 'Enviado' ? 'sent' : 'pending';
      const btnLabel = r.status === 'Enviado' ? 'Ver resultado' : 'Subir resultado';

      const studyCell = r.studies.length > 1
        ? `<details class="lab-studies-details">
             <summary>Varios estudios (${r.studies.length})</summary>
             <ul class="lab-studies-list">${r.studies.map((s) => `<li>${s}</li>`).join('')}</ul>
           </details>`
        : r.studies[0];

      tr.innerHTML = `
        <td>${idLabel(r.id)}</td>
        <td>${r.pet}</td>
        <td>${studyCell}</td>
        <td>${r.doctor}</td>
        <td>${formatDate(r.requested)}</td>
        <td><span class="badge ${badgeClass}">${r.status}</span></td>
        <td>${formatDate(r.sent)}</td>
        <td><button type="button" class="btn-upload ${btnClass}" data-id="${r.id}">${btnLabel}</button></td>
      `;

      tableBody.appendChild(tr);
    });
  }

  searchInput.addEventListener('input', renderTable);
  estadoFilter.addEventListener('change', renderTable);
  tipoFilter.addEventListener('change', renderTable);

