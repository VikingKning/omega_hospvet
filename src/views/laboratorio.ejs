      ]},
      { id: 'imagenologia', nombre: 'Imagenología', estudios: [
        { codigo: 'RADIOGRAFIA', nombre: 'Radiografía simple', requiere_zona: true, zonas_permitidas: ['craneo', 'cervical', 'toracica_columna', 'lumbar', 'torax', 'abdomen', 'pelvis', 'miembro_toracico', 'miembro_pelvico'] },
        { codigo: 'ECOGRAFIA', nombre: 'Ecografía', requiere_zona: true, zonas_permitidas: ['abdomen', 'torax', 'ocular', 'articular'] },
        { codigo: 'ECOCARDIOGRAMA', nombre: 'Ecocardiograma', requiere_zona: false },
        { codigo: 'ECG', nombre: 'Electrocardiograma (ECG)', requiere_zona: false },
        { codigo: 'TAC', nombre: 'Tomografía computarizada', requiere_zona: false },
        { codigo: 'ENDOSCOPIA', nombre: 'Endoscopía', requiere_zona: false },
      ]},
      { id: 'genetica_reproduccion', nombre: 'Genética y reproducción', estudios: [
        { codigo: 'PERFIL_GESTACION', nombre: 'Perfil de gestación', requiere_zona: false },
        { codigo: 'ESPERMATOBIOSCOPIA', nombre: 'Espermatobioscopía', requiere_zona: false },
        { codigo: 'GENETICA_RAZA', nombre: 'Pruebas genéticas de raza', requiere_zona: false },
      ]},
    ],
    zonas_anatomicas: [
      { codigo: 'craneo', nombre: 'Cráneo' },
      { codigo: 'cervical', nombre: 'Columna cervical' },
      { codigo: 'toracica_columna', nombre: 'Columna torácica' },
      { codigo: 'lumbar', nombre: 'Columna lumbar' },
      { codigo: 'torax', nombre: 'Tórax' },
      { codigo: 'abdomen', nombre: 'Abdomen' },
      { codigo: 'pelvis', nombre: 'Pelvis' },
      { codigo: 'miembro_toracico', nombre: 'Miembro torácico' },
      { codigo: 'miembro_pelvico', nombre: 'Miembro pélvico' },
      { codigo: 'ocular', nombre: 'Ocular' },
      { codigo: 'articular', nombre: 'Articular' },
    ],
  };

  const zonaNombrePorCodigo = Object.fromEntries(CATALOGO.zonas_anatomicas.map((z) => [z.codigo, z.nombre]));

  function findCategoria(categoriaId) {
    return CATALOGO.categorias.find((c) => c.id === categoriaId);
  }

  function findEstudio(estudioCodigo) {
    for (const categoria of CATALOGO.categorias) {
      const estudio = categoria.estudios.find((e) => e.codigo === estudioCodigo);
      if (estudio) return estudio;
    }
    return null;
  }

  const fCategoria = document.getElementById('fCategoria');
  const fEstudio = document.getElementById('fEstudio');
  const fEstudioSearch = document.getElementById('fEstudioSearch');
  const fEstudioList = document.getElementById('fEstudioList');
  const fEstudioCombobox = document.getElementById('fEstudioCombobox');
  const fZonaWrap = document.getElementById('fZonaWrap');
  const fZona = document.getElementById('fZona');

  function populateCategorias() {
    const todasOption = '<option value="">Todas las categorías</option>';
    const categoriaOptions = CATALOGO.categorias
      .map((c) => `<option value="${c.id}">${c.nombre}</option>`)
      .join('');
    fCategoria.innerHTML = todasOption + categoriaOptions;
  }

  function getEstudioEntries() {
    if (fCategoria.value === '') {
      return CATALOGO.categorias.flatMap((c) => c.estudios.map((e) => ({ ...e, categoriaNombre: c.nombre })));
    }
    const categoria = findCategoria(fCategoria.value);
    return categoria.estudios.map((e) => ({ ...e, categoriaNombre: categoria.nombre }));
  }

  function selectEstudio(entry) {
    fEstudio.value = entry.codigo;
    fEstudioSearch.value = entry.nombre;
    updateZonaVisibility();
  }

  function clearEstudioSelection() {
    fEstudio.value = '';
    fEstudioSearch.value = '';
    updateZonaVisibility();
    hideEstudioList();
  }

  function populateEstudios() {
    clearEstudioSelection();
  }

  let activeIndex = -1;

  function normalizeText(str) {
    return str.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  }

  function renderEstudioList(filterText) {
    const entries = getEstudioEntries();
    const filtered = filterText
      ? entries.filter((e) => normalizeText(e.nombre).includes(normalizeText(filterText)))
      : entries;

    activeIndex = -1;

    if (filtered.length === 0) {
      fEstudioList.innerHTML = '<li class="combobox-empty">Sin resultados</li>';
      fEstudioList.hidden = false;
      return;
    }

    const showGroups = fCategoria.value === '';
    let html = '';
    let lastGroup = null;

    filtered.forEach((entry) => {
      if (showGroups && entry.categoriaNombre !== lastGroup) {
        html += `<li class="combobox-group">${entry.categoriaNombre}</li>`;
        lastGroup = entry.categoriaNombre;
      }
      html += `<li class="combobox-item" data-codigo="${entry.codigo}" role="option">${entry.nombre}</li>`;
    });

    fEstudioList.innerHTML = html;
    fEstudioList.hidden = false;
  }

  function hideEstudioList() {
    fEstudioList.hidden = true;
    activeIndex = -1;
  }

  function updateActiveItem(items) {
    items.forEach((item, i) => item.classList.toggle('active', i === activeIndex));
    items[activeIndex]?.scrollIntoView({ block: 'nearest' });
  }

  fEstudioSearch.addEventListener('input', () => renderEstudioList(fEstudioSearch.value));
  fEstudioSearch.addEventListener('focus', () => renderEstudioList(fEstudioSearch.value));

  fEstudioSearch.addEventListener('keydown', (e) => {
    if (fEstudioList.hidden && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
      renderEstudioList(fEstudioSearch.value);
      return;
    }

    const items = Array.from(fEstudioList.querySelectorAll('.combobox-item'));

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, items.length - 1);
      updateActiveItem(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
      updateActiveItem(items);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const item = items[activeIndex] || items[0];
      if (item) {
        selectEstudio(findEstudio(item.dataset.codigo));
        hideEstudioList();
      }
    } else if (e.key === 'Escape') {
      hideEstudioList();
    }
  });

  fEstudioList.addEventListener('click', (e) => {
    const item = e.target.closest('.combobox-item');
    if (!item) return;
    e.preventDefault();
    selectEstudio(findEstudio(item.dataset.codigo));
    hideEstudioList();
  });

  document.addEventListener('click', (e) => {
    if (!fEstudioCombobox.contains(e.target)) {
      hideEstudioList();
    }
  });

  function updateZonaVisibility() {
    const estudio = findEstudio(fEstudio.value);

    if (estudio && estudio.requiere_zona) {
      fZona.innerHTML = estudio.zonas_permitidas
        .map((codigo) => `<option value="${codigo}">${zonaNombrePorCodigo[codigo]}</option>`)
        .join('');
      fZonaWrap.hidden = false;
      fZona.required = true;
    } else {
      fZonaWrap.hidden = true;
      fZona.required = false;
      fZona.value = '';
    }
  }

  fCategoria.addEventListener('change', populateEstudios);

  populateCategorias();
  populateEstudios();

  // Nuevo registro (modal)
  const modalBackdrop = document.getElementById('modalBackdrop');
  const labForm = document.getElementById('labForm');
  const fStudiesBody = document.getElementById('fStudiesBody');
  const fStudiesEmpty = document.getElementById('fStudiesEmpty');

  let selectedStudies = [];

  function renderSelectedStudies() {
    fStudiesEmpty.hidden = selectedStudies.length !== 0;
    fStudiesBody.innerHTML = selectedStudies
      .map((s, i) => `
        <tr>
          <td>${s}</td>
          <td><button type="button" class="mini-remove" data-idx="${i}" aria-label="Quitar estudio">&times;</button></td>
        </tr>
      `)
      .join('');
  }

  document.getElementById('btnAddStudy').addEventListener('click', () => {
    const estudio = findEstudio(fEstudio.value);
    if (!estudio) {
      fEstudioSearch.focus();
      return;
    }

    const label = estudio.requiere_zona
      ? `${estudio.nombre} - ${zonaNombrePorCodigo[fZona.value]}`
      : estudio.nombre;

    selectedStudies.push(label);
    renderSelectedStudies();
    clearEstudioSelection();
  });

  fStudiesBody.addEventListener('click', (e) => {
    const btn = e.target.closest('.mini-remove');
    if (!btn) return;
    selectedStudies.splice(Number(btn.dataset.idx), 1);
    renderSelectedStudies();
  });

  function openModal() {
    document.getElementById('fDate').value = new Date().toISOString().slice(0, 10);
    fCategoria.selectedIndex = 0;
    populateEstudios();
    selectedStudies = [];
    renderSelectedStudies();
    modalBackdrop.classList.add('open');
  }

  function closeModal() {
    modalBackdrop.classList.remove('open');
    labForm.reset();
  }

  document.getElementById('btnNuevoRegistro').addEventListener('click', openModal);
  document.getElementById('modalClose').addEventListener('click', closeModal);
  document.getElementById('modalCancel').addEventListener('click', closeModal);
  modalBackdrop.addEventListener('click', (e) => {
    if (e.target === modalBackdrop) closeModal();
  });

  labForm.addEventListener('submit', (e) => {
    e.preventDefault();

    if (selectedStudies.length === 0) {
      alert('Agrega al menos un estudio antes de guardar.');
      return;
    }

    const petType = document.getElementById('fPetType').value;
    const petName = document.getElementById('fPetName').value.trim();
    const breed = document.getElementById('fBreed').value.trim();
    const doctor = document.getElementById('fDoctor').value.trim();
    const date = document.getElementById('fDate').value;
    const pet = `${petType} - ${petName}, ${breed}`;

    records.unshift({
      id: nextId++,
      pet,
      studies: [...selectedStudies],
      doctor,
      requested: date,
      status: 'Pendiente',
      sent: null,
    });

    closeModal();
    renderTable();
  });

  // Cargar resultado (simulado con selector de archivo)
  const resultFileInput = document.getElementById('resultFileInput');
  let uploadingId = null;

  tableBody.addEventListener('click', (e) => {
    const btn = e.target.closest('.btn-upload');
    if (!btn) return;
    uploadingId = Number(btn.dataset.id);
    resultFileInput.value = '';
    resultFileInput.click();
  });

  resultFileInput.addEventListener('change', () => {
    if (!resultFileInput.files.length || uploadingId === null) return;
    const record = records.find((r) => r.id === uploadingId);
    if (record) {
      record.status = 'Enviado';
      record.sent = new Date().toISOString().slice(0, 10);
      renderTable();
    }
    uploadingId = null;
  });

  renderTable();
</script>

</body>
</html>
