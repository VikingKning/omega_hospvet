<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Laboratorio | Omega Hospital Veterinario</title>
<link rel="icon" type="image/png" href="assets/imgs/icon.png">
<link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="css/main.css">
<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true}'>
<script src="js/htmx.min.js" nonce="<%= cspNonce %>"></script>
</head>
<body>

  <div class="app" id="app">
    <div class="top-row">
      <div class="sidebar-header">
        <img src="assets/imgs/icon.png" alt="Omega Hospital Veterinario">
        <span class="sidebar-title">Omega Vet</span>
        <button id="sidebarToggle" class="sidebar-toggle-btn" type="button" aria-label="Mostrar u ocultar menú">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>

      <header class="topbar">
        <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v5.5L4.5 17a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L15 8.5V3"/><path d="M9 3h6M8 14h8"/></svg>
        <h1 class="topbar-title">Laboratorio</h1>
        <a class="topbar-user" href="mi-perfil.html">
          <span class="topbar-user-avatar avatar-color-<%= user.avatar %>">
            <img src="assets/imgs/<%= user.avatar %>.png" alt="">
          </span>
          <span class="topbar-user-name"><%= user.nombre %> <%= user.apellidos %></span>
        </a>
      </header>
    </div>

    <div class="body-row">
    <div class="nav-backdrop" id="navBackdrop"></div>
    <%- include('partials/sidebar', { user, currentPage: 'laboratorio' }) %>

    <main class="main-content" id="laboratorio-panel">
      <%- include('partials/laboratorio-panel', { registros, total, catalogoVacio, page, totalPages, pageSize, q, estado, categoriaId, sort, dir, categorias, user, csrfToken, error }) %>
    </main>
    </div>
  </div>

  <input type="hidden" id="laboratorioPageCsrfToken" value="<%= csrfToken %>">

  <div class="modal-backdrop" id="confirmModalBackdrop">
    <div class="modal-card">
      <div class="modal-header">
        <h2>Confirmar acción</h2>
        <button class="modal-close-btn" type="button" id="confirmModalClose" aria-label="Cerrar">&times;</button>
      </div>
      <p id="confirmModalMessage"></p>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="confirmModalCancel">Cancelar</button>
        <button type="button" class="btn-danger" id="confirmModalConfirm">Eliminar</button>
      </div>
    </div>
  </div>

<script src="js/sidebar.js" nonce="<%= cspNonce %>"></script>
<script src="js/confirmModal.js" nonce="<%= cspNonce %>"></script>
<script src="js/combobox.js" nonce="<%= cspNonce %>"></script>
<script nonce="<%= cspNonce %>">
  function openFloatingList(trigger, list) {
    if (!list._homeParent) list._homeParent = list.parentElement;
    document.body.appendChild(list);
    const rect = trigger.getBoundingClientRect();
    list.style.position = 'fixed';
    list.style.top = `${rect.bottom + 4}px`;
    list.style.left = `${rect.left}px`;
    list.style.width = `${rect.width}px`;
    list.style.right = 'auto';
    list.style.zIndex = '1000';
    list.hidden = false;
  }

  function closeFloatingList(list) {
    list.hidden = true;
    if (list._homeParent) list._homeParent.appendChild(list);
  }

  document.body.addEventListener('htmx:beforeSwap', () => {
    document.querySelectorAll('.combobox-list').forEach((list) => {
      if (list.parentElement === document.body) list.remove();
    });
  });

  document.body.addEventListener('click', (event) => {
    if (event.target.closest('#laboratorioBannerErrorDismiss')) {
      event.target.closest('.form-error-banner')?.remove();
    }
  });

  function wireFiltroCombobox(triggerId, listId, comboboxId) {
    document.body.addEventListener('click', (event) => {
      const list = document.getElementById(listId);
      if (!list) return;
      const trigger = document.getElementById(triggerId);
      if (event.target.closest(`#${triggerId}`)) {
        if (list.hidden) openFloatingList(trigger, list);
        else closeFloatingList(list);
        return;
      }
      const combobox = document.getElementById(comboboxId);
      if ((combobox && combobox.contains(event.target)) || list.contains(event.target)) return;
      closeFloatingList(list);
    });
  }

  wireFiltroCombobox('estadoFiltroTrigger', 'estadoFiltroList', 'estadoFiltroCombobox');
  wireFiltroCombobox('categoriaFiltroTrigger', 'categoriaFiltroList', 'categoriaFiltroCombobox');

  function wireFiltroTeclado(triggerId, listId, comboboxId) {
    const trigger = document.getElementById(triggerId);
    const list = document.getElementById(listId);
    const combobox = document.getElementById(comboboxId);
    if (!trigger || !list || !combobox) return;
    attachComboboxKeyboardNav(trigger, list);
    attachComboboxClearButton(combobox, trigger, () => {
      list.querySelector('.combobox-item')?.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
    });
  }

  function wireFiltrosTeclado() {
    wireFiltroTeclado('estadoFiltroTrigger', 'estadoFiltroList', 'estadoFiltroCombobox');
    wireFiltroTeclado('categoriaFiltroTrigger', 'categoriaFiltroList', 'categoriaFiltroCombobox');
  }

  wireFiltrosTeclado();
  const laboratorioPanel = document.getElementById('laboratorio-panel');
  document.body.addEventListener('htmx:afterSwap', (event) => {
    if (event.detail.target !== laboratorioPanel) return;
    wireFiltrosTeclado();
  });
</script>

</body>
</html>
