<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Configuración General | Omega Hospital Veterinario</title>
<base href="/">
<link rel="icon" type="image/png" href="assets/imgs/icon.png">
<link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="css/main.css">
<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true}'>
<script src="js/htmx.min.js" nonce="<%= cspNonce %>"></script>
</head>
<body>

  <div class="app" id="app">
    <div class="top-row">
      <div class="sidebar-header">
        <img src="assets/imgs/icon.png" alt="Omega Hospital Veterinario">
        <span class="sidebar-title">Omega Vet</span>
        <button id="sidebarToggle" class="sidebar-toggle-btn" type="button" aria-label="Mostrar u ocultar menú">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>

      <header class="topbar">
        <span class="topbar-icon-badge">
          <svg class="topbar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </span>
        <h1 class="topbar-title">Configuración General</h1>
        <a class="topbar-user" href="mi-perfil.html">
          <span class="topbar-user-avatar avatar-color-<%= user.avatar %>">
            <img src="assets/imgs/<%= user.avatar %>.png" alt="">
          </span>
          <span class="topbar-user-name"><%= user.nombre %> <%= user.apellidos %></span>
        </a>
      </header>
    </div>

    <div class="body-row">
    <div class="nav-backdrop" id="navBackdrop"></div>
    <%- include('partials/sidebar', { user, currentPage: 'configuracion' }) %>

    <main class="main-content" id="configuracion-panel">
      <%- include('partials/configuracion-generales-form', { aviso, versiones, funciones, mensaje, error, csrfToken }) %>
    </main>
    </div>
  </div>

  <div class="modal-backdrop" id="confirmModalBackdrop">
    <div class="modal-card">
      <div class="modal-header">
        <h2>Confirmar acción</h2>
        <button class="modal-close-btn" type="button" id="confirmModalClose" aria-label="Cerrar">&times;</button>
      </div>
      <p id="confirmModalMessage"></p>
      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="confirmModalCancel">Cancelar</button>
        <button type="button" class="btn-primary" id="confirmModalConfirm">Confirmar cambio</button>
      </div>
    </div>
  </div>

<script src="js/sidebar.js" nonce="<%= cspNonce %>"></script>
<script src="js/confirmModal.js" nonce="<%= cspNonce %>"></script>
<script nonce="<%= cspNonce %>">
  const configuracionPanel = document.getElementById('configuracion-panel');

  function mostrarArchivoSeleccionado(archivo) {
    const el = document.getElementById('avisoDropzoneArchivo');
    if (!el) return;
    if (archivo) {
      el.textContent = `Archivo seleccionado: ${archivo.name}`;
      el.hidden = false;
    } else {
      el.hidden = true;
    }
  }

  function aplicarEstadoFuncion(grupo, habilitado) {
    grupo.querySelectorAll('.toggle-btn').forEach((boton) => {
      const seleccionado = (boton.dataset.value === 'habilitado') === habilitado;
      boton.classList.toggle('active', seleccionado);
      boton.setAttribute('aria-pressed', String(seleccionado));
    });
  }

  let temporizadorMensajeFuncion = null;

  function ocultarMensajeFuncion(banner) {
    if (temporizadorMensajeFuncion) clearTimeout(temporizadorMensajeFuncion);
    temporizadorMensajeFuncion = null;
    banner.hidden = true;
    banner.replaceChildren();
  }

  function mostrarMensajeFuncion(mensaje, esError = false) {
    const banner = document.getElementById('configuracionFuncionesMensaje');
    if (!banner) return;
    if (temporizadorMensajeFuncion) clearTimeout(temporizadorMensajeFuncion);

    const texto = document.createElement('span');
    texto.textContent = mensaje;
    const cerrar = document.createElement('button');
    cerrar.type = 'button';
    cerrar.className = 'configuracion-mensaje-cerrar';
    cerrar.setAttribute('aria-label', 'Cerrar mensaje');
    cerrar.innerHTML =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
    cerrar.addEventListener('click', () => ocultarMensajeFuncion(banner));

    banner.replaceChildren(texto, cerrar);
    banner.className = esError ? 'form-error-banner' : 'form-success-banner';
    banner.setAttribute('role', esError ? 'alert' : 'status');
    banner.hidden = false;
    temporizadorMensajeFuncion = setTimeout(() => ocultarMensajeFuncion(banner), 5000);
  }

  configuracionPanel.addEventListener('click', async (event) => {
    const botonConfiguracion = event.target.closest('.configuracion-option-toggle .toggle-btn');
    if (botonConfiguracion) {
      const grupo = botonConfiguracion.closest('.configuracion-option-toggle');
      const habilitado = botonConfiguracion.dataset.value === 'habilitado';
      const estadoAnterior = grupo.querySelector('[aria-pressed="true"]')?.dataset.value === 'habilitado';
      if (habilitado === estadoAnterior || grupo.dataset.guardando === 'true') return;

      aplicarEstadoFuncion(grupo, habilitado);
      grupo.dataset.guardando = 'true';
      grupo.querySelectorAll('button').forEach((boton) => { boton.disabled = true; });
      try {
        const respuesta = await fetch(
          `configuracion/generales/funciones/${encodeURIComponent(grupo.dataset.configClave)}`,
          {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'x-csrf-token': <%- JSON.stringify(csrfToken) %>,
            },
            body: JSON.stringify({ habilitado }),
          },
        );
        const resultado = await respuesta.json().catch(() => ({}));
        if (!respuesta.ok) throw new Error(resultado.error || 'No fue posible guardar el cambio.');
        aplicarEstadoFuncion(grupo, resultado.habilitado);
        mostrarMensajeFuncion('Configuración guardada automáticamente.');
      } catch (error) {
        aplicarEstadoFuncion(grupo, estadoAnterior);
        mostrarMensajeFuncion(error.message, true);
      } finally {
        delete grupo.dataset.guardando;
        grupo.querySelectorAll('button').forEach((boton) => { boton.disabled = false; });
      }
      return;
    }

    if (event.target.closest('#configuracionFormErrorDismiss')) {
      event.target.closest('.form-error-banner')?.remove();
      return;
    }
    if (event.target.closest('#configuracionFormSuccessDismiss')) {
      event.target.closest('.form-success-banner')?.remove();
      return;
    }
    // Excluir el propio <input> evita un loop: al hacer input.click() desde
    // aquí, ese click sintético también burbujea hasta este mismo listener.
    if (event.target.closest('#avisoDropzone') && event.target.id !== 'avisoArchivoInput') {
      document.getElementById('avisoArchivoInput')?.click();
    }
  });

  configuracionPanel.addEventListener('change', (event) => {
    if (event.target.id === 'avisoArchivoInput') {
      mostrarArchivoSeleccionado(event.target.files?.[0]);
    }
  });

  configuracionPanel.addEventListener('dragover', (event) => {
    const zona = event.target.closest('#avisoDropzone');
    if (!zona) return;
    event.preventDefault();
    zona.classList.add('is-dragover');
  });

  configuracionPanel.addEventListener('dragleave', (event) => {
    event.target.closest('#avisoDropzone')?.classList.remove('is-dragover');
  });

  configuracionPanel.addEventListener('drop', (event) => {
    const zona = event.target.closest('#avisoDropzone');
    if (!zona) return;
    event.preventDefault();
    zona.classList.remove('is-dragover');
    const archivo = event.dataTransfer.files?.[0];
    if (!archivo) return;
    document.getElementById('avisoArchivoInput').files = event.dataTransfer.files;
    mostrarArchivoSeleccionado(archivo);
  });

  // Antes de enviar de verdad, se pregunta al servidor si ESE archivo (mismo
  // nombre + mismo contenido, sin importar qué versión se le vaya a poner)
  // ya está registrado. Se usa el gancho htmx:confirm (mismo mecanismo de
  // confirmModal.js) en vez de interceptar el 'submit' a mano: htmx
  // conserva el <input type="file"> intacto y, al confirmar, reenvía la
  // misma petición ya construida (issueRequest) sin volver a serializar el
  // formulario.
  configuracionPanel.addEventListener('htmx:confirm', (event) => {
    if (event.target.id !== 'configuracionAvisoForm') return;
    event.preventDefault();
    verificarArchivoAntesDeGuardarAviso(event.target, event.detail);
  });

  async function calcularSha256(archivo) {
    const buffer = await archivo.arrayBuffer();
    const hashBuffer = await crypto.subtle.digest('SHA-256', buffer);
    return Array.from(new Uint8Array(hashBuffer))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');
  }

  async function verificarArchivoAntesDeGuardarAviso(form, detail) {
    // "Reenviar a todos" fuerza que TODOS los tutores —incluso los que ya
    // habían aceptado— vuelvan a aceptar en su siguiente mensaje. Es una
    // acción de alto impacto (bloquea el bot para gente que ya estaba al
    // corriente) y sin retroceso fácil una vez que empiezan a llegar
    // mensajes, así que pide confirmación explícita SIEMPRE que esté
    // marcado, sin importar si el archivo ya existía o no (evitó por poco
    // un incidente real el 2026-09-20: se subió por error un documento que
    // no era el aviso, con este switch activo).
    if (form.querySelector('#avisoReenviarInput')?.checked) {
      const confirmaReenvio = await openConfirmModal(
        'Vas a exigir que TODOS los tutores acepten de nuevo el aviso de privacidad en su próximo mensaje, incluso quienes ya lo habían aceptado antes. Verifica que el archivo seleccionado sea el correcto. ¿Confirmas que quieres continuar?',
        'Sí, reenviar a todos',
      );
      if (!confirmaReenvio) return;
    }

    const archivo = form.querySelector('#avisoArchivoInput')?.files?.[0];
    let existe = false;
    try {
      if (archivo) {
        const hash = await calcularSha256(archivo);
        const params = new URLSearchParams({ nombreOriginal: archivo.name, hash });
        const res = await fetch(`configuracion/generales/archivo-existente?${params.toString()}`);
        if (res.ok) existe = (await res.json()).existe;
      }
    } catch {
      existe = false;
    }
    if (!existe) {
      detail.issueRequest(true);
      return;
    }
    const confirmado = await openConfirmModal(
      'Se encontró un archivo con el mismo nombre y contenido guardado anteriormente. ¿Desea proceder?',
      'Confirmar cambio',
    );
    if (confirmado) detail.issueRequest(true);
  }
</script>

</body>
</html>
