# Copiar este archivo a .env y completar con valores reales.
# .env nunca debe subirse al control de versiones (Decisión 15).

NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omega_hospvet
DB_USER=omega_hospvet
DB_PASSWORD=

# Sesiones
SESSION_SECRET=

# Carpeta donde se guardan los archivos de resultados de laboratorio subidos
# (laboratorio.archivos.js) — nunca dentro de public/ (se sirven por una
# ruta autenticada, nunca por static serving directo). Puede ser cualquier
# ruta absoluta del sistema, dentro o fuera de este repo.
LABS_RESULT_FILE_STORAGE=

# Usuario administrador de arranque (seed 05_admin_usuario.js)
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=Omega
ADMIN_EMAIL=admin@omegavet.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Sincronización con Google Calendar (agenda.googleSync.js) — opcionales:
# sin ellas la sincronización simplemente no corre (ver
# isGoogleSyncConfigured() en src/config/googleCalendar.js). Ver la sección
# "Reservas externas de Consultas (Google Calendar)" del README para los
# datos obligatorios en la página de reservas y el doctor genérico.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_SYNC_INTERVAL_MINUTES=10

# Envío/recepción de WhatsApp (módulo whatsapp/, Decisión 21) — opcionales:
# sin ellas la app sigue funcionando normal, WhatsApp simplemente no se
# activa (ver isWhatsappConfigured() en src/config/whatsapp.js). token/
# phoneNumberId/businessAccountId vienen de la app de Meta for Developers;
# appSecret firma cada webhook entrante (X-Hub-Signature-256);
# webhookVerifyToken lo elegimos NOSOTROS y se pega tal cual en el campo
# "Verify token" al registrar el webhook en Meta (no lo genera Meta).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Clasificador de intención de WhatsApp (Claude API, claude-haiku-4-5 —
# solo clasifica, nunca genera contenido médico libre) — opcional, mismo
# criterio que Google/WhatsApp arriba (ver isClaudeConfigured() en
# src/config/claude.js).
ANTHROPIC_API_KEY=
