# Copiar este archivo a .env y completar con valores reales.
# .env nunca debe subirse al control de versiones (Decisión 15).

NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omega_hospvet
DB_USER=omega_hospvet
DB_PASSWORD=

# Sesiones
SESSION_SECRET=

# Carpeta donde se guardan los archivos de resultados de laboratorio subidos
# (laboratorio.archivos.js) — nunca dentro de public/ (se sirven por una
# ruta autenticada, nunca por static serving directo). Puede ser cualquier
# ruta absoluta del sistema, dentro o fuera de este repo.
LABS_RESULT_FILE_STORAGE=

# Usuario administrador de arranque (seed 05_admin_usuario.js)
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=Omega
ADMIN_EMAIL=admin@omegavet.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
