# Valores de ejemplo para correr el proyecto en localhost.
# Copiar a .env antes de levantar el servidor: cp .env.localhost .env
# Este archivo está excluido de git (ver .gitignore) — no compartir si le cambias la contraseña real.

NODE_ENV=development/qa/stage/produccion
PORT=3000

# Base de datos PostgreSQL local
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Sesiones (solo para desarrollo local, no usar en producción)
SESSION_SECRET=

# Usuario administrador de arranque (seed 05_admin_usuario.js)
ADMIN_NOMBRE=
ADMIN_APELLIDOS=
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

#Google calendar sync user
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_SYNC_INTERVAL_MINUTES=10

GOOGLE_CALENDAR_MEETING_URL=https://calendar.app.google/2pLfRH4nE4ZRAc7M7
GOOGLE_MAPS_URL=https://www.google.com/maps/place/Hospital+Veterinario+Omega/@20.1206582,-98.7632894,17z/data=!3m1!4b1!4m6!3m5!1s0x85d10a047bd4330d:0xc37b6b947b66b2fc!8m2!3d20.1206532!4d-98.7607145!16s%2Fg%2F11d_1mdjxx?entry=ttu&g_ep=EgoyMDI2MDkwOS4wIKXMDSoASAFQAw%3D%3D

#Ruta de los archivos que se suben al sistema
LABS_RESULT_FILE_STORAGE=

#Whatsapp information
WHATSAPP_APP_ID=
WHATSAPP_TOKEN=E
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
OMEGA_WHATSAPPS=

#Meta Secret Key for APP
WHATSAPP_APP_SECRET=

#Claude 
ANTHROPIC_API_KEY=

#Email Configuration 
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Omega Hospital Veterinario <omegavet.test@gmail.com>
