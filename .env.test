# Variables para correr `pnpm test` (Jest) local y en CI, contra una base de
# datos de pruebas descartable. No contiene secretos reales — seguro de
# versionar (a diferencia de .env/.env.localhost).
NODE_ENV=test
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=omega_test
DB_USER=omega_test
DB_PASSWORD=omega_test

SESSION_SECRET=test-secret-no-usar-en-produccion

# Los tests nunca escriben archivos reales a disco (fs/promises mockeado en
# laboratorio.archivos.test.js, y los tests de integración solo prueban
# permisos con ids inexistentes) — este valor nunca se usa de verdad, solo
# necesita existir para que env.js no truene al arrancar.
LABS_RESULT_FILE_STORAGE=/tmp/omegavet-test-storage/laboratorio

ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=Test
ADMIN_EMAIL=admin@omegavet.test
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TestAdmin123!
