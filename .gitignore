.claude/settings.local.json

# Backend
node_modules/
.env*
!.env.example
!.env.test
logs/
*.log
pnpm-debug.log*
coverage/
*.pid

# Archivos de resultados de laboratorio: nunca viven en el repo (Decisión 8
# de la bitácora técnica; datos clínicos de pacientes). Fuera de public/ a
# propósito (no en public/uploads/, el placeholder original de esta regla):
# express.static sirve TODO public/ sin autenticación, y estos son
# resultados médicos — se sirven por una ruta propia autenticada en vez de
# depender de que nadie adivine la URL.
storage/

# Aviso de privacidad (LFPDPPP) subido desde Configuración General: se sirve
# público a propósito vía express.static (WhatsApp/tutores lo consultan sin
# login), pero el archivo en sí es contenido cargado por el admin, no código.
public/legal/*
!public/legal/.gitkeep

# Sistema operativo
.DS_Store

